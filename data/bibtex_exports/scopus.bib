@CONFERENCE{Kim2024672,
	author = {Kim, Hajung and Kim, Chanhwi and Lee, Hoonick and Jang, Kyochul and Lee, Jiwoo and Lee, Kyungjae and Kim, Gangwoo and Kang, Jaewoo},
	title = {KU-DMIS at EHRSQL 2024: Generating SQL query via question templatization in EHR},
	year = {2024},
	journal = {ClinicalNLP 2024 - 6th Workshop on Clinical Natural Language Processing, Proceedings of the Workshop},
