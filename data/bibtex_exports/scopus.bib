@CONFERENCE{Katikeri2025249,
	author = {Katikeri, Raghu and Mamgain, Gaurav and Desai, Rajvi and Nakrani, Himanshu and Kasula, Tarun and Vaid, Amit},
	title = {GoT4SQL-DA: A Graph-of-Thoughts Framework for Scalable Text-to-SQL Data Augmentation},
	year = {2025},
	journal = {2025 3rd International Conference on Foundation and Large Language Models, FLLM 2025},
	pages = {249 - 253},
	doi = {10.1109/FLLM67465.2025.11391068},
	url = {https://www.scopus.com/pages/publications/105035868613?origin=resultslist},
	affiliations = {Artificial Intelligence Group State Street Corporation, Hyderabad, India; Artificial Intelligence Group State Street Corporation, Bengaluru, India},
	abstract = {This paper presents GoT4SQL-DA, a novel data augmentation and reasoning framework aimed at improving Text-to-SQL (T2SQL) performance in enterprise environments. GoT4SQL-DA addresses two key challenges: handling complex SQL queries and ensuring precise SQL generation. The framework introduces a Graph of Thoughts (GoT) approach, which decomposes Natural Language Queries (NLQs) and their corresponding SQL statements into logical sub-questions and sub-queries, linking them within a dynamic graph structure. Graph of Thoughts (GoT) enables fine-grained reasoning of the query logic and facilitates the generation of additional synthetic training examples through systematic recombination of sub NLQ and SQL from aggregated candidates from the graphs.We assessed GoT4SQL-DA on the Spider 1.0 and 2.0 datasets using the T2I-Rise SQL evaluation methods, where we measured both the comparison and component scores. Experimental results demonstrate substantial improvements over baseline T2SQL models, particularly in handling complex unseen schemas and SQLs. Ablation studies further highlight the critical contribution of GoT-based inputs to both accuracy and generalizability. Overall, our findings indicate that integrating graph-based decomposition with synthetic data augmentation can significantly enhance T2SQL systems, offering a promising path toward scalable, adaptable and explainable solutions for real-world database applications. © 2025 IEEE.},
	author_keywords = {Data Augmentation; GPT 4.1; GPT4o; Graph of Thoughts; LLM; Text2SQL},
	keywords = {Graph structures; Graphic methods; Query languages; Structured Query Language; Data augmentation; Data reasoning; GPT 4.1; GPT4o; Graph of thought; LLM; Natural language queries; Performance; Reasoning framework; Text2sql; Query processing},
	correspondence_address = {R. Katikeri; Artificial Intelligence Group State Street Corporation, Hyderabad, India; email: rkatikeri@statestreet.com},
