	url = {https://www.scopus.com/pages/publications/105035527867?origin=resultslist},
	affiliations = {Rajalakshmi Engineering College, Department of AIML, Chennai, India; Saveetha School of Engineering, SIMATS, Department of CSE, Chennai, India},
	abstract = {The deployment of text-to-SQL systems in sensitive and resource-constrained environments remains challenging due to the reliance on cloud-based large language models with substantial computational requirements. The research work proposes LDIR (Local Database Information Retriever), a lightweight, offline-solvable text-to-SQL model aimed at creating structured database queries from natural language directions. As opposed to standard large language models with cloud accessibility and high-end requirements, LDIR runs purely on low-end local hardware on the basis of a distilled T5small model. Major innovations are a confidence-based query selection mechanism, low-rank adaptation (LoRA) and prefixtuning integration for light model updates, and complete offline usability. Tested on the Clinton SQL dataset, LDIR attains nearteacher performance with ROUGE-1 of 0.91, BLEU of 0.71, METEOR of 0.88 and Exact Match of 0.44, while reducing computational needs by more than 50 %. These findings show LDIR's promise for safe, effective deployment in privacysensitive and edge computing applications.  © 2025 IEEE.},
