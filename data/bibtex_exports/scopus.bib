@CONFERENCE{Yang20261091,
	author = {Yang, Haolan and Li, Zhengbo and Yin, Ruolin and Ding, Shurui and Wang, Xianrui and Liu, Youbo},
	title = {Agent-Driven Topology Assembly: Trustworthy LLM Dispatch Reasoning in Distribution Networks},
	year = {2026},
	journal = {Proceedings - 2026 11th Asia Conference on Power and Electrical Engineering, ACPEE 2026},
	pages = {1091 - 1096},
	doi = {10.1109/ACPEE69242.2026.11525045},
	url = {https://www.scopus.com/pages/publications/105041644335?origin=resultslist},
	affiliations = {Sichuan University, College of Electrical Engineering, Chengdu, China},
	abstract = {Trustworthy integration of Large Language Models (LLMs) into distribution network operations is hindered by a critical structural mismatch: while safe grid operation requires explicit topology awareness, industry-standard Common Information Model (CIM) databases encode physical connectivity implicitly across fragmented relational tables. Consequently, conventional semantic retrieval fails to capture continuous physical connectivity, while unconstrained natural-language-to-SQL generation frequently yields erroneous queries due to the intricate, fragmented CIM schema. To resolve this, this paper proposes the Agent-driven Topology Assembly (ATA) framework, a tool-augmented dual-agent architecture for verifiable dispatch decision support. By decoupling cognitive exploration from deterministic data retrieval, ATA encapsulates the LLM within a secure sequential decision-making loop. Specifically, a Planner agent orchestrates deterministic topological operators to dynamically assemble a task-relevant electrical subgraph. A strictly decoupled Reasoner agent then synthesizes this assembled state into actionable, evidence-backed dispatch recommendations. Validated on a realistic CIM-compliant dataset, ATA demonstrates overwhelming superiority over traditional baselines in multi-hop topological tracing and reasoning under data uncertainty, establishing a rigorously safe paradigm for deploying AI in safety-critical grid infrastructures. © 2026 IEEE.},
	author_keywords = {agentic architecture; large language models; RAG; topology assembly; trustworthy reasoning},
	keywords = {Artificial intelligence; Decision making; Network architecture; Network security; Network topology; Query languages; Semantics; Agentic architecture; Distribution network operation; Grid operation; Information Modeling; Language model; Large language model; RAG; Topology assembly; Topology-awareness; Trustworthy reasoning; Decision support systems},
