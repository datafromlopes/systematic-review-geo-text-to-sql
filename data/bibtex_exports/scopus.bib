@CONFERENCE{Singh2026,
	author = {Singh, Suyash Vikram and Rathore, Santosh Singh and Tiwari, Saurabh},
	title = {QUERYGEN: A Tool for SQL Query Generation from Natural Language using Prompt Engineering},
	year = {2026},
	journal = {Proceedings of the 19th Innovations in Software Engineering Conference, ISEC 2026},
	pages = {},
	doi = {10.1145/3796563.3796577},
	url = {https://www.scopus.com/pages/publications/105038911441?origin=resultslist},
	affiliations = {Department of Information Technology, ABV-IIITM Gwalior, India, MADHYA PRADESH, GWALIOR, India; Department of Computer Science and Engineering, ABV-IIITM Gwalior, India, Madhya Pradesh, Gwalior, India; Dhirubhai Ambani University, DA-IICT Gandhinagar, India, Gujrat, Gandhinagar, India},
	abstract = {SQL is the prime language used by data scientists, operations managers, and engineers for querying, extracting, filtering, and restructuring databases. However, writing SQL queries requires moderate database knowledge and expertise. It is about understanding the data models that represent the business logic embedded in the numbers. Recently, the advent of large language models (LLMs) that can interpret natural language and generate accurate results has created a opportunity to transform English questions into executable SQL. In this paper, we introduce QUERYGEN system, designed to translate natural language queries into SQL queries using prompt engineering and fine-tuned LLMs. By harnessing the zero-shot capabilities of OpenAI’s GPT-4o-mini and fine-tuning, QUERYGEN enables users to transform their questions into executable SQL, making databases more accessible to non-technical users. It includes 1) mapping user intent to database schema elements, 2) rewriting questions to clear up confusion, and 3) refining queries based on execution feedback to ensure they are correct. Evaluated on the Spider benchmark, the tool achieves an overall execution accuracy of 75.2%, showing good performance across a range of query complexities. The current implementation of the tool utilizes a cost-effective LLM model to ensure economic viability for widespread adoption. However, the tool provides flexibility for users to integrate their preferred LLM API for improved performance. The source code and tool are available at: https://github.com/suyashvsingh/QUERYGEN. The demonstration of our tool can be found at https://www.youtube.com/watch?v=t5fVDfPupUg © 2026 Copyright held by the owner/author(s).},
	author_keywords = {Large Language Models; Natural language processing; Prompt engineering; SQL Generation; Text-to-SQL},
	keywords = {Benchmarking; Information management; Natural language processing systems; Query languages; Query processing; Refining; Structured Query Language; Executables; Language model; Language processing; Large language model; Natural language processing; Natural languages; Prompt engineering; SQL generation; SQL query; Text-to-SQL; Cost effectiveness},
