@CONFERENCE{Chen20215567,
	author = {Chen, Zhi and Chen, Lu and Zhao, Yanbin and Cao, Ruisheng and Xu, Zihan and Zhu, Su and Yu, Kai},
	title = {ShadowGNN: Graph Projection Neural Network for Text-to-SQL Parser},
	year = {2021},
	journal = {NAACL-HLT 2021 - 2021 Conference of the North American Chapter of the Association for Computational Linguistics: Human Language Technologies, Proceedings of the Conference},
	pages = {5567 - 5577},
	doi = {10.18653/v1/2021.naacl-main.441},
	url = {https://www.scopus.com/pages/publications/85108282241?origin=resultslist},
	affiliations = {X-LANCE Lab., Department of Computer Science and Engineering, MoE Key Lab of Artificial Intelligence, AI Institute, Shanghai Jiao Tong University, Shanghai, China; State Key Lab of Media Convergence Production Technology and Systems, Beijing, China; AISpeech Co., Ltd., Suzhou, China},
	abstract = {Given a database schema, Text-to-SQL aims to translate a natural language question into the corresponding SQL query. Under the setup of cross-domain, traditional semantic parsing models struggle to adapt to unseen database schemas. To improve the model generalization capability for rare and unseen schemas, we propose a new architecture, ShadowGNN, which processes schemas at abstract and semantic levels. By ignoring names of semantic items in databases, abstract schemas are exploited in a well-designed graph projection neural network to obtain delexicalized representation of question and schema. Based on the domain-independent representations, a relation-aware transformer is utilized to further extract logical linking between question and schema. Finally, a SQL decoder with context-free grammar is applied. On the challenging Text-to-SQL benchmark Spider, empirical results show that ShadowGNN outperforms state-of-the-art models. When the annotated data is extremely limited (only 10% training set), ShadowGNN gets over absolute 5% performance gain, which shows its powerful generalization ability. Our implementation will be open-sourced at https://github.com/WowCZ/shadowgnn. © 2021 Association for Computational Linguistics.},
	keywords = {Abstracting; Context free grammars; Database systems; Natural language processing systems; Query processing; Syntactics; Abstract levels; Cross-domain; Database schemas; Generalization capability; Model generalization; Natural language questions; Projection neural network; Semantic parsing; SQL parser; SQL query; Semantics},
	correspondence_address = {L. Chen; X-LANCE Lab., Department of Computer Science and Engineering, MoE Key Lab of Artificial Intelligence, AI Institute, Shanghai Jiao Tong University, Shanghai, China; email: chenlusz@sjtu.edu.cn; K. Yu; X-LANCE Lab., Department of Computer Science and Engineering, MoE Key Lab of Artificial Intelligence, AI Institute, Shanghai Jiao Tong University, Shanghai, China; email: kai.yu@sjtu.edu.cn},
