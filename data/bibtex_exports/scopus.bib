}

@CONFERENCE{Patwardhan20251676,
	author = {Patwardhan, Manasi and Agarwal, Ayush and Bhaisaheb, Shabbirhussain and Arora, Aseem and Vig, Lovekesh and Sarawagi, Sunita},
	title = {Retrieval and Augmentation of Domain Knowledge for Text-to-SQL Semantic Parsing},
	year = {2025},
	journal = {IEEE International Conference on Data Mining Workshops, ICDMW},
	pages = {1676 - 1685},
	doi = {10.1109/ICDMW69685.2025.00201},
