@CONFERENCE{Ullah2026230,
	author = {Ullah, Muhammad Aziz and Serwadda, Abdul},
	title = {Vibe Coding on Trial: Operating Characteristics of Unanimous LLM Juries},
	year = {2026},
	journal = {Proceedings - IEEE International Conference on Semantic Computing, ICSC},
	pages = {230 - 237},
	doi = {10.1109/ICSC67292.2026.00039},
	url = {https://www.scopus.com/pages/publications/105037844915?origin=resultslist},
	affiliations = {Texas Tech University, Lubbock, TX, United States},
	abstract = {Large Language Models (LLMs) are now good enough at coding that developers can describe intent in plain language and let the tool produce the first code draft, a workflow increasingly built into tools like GitHub Copilot, Cursor, and Replit. What is missing is a reliable way to tell which model written queries are safe to accept without sending everything to a human. We study the application of an LLM jury to run this review step. We first benchmark 15 open models on 82 MySQL text to SQL tasks using an execution grounded protocol to get a clean baseline of which models are strong. From the six best models we build unanimous committees of sizes 1 through 6 that see the prompt, schema, and candidate SQL and accept it only when every member says it is correct. This rule matches safety first deployments where false accepts are more costly than false rejects. We measure true positive rate, false positive rate and Youden J and we also look at committees per generator. Our results show that single model judges are uneven, that small unanimous committees of strong models can cut false accepts while still passing many good queries, and that the exact committee composition matters significantly. © 2026 IEEE.},
	author_keywords = {Large Language Models; LLM-as-Judge; Natural Language to SQL; Ollama; Vibe Coding},
	keywords = {Computational linguistics; Natural language processing systems; First code; Language model; Large language model; Large language model-as-judge; Natural language to SQL; Natural languages; Ollama; Operating characteristics; Vibe coding; Codes (symbols)},
