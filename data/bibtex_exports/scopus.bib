@ARTICLE{Bui2026,
	author = {Bui, Chien Dinh and Nguyen, Ha Hoang and Ngo, Tao Quoc and Vu-Thi, Huyen Khanh and Nguyen, Chien Hong and Nguyen, Duc Van and Ngo, Son Tung},
	title = {A systematic survey of LLM-based text-to-SQL: methodologies, security vulnerabilities, and future challenges},
