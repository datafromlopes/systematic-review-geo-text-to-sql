@CONFERENCE{Wang2025137,
	author = {Wang, Qikang and Wu, Tao and Lin, Songcong},
	title = {SCE-SQL: Self-Correction Enhancement in Text-to-SQL Tasks},
	year = {2025},
	journal = {2025 IEEE 3rd International Conference on Electrical, Automation and Computer Engineering, ICEACE 2025},
	pages = {137 - 141},
	doi = {10.1109/ICEACE67491.2025.11439575},
	url = {https://www.scopus.com/pages/publications/105036695346?origin=resultslist},
	affiliations = {School of Computer Science, Xi'an Polytechnic University, Shaanxi, Xi'an, China; Fujian Deao Knitting Co., Ltd., Fujian, Quanzhou, China},
	abstract = {The rise of large language models has been transformative for Text-to-SQL, yielding notable achievements. To further elevate model performance in this domain, this paper proposes a self-correction enhancement strategy for deep refinement of the SQL statements generated by the model. Self-correction is a common method in Text-to-SQL, where the generated SQL is executed, and based on the feedback from the execution results, the model iteratively refines generated SQL by incorporating contextual information. However, the performance of LLMs can be degraded due to incomplete information from execution feedback during correction, the model's insufficient reasoning capability leading to inaccuracies, or the generation of identical SQL statements across multiple correction rounds. To address these issues, this paper first establishes an error taxonomy to categorize common error types in generated SQL. Through similarity matching, it provides correction examples for erroneous SQL statements. Secondly, it introduces historical correction records to prevent the generation of identical SQL during the correction process. SCE-SQL primarily consists of three modules: (1) Schema Linking, (2) Candidate SQL Generation, (3) Self-correction Enhancement. Experimental results on the BIRD and Spider benchmarks demonstrate that this approach achieves an execution accuracy of 65.65 % on BIRD and 87.6 % on Spider. Ablation studies further empirically establish the critical role played by every constituent of our proposed approach. © 2025 IEEE.},
	author_keywords = {error taxonomy; LLM; self-correction; Text-to-SQL},
	keywords = {Errors; Feedback; Contextual information; Error taxonomy; Incomplete information; Language model; LLM; Modeling performance; Self-correction; SQL statements; Text-to-SQL; Iterative methods},
