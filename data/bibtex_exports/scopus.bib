	year = {2025},
	journal = {Proceedings - 2025 IEEE International Symposium on Parallel and Distributed Processing with Applications, ISPA 2025},
	pages = {1312 - 1319},
	doi = {10.1109/ISPA67752.2025.00181},
	url = {https://www.scopus.com/pages/publications/105030168854?origin=resultslist},
	affiliations = {School of Computer Science and Engineering, Northeastern University, Shenyang, China; Northeastern University, Software College, Shenyang, China},
	abstract = {The in-context learning capability of Large Language Models has achieved significant success in text-to-SQL task. Most existed approaches generally adopt a straightforward three-stage workflow including 1) schema linking, 2) SQL generation, and 3) self-correction. However, processing subtasks through a single chain-of-thought prompt limits the reasoning capability of LLMs, while multiple candidate SQLs sacrifice token numbers and runtime cost. To balance execution accuracy and cost for fulfilling text-to-SQL task, a multi-agent collaborative framework EBA-SQL is proposed. We firstly propose a novel entity-based analysis strategy to improve LLMs' understanding and attention of question. Then EBA-SQL adopts a EBA-Driven Decomposer agent acting in the entity-based analysis strategy, which is the core component for question decomposition and SQL generation. Two auxiliary agents, the EBA-Driven Selector and the Error-Driven Refiner, are responsible for schema linking and self-correction, respectively. Experimental results demonstrate the effectiveness and efficiency of EBA-SQL. Specifically, as of June 2025, experiments on the BIRD dataset show that EBA-SQL achieves the best performance with an execution accuracy of 6 3. 5 0 \% on the test set among the open-source GPT-4 based text-to-SQL methods. Extensive analysis and ablation studies confirm that EBA-SQL outperforms the baselines with respect to token and time efficiency, thus to demonstrate the strong potential for practical applications. Our code is available on GitHub: https://github.com/xiaolinstudent/EBA-SQL.  © 2025 IEEE.},
	author_keywords = {In-context learning; Large Language Models; Text-to-SQL},
	keywords = {Computational linguistics; Computational methods; Distributed computer systems; Information management; Intelligent agents; Learning systems; Multi agent systems; Open source software; Open systems; Analysis strategies; Collaborative framework; Context learning; In contexts; In-context learning; Language model; Large language model; Multi agent; Self-correction; Text-to-SQL; Efficiency},
	correspondence_address = {N. Guo; School of Computer Science and Engineering, Northeastern University, Shenyang, China; email: guonan@mail.neu.edu.cn},
