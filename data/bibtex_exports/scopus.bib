@ARTICLE{Bhat2026305,
	author = {Bhat, Namita and Kolhar, Vaishak and Hosakoti, Abhay and Das, Shreya and Kulkarni, Uday and Hegde, Shanshank},
	title = {Leveraging Transformer Models for Generating PL/SQL Queries},
	year = {2026},
	journal = {Lecture Notes in Networks and Systems},
	volume = {1374 LNNS},
