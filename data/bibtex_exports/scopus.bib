@ARTICLE{Cao2025,
	author = {Cao, Fukang},
	title = {Refining Knowledge Generation for Text-to-SQL via Chain-of-Thought Feedback},
	year = {2025},
	journal = {IEEE Access},
	pages = {},
	doi = {10.1109/ACCESS.2025.3634400},
	url = {https://www.scopus.com/pages/publications/105022633269?origin=resultslist},
	affiliations = {Jiangsu Normal University, College of Electrical Engineering & Automation, Jiangsu, Xuzhou, 221116, China},
	abstract = {Generating accurate SQL queries from natural language questions remains a significant challenge, requiring models to bridge the gap between user intent and structured database schemas. While large language models (LLMs) excel at text understanding, they frequently struggle when queries necessitate implicit knowledge - such as domain-specific calculations, value formatting, or subtle entity relationships - that is absent from the explicit question or schema definition. This deficiency often leads to the generation of functionally incorrect or syntactically invalid SQL, compromising the reliability of Text-to-SQL systems. One promising direction involves employing a specialized expert language model to generate this missing knowledge externally. However, effectively training such a knowledge generator requires robust feedback signals that accurately reflect the downstream utility of the generated knowledge. Existing feedback mechanisms, often based on simple execution success or alignment with ground-truth SQL, may lack the necessary granularity. To overcome this, we propose Chain-of-Thought Knowledge Feedback (CoT-KF), a novel preference learning strategy. CoT-KF leverages an auxiliary Text-to-SQL model guided by Chain-of-Thought prompting to translate the generated knowledge into SQL queries. Crucially, preference data for optimizing the expert knowledge model via Direct Preference Optimization (DPO) is derived by analyzing fine-grained execution outcomes, including specific database error types arising from the CoT-generated SQL, rather than just binary success/failure. Extensive experiments on the BIRD and Spider benchmarks show that refining the expert knowledge model using CoT-KF yields substantial improvements in the accuracy and efficiency of SQL generation for various downstream Text-to-SQL models. © 2013 IEEE.},
	author_keywords = {ai; Alignment; Curriculum Learning; Large Language Models},
	keywords = {Alignment; Curricula; Knowledge management; Learning systems; Natural language processing systems; Query languages; Query processing; Ai; Curriculum learning; Down-stream; Expert knowledge; Knowledge generations; Knowledge model; Language model; Large language model; SQL query; Via chain; Artificial intelligence},
