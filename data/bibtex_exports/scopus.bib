	keywords = {Electric industry; Learning algorithms; Machine learning; Natural language processing systems; Query languages; Search engines; Semantics; Data querying; Language model; Language processing; Large language model; Natural languages; Power; Power system data querying; Reinforcement learnings; Schema pruning; Text-to-SQL; Efficiency},
