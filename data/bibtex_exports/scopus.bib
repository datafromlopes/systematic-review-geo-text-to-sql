@CONFERENCE{Wang2025707,
	author = {Wang, Tianshu and Chen, Xiaoyang and Lin, Hongyu and Han, Xianpei and Sun, Le and Wang, Hao and Zeng, Zhenyu},
	title = {DBCopilot: Natural Language Querying over Massive Databases via Schema Routing},
	year = {2025},
	journal = {Advances in Database Technology - EDBT},
	volume = {28},
	number = {3},
	pages = {707 - 721},
	doi = {10.48786/edbt.2025.57},
	url = {https://www.scopus.com/pages/publications/105007947781?origin=resultslist},
	affiliations = {Institute of Software, CAS, Hangzhou Institute for Advanced Study, UCAS, China; University of Chinese Academy of Sciences (UCAS), Beijing, China; Institute of Software, CAS, Beijing, China; Alibaba Cloud Intelligence Group, Beijing, China; Alibaba Cloud Intelligence Group, Hangzhou, China},
	abstract = {The development of Natural Language Interfaces to Databases (NLIDBs) has been greatly advanced by the advent of large language models (LLMs), which provide an intuitive way to translate natural language (NL) questions into Structured Query Language (SQL) queries. While significant progress has been made in LLMbased NL2SQL, existing approaches face several challenges in real-world scenarios of natural language querying over massive databases. In this paper, we present DBCopilot, a framework that addresses these challenges by employing a compact and flexible copilot model for routing over massive databases. Specifically, DBCopilot decouples schema-agnostic NL2SQL into schema routing and SQL generation. This framework utilizes a single lightweight differentiable search index to construct semantic mappings for massive database schemata, and navigates natural language questions to their target databases and tables in a relation-aware joint retrieval manner. The routed schemata and questions are then fed into LLMs for effective SQL generation. Furthermore, DBCopilot introduces a reverse schema-toquestion generation paradigm that can automatically learn and adapt the router over massive databases without manual intervention. Experimental results verify that DBCopilot is a scalable and effective solution for schema-agnostic NL2SQL, providing a significant advance in handling natural language querying over massive databases for NLIDBs. © 2025 OpenProceedings.org. All rights reserved.},
	keywords = {Computational linguistics; Natural language processing systems; Query languages; Query processing; Structured Query Language; Language generation; Language model; Natural language interface to database; Natural language questions; Natural languages; Real-world scenario; Routings; Search/index; Semantics mappings; Structured Query Language; Semantics},
	correspondence_address = {H. Lin; Institute of Software, CAS, Beijing, China; email: hongyu@iscas.ac.cn},
	publisher = {OpenProceedings.org},
	issn = {23672005},
	isbn = {978-389318098-1; 978-389318099-8},
	language = {English},
	abbrev_source_title = {Adv.  Database Technol. - EDBT},
	type = {Conference paper},
