@CONFERENCE{Wang20254442,
	author = {Wang, Teng and He, Zhenqi and Yu, Wing-Yin and Fu, Xiaojin and Han, Xiongwei},
	title = {Large Language Models are Good Multi-lingual Learners: When LLMs Meet Cross-lingual Prompts},
	year = {2025},
	journal = {Proceedings - International Conference on Computational Linguistics, COLING},
	pages = {4442 - 4456},
	url = {https://www.scopus.com/pages/publications/85218497979?origin=resultslist},
	affiliations = {Department of Mathematics, The University of Hong Kong, Hong Kong; Noah's Ark Lab, Huawei,Hong Kong SAR, Hong Kong; Noah's Ark Lab, Huawei, Shenzhen, China},
	abstract = {With the advent of Large Language Models (LLMs), generating rule-based data for real-world applications has become more accessible. Due to the inherent ambiguity of natural language and the complexity of rule sets, especially in long contexts, LLMs often struggle to follow all specified rules, frequently omitting at least one. To enhance the reasoning and understanding of LLMs on long and complex contexts, we propose a novel prompting strategy Multi-Lingual Prompt, namely MLPrompt, which automatically translates the error-prone rule that an LLM struggles to follow into another language, thus drawing greater attention to it. Experimental results on public datasets across various tasks have shown MLPrompt can outperform state-of-the-art prompting methods such as Chain of Thought, Tree of Thought, and Self-Consistency. Additionally, we introduce a framework integrating MLPrompt with an auto-checking mechanism for structured data generation, with a specific case study in text-to-MIP instances. Further, we extend the proposed framework for text-to-SQL to demonstrate its generation ability towards structured data synthesis. © 2025 Association for Computational Linguistics.},
	keywords = {Adversarial machine learning; Computer aided language translation; Contrastive Learning; Modeling languages; Natural language processing systems; Structured Query Language; Cross-lingual; Error prones; Language model; Natural languages; Public dataset; Real-world; Rule based; Rule set; State of the art; Structured data; Computational linguistics},
	correspondence_address = {W.-Y. Yu; Noah's Ark Lab, Huawei,Hong Kong SAR, Hong Kong; email: rocket.YuWingYin@huawei.com},
	editor = {Rambow O. and Wanner L. and Apidianaki M. and Al-Khalifa H. and Di Eugenio B. and Schockaert S.},
