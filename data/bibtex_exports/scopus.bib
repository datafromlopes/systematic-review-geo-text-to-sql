@CONFERENCE{Zeng2023663,
	author = {Zeng, Lu and Parthasarathi, Sree Hari Krishnan and Hakkani-Tur, Dilek},
	title = {N-Best Hypotheses Reranking for Text-to-SQL Systems},
	year = {2023},
	journal = {2022 IEEE Spoken Language Technology Workshop, SLT 2022 - Proceedings},
	pages = {663 - 670},
	doi = {10.1109/SLT54892.2023.10023434},
	url = {https://www.scopus.com/pages/publications/85147794364?origin=resultslist},
	affiliations = {Alexa,Amazon, United States},
	abstract = {Text-to-SQL task maps natural language utterances to structured queries that can be issued to a database. State-of-the-art (SOTA) systems rely on finetuning large, pre-trained language models in conjunction with constrained decoding applying a SQL parser. On the well established Spider dataset, we begin with Oracle studies: specifically, choosing an Oracle hypothesis from a SOTA model's 10-best list, yields a 7.7% absolute improvement in both exact match (EM) and execution (EX) accuracy, showing significant potential improvements with reranking. Identifying coherence and correctness as reranking approaches, we design a model generating a query plan and propose a heuristic schema linking algorithm. Combining both approaches, with T5-Large, we obtain a consistent 1% improvement in EM accuracy, and a 2.5% improvement in EX, establishing a new SOTA for this task. Our comprehensive error studies on DEV data show the underlying difficulty in making progress on this task.  © 2023 IEEE.},
	author_keywords = {Semantic parsing; Text-To-SQL},
	keywords = {Computational linguistics; Natural language processing systems; Query languages; Query processing; Language model; N-best hypothesis; Natural languages; Re-ranking; Semantic parsing; State of the art; State-of-the-art system; Structured queries; Task maps; Text-to-SQL; Semantics},
