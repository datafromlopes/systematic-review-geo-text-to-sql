@ARTICLE{Jin202584,
	author = {Jin, Tengjun and Zhu, Yuxuan and Kang, Daniel},
	title = {ELT-Bench: An End-to-End Benchmark for Evaluating AI Agents on ELT Pipelines},
	year = {2025},
