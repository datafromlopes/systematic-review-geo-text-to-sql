@CONFERENCE{Wang2025111,
	author = {Wang, Xieyang and Xu, Jianqiu},
	title = {Towards Advanced Natural Language Interfaces for Moving Objects Databases},
	year = {2025},
	journal = {SSTD 2025 - Proceedings of the 19th International Symposium on Spatial and Temporal Data},
	pages = {111 - 114},
	doi = {10.1145/3748777.3748801},
	url = {https://www.scopus.com/pages/publications/105021956065?origin=resultslist},
	affiliations = {Nanjing University of Aeronautics and Astronautics, Nanjing, China},
	abstract = {In recent years, text-to-SQL has gained significant attention in both the natural language processing and database communities due to the ability to enable non-expert users to query databases using natural language. However, SQL lacks direct spatio-temporal operators, which is difficult to process moving objects queries and express such semantics, thus hindering the development of natural language query translation in the domain of moving objects databases (MODs). To address this issue, we explore the direct translation of text-to-executable-language (text-to-EXE). By utilizing executable languages that support a wide range of spatio-temporal operators and facilitate direct index selection, we propose a translation framework for text-to-EXE. Additionally, to tackle the foundational challenges of the text-to-EXE problem, we attempt to establish a benchmark testing platform tailored to real-world moving objects scenarios. This platform will provide automated corpus generation methods, evaluation frameworks, and metrics, advancing the text-to-EXE problem from feasibility to optimization. In the future, we aspire to leverage the kernel knowledge of MODs to further enhance the capabilities of large language models in addressing the text-to-EXE challenge. Specifically, we aim to achieve improved query optimization for executable languages while ensuring translation accuracy. This advancement will directly enhance the execution efficiency of predicted executable languages. © 2025 Copyright held by the owner/author(s)},
	author_keywords = {Benchmark; Moving objects Database; Natural Language Interface; Semantic Parsing; Structured Query Language},
	keywords = {Computational linguistics; EXAPT (programming language); Human computer interaction; Natural language processing systems; Object-oriented databases; Query languages; Query processing; Semantics; Structured Query Language; Text processing; Translation (languages); Benchmark; Executables; Moving objects; Moving Objects Databases; Natural language database; Natural language interfaces; Semantic parsing; Spatio-temporal; Structured Query Language; Temporal operators; Benchmarking},
	correspondence_address = {J. Xu; Nanjing University of Aeronautics and Astronautics, Nanjing, China; email: jianqiu@nuaa.edu.cn},
