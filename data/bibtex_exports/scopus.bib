@CONFERENCE{Shoba2026352,
	author = {Shoba, L.K. and Biradavolu, Geethika and Pandi, Himasree},
	title = {AI-Powered SQL Generation Using Natural Language Processing for Intelligent Database Interaction},
	year = {2026},
	journal = {Proceedings of the 2026 12th International Conference on Communication and Signal Processing, ICCSP 2026},
	pages = {352 - 357},
	doi = {10.1109/ICCSP68173.2026.11539707},
	url = {https://www.scopus.com/pages/publications/105042247867?origin=resultslist},
	affiliations = {Srm Institute of Science and Technology, Department of Computing Technologies, Kattankulathur, Chengalpattu, 603203, India},
	abstract = {Natural language interfaces for databases have gained significant attention as organizations seek to democratize data access for non-technical users while maintaining query correctness and security. Recent advances in large language models have enabled more accurate translation of natural language queries into structured query language, yet challenges remain in schema awareness, safety enforcement, and crossdatabase compatibility. This work presents an AI-powered, schema-aware natural language-to-SQL generation framework that enables intelligent and secure database interaction through a web-based interface. The system automatically discovers database schemas, including tables, attributes, and relational constraints, and incorporates this contextual knowledge into a prompt-engineered language model pipeline for accurate SQL synthesis. Multi-layer validation mechanisms enforce read-only query execution, prevent malicious operations, and ensure syntactic correctness using dialect-aware parsing. The generated queries are dynamically adapted to multiple database engines, enabling seamless interoperability across heterogeneous environments. Additionally, the framework supports file-driven table creation, real-time query execution, and interactive result visualization to enhance analytical usability. Experimental evaluation using diverse query categories demonstrates reliable SQL generation, robust safety compliance, and efficient execution performance. The proposed approach highlights the feasibility of integrating large language models with schema intelligence and execution safeguards to enable trustworthy natural language database interaction in real-world data-driven applications. © 2026 IEEE.},
	author_keywords = {database security; large language models; Natural language processing; schema-aware learning; SQL validation; Text-to-SQL generation},
	keywords = {Computational linguistics; Intelligent databases; Interoperability; Natural language processing systems; Network security; Query languages; Relational database systems; Safety engineering; Structured Query Language; Database interactions; Database security; Language model; Language processing; Large language model; Natural language processing; Natural languages; Schema-aware learning; SQL validation; Text-to-SQL generation; Query processing},
