@ARTICLE{Freitas2025278,
	author = {Freitas, Christian and Vega-Oliveros, Didier A. and Berton, Lilian},
	title = {Enhancing Industrial Data Access with Text-to-SQL using Portuguese LLMs and LangGraph},
	year = {2025},
	journal = {Proceedings of the International Conference on Soft Computing and Machine Intelligence, ISCMI},
	number = {2025},
	pages = {278 - 282},
	doi = {10.1109/ISCMI67495.2025.11358511},
	url = {https://www.scopus.com/pages/publications/105033230357?origin=resultslist},
	affiliations = {Universidade Federal de São Paulo (UNIFESP), Dept. of Science and Technology, SP, Brazil},
	abstract = {This work investigates the application of Text-to-SQL techniques to improve access to industrial maintenance data using Large Language Models (LLMs) in Portuguese. We design and implement a framework based on LangGraph to orchestrate interactions between natural language questions and SQL queries executed on a DuckDB engine. The system leverages Maritaca AI (sabia-3.1, sabia-3, sabiazim-3) and OpenAI (gpt-4o-mini) models to automatically generate valid SQL statements over a normalized dataset of service orders from a Brazilian industrial plant. Our evaluation covers different query types, including counting, filtering by time intervals, aggregation, and string search, highlighting both the strengths and limitations of LLM-based approaches in industrial scenarios. By adopting a Portuguese-native LLM alongside LangGraph's structured control of tool usage, we ensure that queries respect domain-specific constraints (e.g., mandatory use of the os view). Results show that the proposed framework effectively bridges natural language and structured industrial databases, enhancing data accessibility for non-technical users while demonstrating the potential of LLMs for supporting decision-making in industrial environments. © 2025 IEEE.},
	author_keywords = {DuckDB; Evaluation; Industrial Data; Lang-Graph; Maritaca AI; Portuguese LLMs; Text-to-SQL},
	keywords = {Artificial intelligence; Industrial plants; Information systems; Natural language processing systems; Query languages; Query processing; Structured Query Language; Data access; Duckdb; Evaluation; Industrial data; Industrial maintenance; Lang-graph; Language model; Maritaca AI; Portuguese large language model; Text-to-SQL; Decision making},
	correspondence_address = {C. Freitas; Universidade Federal de São Paulo (UNIFESP), Dept. of Science and Technology, SP, Brazil; email: christian.freitas@unifesp.br},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {26400154},
	language = {English},
	abbrev_source_title = {Proc. Int. Conf. Soft Comput. Mach. Intell., ISCMI},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Chen202664,
	author = {Chen, Zhuo and Wu, Kun and Li, Zhen and Hou, Yaxi and Yu, Wenhu and Liu, Zhongju and Li, Hangxuan and Liang, Zihang and Qin, Haoyu and Ren, Tonghui and He, Zhenying},
	title = {GRAY: Enhancing Few-Shot NL2SQL Translation Through Incremental SQL Log-Based Demonstration Expansion},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {16114 LNCS},
	pages = {64 - 79},
	doi = {10.1007/978-981-95-5716-5_5},
	url = {https://www.scopus.com/pages/publications/105031098039?origin=resultslist},
	affiliations = {China Mobile Information Technology Center, Beijing, China; School of Computer Science, Fudan University, Shanghai, China},
	abstract = {The Natural Language to SQL (NL2SQL) task enables non-technical users to access databases. Recently, advancements in Large Language Models (LLMs) have driven progress in NL2SQL. However, existing methods still face challenges when dealing with domain-specific data due to limited domain knowledge and database adaptability. Numerous methods leverage schema information and query data to enhance performance, yet they remain inadequate for effective domain adaptation. To address the challenge of limited domain-specific knowledge, this paper proposes GRAY, a method that employs SQL logs to provide domain-specific knowledge. SQL logs capture domain-specific knowledge by reflecting the unique structure and semantics of each database, but their limited quantity restricts this knowledge, making incremental expansion necessary. GRAY proposes a two-phase incremental expansion method, utilizing LLM-driven query generation to enrich the domain-specific knowledge in SQL logs, enabling the LLM to understand the semantics of the specific database. To provide more relevant domain knowledge in the limited context window of LLMs, GRAY designs a high-quality demonstration selection algorithm. Through experiments on multiple real-world databases, GRAY improves the performance of the NL2SQL tasks. The experimental results show that GRAY performs effectively on complex databases and has broad application potential. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2026.},
	author_keywords = {Large Language Model; Natural Language Interface to DataBases; Natural Language to SQL},
	keywords = {Computational linguistics; Domain Knowledge; Expansion; Knowledge management; Natural language processing systems; Query languages; Query processing; Structured Query Language; Translation (languages); Domain knowledge; Domain-specific knowledge; Language model; Large language model; Limited domains; Natural language interface to database; Natural language to SQL; Natural languages; Non-technical users; Performance; Semantics},
	correspondence_address = {Z. He; School of Computer Science, Fudan University, Shanghai, China; email: zhenying@fudan.edu.cn},
	editor = {Li J. and Chbeir R. and Li L. and Zong C. and Zhang Y. and Zhang M.},
