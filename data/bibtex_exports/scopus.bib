@CONFERENCE{Awasthi202211548,
	author = {Awasthi, Abhijeet and Sathe, Ashutosh and Sarawagi, Sunita},
	title = {Diverse Parallel Data Synthesis for Cross-Database Adaptation of Text-to-SQL Parsers},
	year = {2022},
	journal = {Proceedings of the 2022 Conference on Empirical Methods in Natural Language Processing, EMNLP 2022},
	pages = {11548 - 11562},
