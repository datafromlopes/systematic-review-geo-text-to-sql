@ARTICLE{Zhang20246699,
	author = {Zhang, Weixu and Wang, Yifei and Song, Yuanfeng and Wei, Victor Junqiu and Tian, Yuxing and Qi, Yiyan and Chan, Jonathan H. and Wong, Raymond Chi-Wing and Yang, Haiqin},
	title = {Natural Language Interfaces for Tabular Data Querying and Visualization: A Survey},
	year = {2024},
	journal = {IEEE Transactions on Knowledge and Data Engineering},
	volume = {36},
	number = {11},
	pages = {6699 - 6718},
	doi = {10.1109/TKDE.2024.3400824},
	url = {https://www.scopus.com/pages/publications/85193260891?origin=resultslist},
	affiliations = {Xi'an Jiaotong University, Shaanxi, Xi'an, 710049, China; International Digital Economy Academy (IDEA), Guangdong, Shenzhen, 518100, China; University of Toronto, Toronto, M5S 1A1, ON, Canada; IDEA, Guangdong, Shenzhen, 518100, China; WeBank Company Ltd., Guangdong, Shenzhen, 518052, China; Hong Kong University of Science and Technology (HKUST), Department of Computer Science and Engineering, Hong Kong; Xidian University, Shaanxi, Xi'an, 710126, China; King Mongkut's University of Technology Thonburi, Innovative Cognitive Computing (IC2) Research Center, School of Information Technology, Bangkok, 10140, Thailand},
	abstract = {The emergence of natural language processing has revolutionized the way users interact with tabular data, enabling a shift from traditional query languages and manual plotting to more intuitive, language-based interfaces. The rise of large language models (LLMs) such as ChatGPT and its successors has further advanced this field, opening new avenues for natural language processing techniques. This survey presents a comprehensive overview of natural language interfaces for tabular data querying and visualization, which allow users to interact with data using natural language queries. We introduce the fundamental concepts and techniques underlying these interfaces with a particular emphasis on semantic parsing, the key technology facilitating the translation from natural language to SQL queries or data visualization commands. We then delve into the recent advancements in Text-to-SQL and Text-to-Vis problems from the perspectives of datasets, methodologies, metrics, and system designs. This includes a deep dive into the influence of LLMs, highlighting their strengths, limitations, and potential for future improvements. Through this survey, we aim to provide a roadmap for researchers and practitioners interested in developing and applying natural language interfaces for data interaction in the era of large language models.  © 2024 IEEE.},
