@CONFERENCE{Saparina20241178,
	author = {Saparina, Irina and Lapata, Mirella},
	title = {Improving Generalization in Semantic Parsing by Increasing Natural Language Variation},
	year = {2024},
	journal = {EACL 2024 - 18th Conference of the European Chapter of the Association for Computational Linguistics, Proceedings of the Conference},
	volume = {1},
	pages = {1178 - 1193},
