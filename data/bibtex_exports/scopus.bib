	title = {Text-to-SQL Agent: An Iterative Question Rewriting Framework Based on Reinforcement Learning},
	year = {2026},
	journal = {ICAIAgent 2026 - 2026 International Conference on Artificial Intelligence and Agents},
	pages = {},
	doi = {10.1145/3811238.3811548},
	url = {https://www.scopus.com/pages/publications/105042494448?origin=resultslist},
	affiliations = {Hangzhou Dianzi University, School of Computer Science and Technology, Zhejiang, Hangzhou, China},
	abstract = {As a pivotal enabling technology for natural language interactive interfaces with relational databases, the Text-to-SQL task focuses on the automated translation of user natural language queries into standardized, database-executable SQL statements. While Large Language Model (LLM) and AI Agent have advanced this field, current approaches still largely follow a single-round generation paradigm, which struggles to incorporate execution feedback for continuous optimization. To address these challenges, this paper introduces T2S-Agent, an iterative problem rewriting framework based on reinforcement learning. Unlike traditional methods that directly optimize SQL generation, T2S-Agent innovatively incorporates reinforcement learning into the problem rewriting phase. This endows the system with core AI agent capabilities, enabling it to autonomously diagnose errors and iteratively refine query strategies based on execution results. Through dynamic interaction, the agent progressively approximates the user's true intent. To address the absence of standard SQL answers in real-world scenarios, this paper designs a composite reward mechanism independent of standard answers. It integrates rule-driven evaluation with large language model assessment, providing stable and distinguishable feedback signals to the agent across multiple dimensions including syntax, execution, semantics, and efficiency. Experimental results on the Spider benchmark demonstrate that T2S-Agent achieves an execution accuracy of 87.33% on the test set and an effective efficiency score of 88.77%, validating the effectiveness of the iterative optimization paradigm starting from the query source.  © 2026 Copyright held by the owner/author(s).},
	author_keywords = {Large Language Model; Problem Reformulation; Reinforcement Learning; Text-to-SQL Agent},
	keywords = {Artificial intelligence; Benchmarking; Computational linguistics; Feedback; Human computer interaction; Human engineering; Intelligent agents; Interactive computer systems; Iterative methods; Natural language processing systems; Optimization; Query languages; Query processing; Relational database systems; Search engines; Semantics; Automated translation; Enabling technologies; Interactive interfaces; Language model; Large language model; Natural languages; Problem reformulations; Reinforcement learnings; Relational Database; Text-to-SQL agent; Efficiency},
	correspondence_address = {S. Wang; Hangzhou Dianzi University, School of Computer Science and Technology, Hangzhou, Zhejiang, China; email: sixuan@hdu.edu.cn},
	publisher = {Association for Computing Machinery, Inc},
