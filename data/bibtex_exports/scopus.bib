@CONFERENCE{Li20258173,
	author = {Li, Raymond and Feng, Yuxi and Fan, Zhenan and Carenini, Giuseppe and Zhang, Weiwei and Pourreza, Mohammadreza and Zhang, Yong},
	title = {DeTriever: Decoder-representation-based Retriever for Improving NL2SQL In-Context Learning},
	year = {2025},
	journal = {Proceedings - International Conference on Computational Linguistics, COLING},
	pages = {8173 - 8183},
	url = {https://www.scopus.com/pages/publications/85218497617?origin=resultslist},
	affiliations = {The University of British Columbia, Vancouver, Canada; Huawei Technologies Canada Co., Ltd., Burnaby, Canada; University of Alberta, Edmonton, Canada},
	abstract = {While in-context Learning (ICL) has proven to be an effective technique to improve the performance of Large Language Models (LLMs) in a variety of complex tasks, notably in translating natural language questions into Structured Query Language (NL2SQL), the question of how to select the most beneficial demonstration examples remains an open research problem. While prior works often adapted off-the-shelf encoders to retrieve examples dynamically, an inherent discrepancy exists in the representational capacities between the external retrievers and the LLMs. Further, optimizing the selection of examples is a non-trivial task, since there are no straightforward methods to assess the relative benefits of examples without performing pairwise inference. To address these shortcomings, we propose DeTriever, a novel demonstration retrieval framework that learns a weighted combination of LLM hidden states, where rich semantic information is encoded. To train the model, we propose a proxy score that estimates the relative benefits of examples based on the similarities between output queries. Experiments on two popular NL2SQL benchmarks demonstrate that our method significantly outperforms the state-of-the-art baselines for the NL2SQL tasks. © 2025 Association for Computational Linguistics.},
	keywords = {Adversarial machine learning; Benchmarking; Computational linguistics; Contrastive Learning; Natural language processing systems; Query languages; Semantics; Translation (languages); Complex task; Context learning; In contexts; Language model; Natural language questions; Non-trivial tasks; Performance; Research problems; Straight-forward method; Structured Query Language; Structured Query Language},
	correspondence_address = {Z. Fan; Huawei Technologies Canada Co., Ltd., Burnaby, Canada; email: zhenan.fan1@huawei.com},
	editor = {Rambow O. and Wanner L. and Apidianaki M. and Al-Khalifa H. and Di Eugenio B. and Schockaert S.},
	publisher = {Association for Computational Linguistics (ACL)},
