@ARTICLE{Chan2026,
	author = {Chan, Sokheang and Kong, Vungsovanreach and Nayyar, Anand and Kim, Tae-Kyung},
	title = {QA-SQL: query-augmented SQL generation using few-shot prompting with data augmentation},
	year = {2026},
	journal = {PeerJ Computer Science},
	volume = {12},
	pages = {},
	doi = {10.7717/peerj-cs.3525},
	url = {https://www.scopus.com/pages/publications/105033763198?origin=resultslist},
	affiliations = {Big Data Department, Chungbuk National University, Chungcheongbuk-do, Cheongju-si, South Korea; School of Computer Science, Duy Tan University, Da Nang, Viet Nam; Department of Management Information Systems, Chungbuk National University, Chungcheongbuk-do, Cheongju-si, South Korea},
	abstract = {Natural Language to Structured Query Language (NL-to-SQL) models make it easier to retrieve data from structured databases by converting plain language queries into Structured Query Language (SQL) commands. However, current methods often struggle with complex database structures, unclear user questions, and generating efficient SQL queries. These issues make it hard to use them effectively in real-world, large-scale databases. To tackle these problems, a novel framework titled “Query-Augmented SQL Generation (QA-SQL)”, is introduced that combines retrieval augmented generation (RAG) with data augmentation with advanced techniques to enhance the accuracy and efficiency of natural language to SQL (NL-to-SQL) generation. The proposed approach uses Schema Linking, RAG, and Dynamic Prompt Engineering along with few-shot learning and vector database retrieval, to enhance SQL query generation through query augmentation. To test and validate the proposed model, extensive experimentations were conducted on the BIg Bench for LaRge-scale Database Grounded Text-to-SQL Evaluation (BIRD) benchmark, which includes 1,534 natural language queries across various relational databases and the results highlighted a execution accuracy of 46.68% and a valid efficiency score of 87.66%, outperforming existing methods. The proposed research introduces a context-aware retrieval system that significantly enhances SQL accuracy, paving the way for more scalable and reliable NL-to-SQL solutions. © 2026 Chan et al. Distributed under Creative Commons CC-BY 4.0. http://www.creativecommons.org/licenses/by/4.0/},
	author_keywords = {Data augmentation; Large language models; Retrieval-augmented generation; Text-to-SQL},
	keywords = {Benchmarking; Computational linguistics; Information retrieval; Information retrieval systems; Natural language processing systems; Query languages; Query processing; Relational database systems; Search engines; Structured Query Language; Data augmentation; Language generation; Language model; Large language model; Large-scale database; Natural languages; Query language model; Retrieval-augmented generation; Structured Query Language; Text-to-structured query language; Efficiency},
