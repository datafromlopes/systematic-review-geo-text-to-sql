@CONFERENCE{Shi20253604,
	author = {Shi, Jie and Cao, Xi and Xu, Bo and Liang, Jiaqing and Xiao, Yanghua and Chen, Jia and Wang, Peng and Wang, Wei},
	title = {Dialect-SQL: An Adaptive Framework for Bridging the Dialect Gap in Text-to-SQL},
	year = {2025},
	journal = {EMNLP 2025 - 2025 Conference on Empirical Methods in Natural Language Processing, Proceedings of the Conference},
	pages = {3604 - 3619},
	doi = {10.18653/v1/2025.emnlp-main.178},
	url = {https://www.scopus.com/pages/publications/105040208853?origin=resultslist},
	affiliations = {Shanghai Key Laboratory of Data Science, College of Computer Science and Artificial Intelligence, Fudan University, China; School of Data Science, Fudan University, China; School of Computer Science and Technology, Donghua University, China},
	abstract = {Text-to-SQL is the task of translating natural language questions into SQL queries based on relational databases. Different databases implement their own SQL dialects, leading to variations in syntax. As a result, SQL queries designed for one database may not execute properly in another, creating a dialect gap. Existing Text-to-SQL research primarily focuses on specific database systems, limiting adaptability to different dialects. This paper proposes a novel adaptive framework called Dialect-SQL, which employs Object Relational Mapping (ORM) code as an intermediate language to bridge this gap. Given a question, we guide Large Language Models (LLMs) to first generate ORM code, which is then parsed into SQL queries targeted for specific databases. However, there is a lack of high-quality Text-to-Code datasets that enable LLMs to effectively generate ORM code. To address this issue, we propose a bootstrapping approach to synthesize ORM code, where verified ORM code is iteratively integrated into a demonstration pool that serves as in-context examples for ORM code generation. Our experiments demonstrate that Dialect-SQL significantly enhances dialect adaptability, outperforming traditional methods that generate SQL queries directly. Our code and data are released at https://github.com/jieshi10/orm-sql. © 2025 Association for Computational Linguistics.},
	keywords = {Codes (symbols); Computational linguistics; Iterative methods; Natural language processing systems; Query processing; Relational database systems; Structured Query Language; Syntactics; Adaptive framework; Codegeneration; High quality; In contexts; Intermediate languages; Language model; Natural language questions; Object-relational mapping; Relational Database; SQL query; Query languages},
	correspondence_address = {B. Xu; School of Computer Science and Technology, Donghua University, China; email: xubo@dhu.edu.cn; W. Wang; Shanghai Key Laboratory of Data Science, College of Computer Science and Artificial Intelligence, Fudan University, China; email: weiwang1@fudan.edu.cn},
