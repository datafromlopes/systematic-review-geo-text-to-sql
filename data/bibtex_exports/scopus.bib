@ARTICLE{Jose20233015,
	author = {Jose, Marcelo Archanjo and Cozman, Fabio Gagliardi},
	title = {A multilingual translator to SQL with database schema pruning to improve self-attention},
	year = {2023},
	journal = {International Journal of Information Technology (Singapore)},
	volume = {15},
	number = {6},
	pages = {3015 - 3023},
	doi = {10.1007/s41870-023-01342-3},
	url = {https://www.scopus.com/pages/publications/85163200353?origin=resultslist},
	affiliations = {Institute for Advanced Studies, University of São Paulo, R. do Anfiteatro, 513, São Paulo, São Paulo, 05508-060, Brazil; Center for Artificial Intelligence, C4AI, Av. Prof. Lúcio Martins Rodrigues, 370, São Paulo, São Paulo, 05508-010, Brazil; Escola Politécnica, University of São Paulo, Av. Professor Luciano Gualberto 2231, São Paulo, São Paulo, 05508-010, Brazil},
	abstract = {Databases have a large amount of information that can be accessed by the structured query language (SQL), but this language requires technical knowledge. An alternative to facilitating access to this information is to use natural language to make queries, and an artificial intelligence model to translate to SQL. Transformer-based language models have been incredibly successful in this regard. However, transformers are limited by the size of the input text; therefore, long sentences can interfere with the quality of the results. We present two techniques to improve results. The first is an innovative technique that allows long-text sequences to be handled by transformers with up to 512 input tokens. We run database schema pruning (removal of table names and column names that are useless for the query of interest) during a fine-tuning process. The second technique is a multilingual approach. The model is fine-tuned using a data-augmented Spider dataset [a specialized dataset for Natural Language to SQL (NL2SQL)] in four languages simultaneously: English, Portuguese, Spanish, and French. The combination of these techniques allowed an increase in the exact set match accuracy results from 0.718 to 0.736 in our validation dataset. The process of improving results is challenging because NL2SQL techniques are already significantly optimized, and the two techniques presented here are important because they are applied in the training dataset, allowing them to be used with any current technique. Source code, evaluations, and checkpoints are available at https://github.com/C4AI/gap-text2sql . © 2023, The Author(s), under exclusive licence to Bharati Vidyapeeth's Institute of Computer Applications and Management.},
	author_keywords = {Databases; Deep learning; Natural language process; Neural network; Semantic parsing; Spider dataset; SQL generation; Text-to-SQL; Transformers; Transformers self-attention},
	correspondence_address = {M.A. Jose; Center for Artificial Intelligence, C4AI, São Paulo, Av. Prof. Lúcio Martins Rodrigues, 370, São Paulo, 05508-010, Brazil; email: marcelo_archanjo@yahoo.com.br},
