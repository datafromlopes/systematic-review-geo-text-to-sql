@CONFERENCE{Nutalapati2025624,
	author = {Nutalapati, Pavan and Keshava, Rakesh and Seshagiri, Nandagopal and Harve, Bindu Mohan and Kole, Deepak and Sahoo, Isan and Soni, Vinay},
	title = {AI-Powered Text-to-SQL Translation: Enabling Natural Language Interfaces for Databases},
	year = {2025},
	journal = {2025 5th International Conference on Intelligent Cybernetics Technology and Applications, ICICyTA 2025},
	pages = {624 - 629},
	doi = {10.1109/ICICYTA68677.2025.11362752},
	url = {https://www.scopus.com/pages/publications/105033688993?origin=resultslist},
	affiliations = {TX, United States; CA, United States; WA, United States},
	abstract = {The complexity of Structured Query Language (SQL) creates a barrier for non-technical users who need to access insights from relational databases. This paper presents an AI-powered framework for translating natural language queries into SQL, aiming to bridge the gap between user intent and structured data access. By leveraging advancements in Natural Language Processing (NLP), particularly transformer-based models like T5 and BART, we propose a hybrid neural-symbolic architecture that incorporates schema-aware embeddings, SQL grammar constraints, and contextual understanding of user queries. Our system is designed to generalize across domains and handle complex query structures, including nested and multi-table queries. We evaluate its performance using benchmark datasets such as Spider and demonstrate real-world utility through integration with a business intelligence chatbot for retail sales analytics. The model achieves high execution accuracy and semantic match rates, outperforming baseline models like Seq2SQL and SQLNet. We also present a detailed error analysis and discuss limitations in handling ambiguous or underspecified queries. This work contributes a practical solution for democratizing data access in enterprise environments and sets the stage for further enhancements such as multilingual support, interactive query clarification, and integration with visualization platforms. Our approach empowers users of all technical backgrounds to extract meaningful insights from data through natural language interaction. © 2025 IEEE.},
