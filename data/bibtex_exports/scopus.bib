@ARTICLE{Chen2025453,
	author = {Chen, Yanling and Huang, Zupei and Lu, Zijun and Dai, Yaoyao and Ke, Yidong and Zhou, Lin},
	title = {An Example-Enhanced and Iteratively Refined Text-to-SQL Framework with Dual-Path Revision},
	year = {2025},
	journal = {Proceedings of the IEEE International Conference on Computer and Communications, ICCC},
	pages = {453 - 457},
	doi = {10.1109/ICCC68654.2025.11438029},
	url = {https://www.scopus.com/pages/publications/105035767057?origin=resultslist},
	affiliations = {College of Information Science and Engineering, Huaqiao University, Xiamen, China; Wuzhuo Future Technology Co., Ltd, Xiamen, China},
	abstract = {Although significant progress has been made in Text-to-SQL technology, existing methods still face challenges: insufficient adaptability between examples and the specific database schema, and inadequate repair capabilities when SQL execution encounters exceptions. To address these challenges, this paper introduces the Example-Enhanced and Iteratively Refined SQL (EEIR-SQL) framework, featuring two key innovations: First, a dynamic example generator produces SQL examples covering varying levels of complexity for each query task. Second, a dual-path intelligent revision agent autonomously selects SQL correction strategies based on execution feedback (error reports or empty results). Experiments on the BIRD benchmark demonstrate that EEIR-SQL's 4-bit (INT4) quantized Qwen332B model achieves an 11.43 percentage points higher execution accuracy than the Qwen3-32B-Q4 baseline, outperforming several GPT-4-based approaches. This result not only validates EEIR-SQL's effectiveness in generating accurate and reliable SQL, but also demonstrates that, despite using a less resourceintensive quantized model, its performance surpasses that of computationally demanding GPT-4. This provides practical guidance for balancing low-resource deployment with high reliability requirements. © 2025 IEEE.},
