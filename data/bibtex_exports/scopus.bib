@ARTICLE{Lenzi20263,
	author = {Lenzi, Tomás P. and Nascimento, Eduardo R. S. and Silva, Matheus O. and García, Grettel M. and Izquierdo, Yenier T. and Facina, Michelle S. P. and Siqueira, Isabela G. and Lemos, Melissa and Casanova, Marco A.},
	title = {Benchmarking Natural Language Database Conversational Agents},
	year = {2026},
	journal = {Lecture Notes in Business Information Processing},
	volume = {586 LNBIP},
	pages = {3 - 11},
	doi = {10.1007/978-3-032-28160-9_1},
	url = {https://www.scopus.com/pages/publications/105041801424?origin=resultslist},
	affiliations = {Instituto Tecgraf, PUC-Rio, RJ, Rio de Janeiro, 22451-900, Brazil; Petrobras, RJ, Rio de Janeiro, 20231–030, Brazil; Departamento de Informática, PUC-Rio, RJ, Rio de Janeiro, 22451–900, Brazil},
	abstract = {This paper addresses the problem of testing a natural language database conversational agent for a given database D. The paper first introduces a procedure to create a dialogue test dataset T<sub>D</sub> for D, a collection of dialogue performance metrics, and an evaluation agent that simulates a user interacting with the database conversational agent over D, guided by T<sub>D</sub>. The procedure that creates the dialogue test datasets simulates a user navigating through the database schema. The paper then describes a set of experiments using four databases, including an industrial database that is in production. The experiments suggest that the dialogue test datasets and the evaluation agent help differentiate the performance of database conversational agents across the databases of interest before deployment. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
