	journal = {2026 9th International Conference on Advanced Electronic Technology, Computers and Software Engineering, AETCSE 2026},
	pages = {952 - 960},
	doi = {10.1109/AETCSE69203.2026.11504381},
	url = {https://www.scopus.com/pages/publications/105041633857?origin=resultslist},
	affiliations = {School of Information Science and Engineering, Xinjiang University, Urumqi, China},
	abstract = {Text-to-SQL systems face significant challenges when processing diverse and complex Chinese natural language queries. Existing large language model (LLM)-based methods suffer from limitations in computational resource allocation and query diversity handling. We propose Multi-Agent NL2SQL, a Chinese Text-to-SQL system built on an S-N-M adaptive framework. Our approach introduces two key innovations: (1) a dynamic weighted selection mechanism that uses category probability distributions from the S-N-M classifier to adjust weights of three specialized processing modules, enabling intelligent selection based on both category probabilities and SQL quality; (2) an error feedforward correction strategy that addresses Chinese semantic ambiguity through error type-based correction, significantly improving system robustness. On Chase and CSpider benchmarks, our system achieves Execution Accuracy (EA) of 53.1% and 63.1%, outperforming DIN-SQL by 7.3 and 11.0 percentage points respectively (p < 0.01). Processing speed improves by 39.3% and throughput by 63.2%, demonstrating a scalable and efficient solution for production deployment © 2026 IEEE.},
