	url = {https://www.scopus.com/pages/publications/105043444054?origin=resultslist},
	affiliations = {Guangdong Power Grid Co., Ltd., Guangzhou, China},
	abstract = {Recently, context-dependent text-to-SQL parsing has garnered significant attention, which plays a crucial role in translating natural language into SQL within an interactive process. Existing LLM-based methods leverage context information either from interaction history or from previously predicted SQL queries, but they struggle to utilize both effectively due to mismatches between natural language and database schemas. In this paper, we propose a context-dependent text-to-SQL framework with multi-turn schema linking method, called MTSL-SQL. Specifically, MTSL-SQL integrates historical conversations and current dialogue information for schema linking, and subsequently fine-tunes open-source large language models to use selected schema and dialogue information to generate SQL queries. Extensive experimental results demonstrate that our method achieves state-of-the-art (SOTA) performance among LLM-based approaches on the SParC and CoSQL datasets. © 2025 IEEE.},
