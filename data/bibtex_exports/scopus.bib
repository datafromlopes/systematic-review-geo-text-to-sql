	title = {LLMSQL: Upgrading WikiSQL for the LLM Era of Text-to-SQL},
	year = {2025},
	journal = {IEEE International Conference on Data Mining Workshops, ICDMW},
	pages = {539 - 548},
	doi = {10.1109/ICDMW69685.2025.00066},
