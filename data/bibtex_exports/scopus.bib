}

@ARTICLE{Tang2025149,
	author = {Tang, Zetong and Ma, Qian and Wu, Di},
	title = {Auto Prompt SQL: A Resource-Efficient Architecture for Text-To-SQL Translation in Constrained Environments},
	year = {2025},
	journal = {IET Conference Proceedings},
	volume = {2025},
