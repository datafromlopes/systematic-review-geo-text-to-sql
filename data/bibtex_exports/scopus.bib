@CONFERENCE{Xiao20254636,
	author = {Xiao, Quan and Bhattacharjya, Debarun and Ganesan, Balaji and Marinescu, Radu and Mirylenka, Katsiaryna and Pham, Nhan H. and Glass, Michael and Lee, Junkyu},
	title = {The Consistency Hypothesis in Uncertainty Quantification for Large Language Models},
	year = {2025},
	journal = {Proceedings of Machine Learning Research},
	volume = {286},
	pages = {4636 - 4646},
	url = {https://www.scopus.com/pages/publications/105014766455?origin=resultslist},
	affiliations = {Rensselaer Polytechnic Institute, United States; IBM Research, United States; Zalando, United Kingdom},
	abstract = {Estimating the confidence of large language model (LLM) outputs is essential for real-world applications requiring high user trust. Black-box uncertainty quantification (UQ) methods, relying solely on model API access, have gained popularity due to their practical benefits. In this paper, we examine the implicit assumption behind several UQ methods, which use generation consistency as a proxy for confidence—an idea we formalize as the consistency hypothesis. We introduce three mathematical statements with corresponding statistical tests to capture variations of this hypothesis and metrics to evaluate LLM output conformity across tasks. Our empirical investigation, spanning 8 benchmark datasets and 3 tasks (question answering, text summarization, and text-to-SQL), highlights the prevalence of the hypothesis under different settings. Among the statements, we highlight the ‘Sim-Any’ hypothesis as the most actionable, and demonstrate how it can be leveraged by proposing data-free black-box UQ methods that aggregate similarities between generations for confidence estimation. These approaches can outperform the closest baselines, showcasing the practical value of the empirically observed consistency hypothesis. © 2025, ML Research Press. All rights reserved.},
	keywords = {Question answering; Statistical tests; Text processing; Uncertainty analysis; Benchmark datasets; Black boxes; Empirical investigation; Language model; Mathematical statement; Model outputs; Quantification methods; Question Answering; Real-world; Uncertainty quantifications; Data consistency},
	correspondence_address = {Q. Xiao; Rensselaer Polytechnic Institute, United States; email: quanx1808@gmail.com; D. Bhattacharjya; IBM Research, United States; email: debarunb@us.ibm.com},
	editor = {Chiappa S. and Magliacane S.},
	publisher = {ML Research Press},
	issn = {26403498},
	language = {English},
	abbrev_source_title = {Proc. Mach. Learn. Res.},
	type = {Conference paper},
