@ARTICLE{Li2026193,
	author = {Li, Zhishuai and Wang, Xiang and Zhao, Jingjing and Yang, Sun and Du, Guoqing and Hu, Xiaoru and Zhang, Bin and Ye, Yuxiao and Li, Ziyue and Mao, Hangyu and Zhao, Rui},
	title = {PET-SQL: A Prompt-Enhanced Two-Round Refinement of Text-to-SQL with Cross-Consistency},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {15987 LNCS},
	pages = {193 - 208},
	doi = {10.1007/978-981-95-3830-0_13},
	url = {https://www.scopus.com/pages/publications/105028288696?origin=resultslist},
	affiliations = {China University of Petroleum, Shandong, China; SenseTime Research, Shanghai, China; Peking University, Beijing, China; Institute of Automation, Chinese Academy of Sciences, Beijing, China; University of Chinese Academy of Sciences, Beijing, China; Beijing Institute of Technology, Beijing, China; University of Cologne, Cologne, Germany},
	abstract = {Recent advancements in Text-to-SQL (Text2SQL) emphasize stimulating the large language models (LLM) on in-context learning, achieving significant results. Nevertheless, they face challenges when dealing with verbose database information and complex user intentions. This paper presents a two-round framework to enhance the performance of current LLM-based natural language to SQL systems. We first introduce a novel prompt representation, called reference-enhanced representation, which includes schema information and randomly sampled cell values from tables to instruct LLMs in generating SQL queries. Then, in the first round, question-SQL pairs are retrieved as few-shot demonstrations, prompting the LLM to generate a preliminary SQL (PreSQL). After that, the mentioned entities in PreSQL are parsed to conduct schema linking, which can significantly compact the useful information. In the second round, with the linked schema, we simplify the prompt’s schema information and instruct the LLM to produce the final SQL (FinSQL). Finally, as the post-refinement module, we propose using cross-consistency across different LLMs rather than self-consistency within a particular LLM. Our methods achieve new SOTA results on the Spider benchmark, with an execution accuracy of 87.6%. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2026.},
	author_keywords = {Cross consistency; Large language models; Post-refinement; Prompt; Text-to-SQL},
	keywords = {Information use; Query languages; Query processing; Context learning; Cross consistency; Database information; In contexts; Language model; Large language model; Post-refinement; Prompt; Schema information; Text-to-SQL; Natural language processing systems},
	correspondence_address = {H. Mao; SenseTime Research, Shanghai, China; email: hy.mao@pku.edu.cn; Z. Li; University of Cologne, Cologne, Germany; email: zlibn@wiso.uni-koeln.de},
	editor = {Zhu F. and Lim E.-P. and Yu P.S. and Nadamoto A. and Shim K. and Ding W. and Zhang B.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
