	affiliations = {University of Science and Technology of China, Hefei, China; New H3C Technologies Co., Ltd., Hangzhou, China},
	abstract = {Deploying Text-to-SQL in resource-constrained enterprise environments presents a dichotomy: proprietary Large Language Models (LLMs) pose privacy and cost concerns, while smaller open-source models often lack the reasoning depth for complex queries. To address this, we introduce GTR-SQL, a lightweight, training-free multi-agent framework designed to empower smaller models (e.g., 7B parameters) via orchestrated inference-time scaling. GTR-SQL targets specific failure modes through three components: (1) Graph-connected schema linking, which uses Steiner Tree approximation to guarantee topological connectivity for multi-hop joins; (2) Tournament-based selection, employing an execution-aware judge to filter subtle logical flaws; and (3) Repair-guided correction, utilizing a fine-grained error taxonomy to drive dual-path repairs rather than blind retries. Evaluations on the Spider and CSpider development sets (N=1034) demonstrate that GTR-SQL significantly augments the reasoning capabilities of lightweight models. Without fine-tuning, the framework delivers substantial gains in Execution Accuracy over direct prompting (+13.35% on Spider, +13.74% on CSpider) and maintains a Valid SQL rate exceeding 99%, proving its robustness for real-world applications.  © 2025 IEEE.},
	author_keywords = {Graph Steiner Tree; Inference-Time Scaling; Multi-Agent Systems; Self-Correction; Text-to-SQL},
	keywords = {Failure (mechanical); Forestry; Intelligent agents; Open source software; Open systems; Repair; Taxonomies; Trees (mathematics); Enterprise environment; Graph steiner tree; Inference-time scaling; Language model; Multiagent systems (MASs); Self-correction; Steiner trees; Text-to-SQL; Time-scaling; Tournament selection; Multi agent systems},
	correspondence_address = {J. Cheng; University of Science and Technology of China, Hefei, China; email: chengjinrui@mail.ustc.edu.cn},
