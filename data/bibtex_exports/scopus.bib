@CONFERENCE{Gouda20251,
	author = {Gouda, Aly H. and Eltannikhy, Zeina and Zaky, Ahmed B.},
	title = {AraGraphSQL: Modeling Schema Knowledge with Heterogeneous Graph Transformers for Arabic Text-to-SQL Translation},
	year = {2025},
	journal = {Proceedings of the 13th International Japan-Africa Conference on Electronics, Communications, and Computations, JAC-ECC 2025},
	pages = {1 - 6},
	doi = {10.1109/JAC-ECC67970.2025.11417541},
	url = {https://www.scopus.com/pages/publications/105036000031?origin=resultslist},
	affiliations = {Egypt-Japan University of Science and Technology (E-JUST), Faculty of Computer Science and Information Technology, New Borg El-Arab City, Alexandria, Egypt; Benha University, Faculty of Engineering (Shoubra), Department of Electrical Engineering, Qalubiya, Banha, 13511, Egypt},
	abstract = {Arabic's complex morphology and English-defined database schemas make Arabic Text-to-SQL particularly challenging, since question tokens and schema labels rarely align lexically. This paper introduces AraGraphSQL, a neural architecture for Arabic-to-SQL translation that combines constrained decoding, bilingual schema linking, and heterogeneous graph neural networks. We model each database as a typed heterogeneous graph over question tokens, tables, and columns, and encode it with a relation-aware graph encoder fused with a multilingual mT5-base encoder. A constrained decoder then generates SQL under schema and foreign-key constraints. On an Ar-Spider-style benchmark over 6,396 Arabic question-SQL pairs and 166 schemas, AraGraphSQL improves development-set schema linking to 41.7 Table-F1 and 19.1 Column-F1, outperforming GNN and TinyHGT baselines by up to +13.4 and +6.7 absolute F1. End-to-end, it achieves 12.6% exact match and 24.3% execution accuracy, with ablations confirming the contribution of bilingual linking, heterogeneous graph encoding, and constrained decoding. These results demonstrate that explicitly modeling cross-lingual schema structure provides a complementary inductive bias to existing Text-to-SQL systems for Arabic. © 2025 IEEE.},
	author_keywords = {Arabic Natural Language Processing; Constrained Decoding; Graph Neural Networks; Heterogeneous Graph Transformers; Semantic Parsing; Text-toSQL},
	correspondence_address = {A.B. Zaky; Egypt-Japan University of Science and Technology (E-JUST), Faculty of Computer Science and Information Technology, Alexandria, New Borg El-Arab City, Egypt; email: ahmed.zaky@ejust.edu.eg},
	editor = {Sayed M.S. and Muta O. and El-Sherif A.A.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833159107-6},
	language = {English},
	abbrev_source_title = {Proc. Int. Japan-Africa Conf. Electron., Commun., Comput., JAC-ECC},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Zhang2026272,
	author = {Zhang, Huan and Wang, Haiyan and Long, Shaofang and Tan, Hao and Wang, Ziyu and Jia, Yan and Gu, Zhaoquan},
	title = {SecKQL-Agent: A Real-World APT29 Events Benchmark and Framework for Reliable Text-to-KQL in Security Analytics},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {16540 LNCS},
	pages = {272 - 288},
	doi = {10.1007/978-981-92-0378-9_17},
	url = {https://www.scopus.com/pages/publications/105040349595?origin=resultslist},
	affiliations = {School of Computer Science and Technology, Harbin Institute of Technology, Shenzhen, China; Department of New Networks, Pengcheng Laboratory, Shenzhen, China},
	abstract = {Text-to-query language (Text-to-QL) techniques allow analysts to express complex threat-hunting and investigation intents in natural language, lowering the barrier to large-scale security telemetry and facilitating practical security analytics. Yet, despite this potential, public resources for this domain remain scarce due to the technical complexities involved in handling wide-column, semi-structured, and high-volume security datasets. To fill this gap, we construct SecKQL-APT29, a Kusto Query Language (KQL) benchmark derived from real APT29 attack traces. It offers an executable, structured schema and expert-annotated Text-to-KQL pairs. We also propose SecKQL-Agent, a Text-to-KQL framework tailored for security analytics that addresses limitations of directly applying Text-to-SQL methods: (i) redundant and oversized schemas, (ii) limited domain adaptation to security query languages, and (iii) semantic mismatch between generated queries and user intent. SecKQL-Agent comprises three components: a Hybrid-attention Schema Refiner for relevant and compact schema selection; an Adaptive Few-shot Generator for robust query generation; and a Chain-of-Thought (CoT)-driven Semantic Consistency Reflector for result-aware semantic validation. Experiments on two benchmarks against three representative baselines show that SecKQL-Agent achieves an optimal balance between execution accuracy and computational efficiency, demonstrating its effectiveness and generalizability. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2026.},
	author_keywords = {Cybersecurity Analytics; Kusto Query Language (KQL); LLM-based Agent; Text-to-Query Generation},
	keywords = {Natural language processing systems; Network security; Query languages; Query processing; Security systems; Semantics; Structured Query Language; Cyber security; Cybersecurity analytic; Kusto query language; Large-scales; LLM-based agent; Natural languages; Query generation; Real-world; Security Analytics; Text-to-query generation; Computational efficiency},
