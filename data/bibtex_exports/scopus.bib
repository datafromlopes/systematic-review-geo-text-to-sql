@CONFERENCE{Wu2026575,
	author = {Wu, Xiaojie},
	title = {A Dual-Loop Agentic Framework for Text-to-SQL: Integrating Statistical-Enhanced Retrieval with Execution-Guided Self-Correction},
	year = {2026},
	journal = {2026 6th International Conference on Artificial Intelligence and Industrial Technology Applications, AIITA 2026},
	pages = {575 - 581},
	doi = {10.1109/AIITA69518.2026.11567299},
	url = {https://www.scopus.com/pages/publications/105043745562?origin=resultslist},
	affiliations = {University of Sydney, Sydney, 2006, NSW, Australia},
	abstract = {Text-to-SQL - translating natural language into executable SQL queries - is a core challenge for large language models (LLMs) in database-centric intelligent interaction. Existing methods suffer from schema hallucination, reasoning chain disruption, and syntax contamination when confronted with large-scale databases featuring non-standard naming conventions, complex multi-table joins, and domain-specific terminology. This paper presents a systematic empirical evaluation of three approaches: (1) few-shot prompt engineering, (2) standard retrieval-augmented generation (RAG), and (3) the proposed Dual-Loop Agentic Framework. Experiments on 200 samples from the BIRD benchmark show that while standard RAG raises the valid SQL rate from 70.0% to 88.5%, it fails to improve execution accuracy over the few-shot baseline (both 33.5%) and increases logic errors from 60 to 90 cases, revealing an inherent RAG accuracy paradox. To address this, we propose a dual-loop framework: an outer loop performs statistical-enhanced metadata re-ranking via TF-IDF weighted scoring and cross-encoder reranking to refine schema selection; an inner loop drives execution-guided self-correction through anomaly detection and a critic agent that routes errors to type-specific correction prompts. Our framework achieves 37.0% execution accuracy (+3.5 pp over baselines), 94.0% valid SQL rate, and reduces syntax errors by 80% (60 → 12 cases). © 2026 IEEE.},
	author_keywords = {BIRD Benchmark; Execution-Guided Self-Correction; Large Language Models; Retrieval-Augmented Generation; Statistical Metadata Re-ranking; Text-to-SQL},
	keywords = {Anomaly detection; Big data; Birds; Computational linguistics; Errors; Information retrieval; Metadata; Natural language processing systems; Query languages; Query processing; Search engines; Structured Query Language; Text processing; Translation (languages); BIRD benchmark; Dual loops; Execution-guided self-correction; Language model; Large language model; Re-ranking; Retrieval-augmented generation; Self-correction; Statistical metadata re-ranking; Text-to-SQL; Syntactics},
