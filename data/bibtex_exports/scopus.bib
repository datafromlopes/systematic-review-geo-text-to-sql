	journal = {2025 International Conference on Electronics and Computing, Communication Networking Automation Technologies, ICEC2NT 2025},
	pages = {},
	doi = {10.1109/ICEC2NT65402.2025.11380122},
	url = {https://www.scopus.com/pages/publications/105041765730?origin=resultslist},
	affiliations = {Department of CSE, National Institute of Technology Silchar, Assam, India; Department of MCA, IMSCD&R, Maharashtra, India; Department of MCA, IBMRD, Maharashtra, India},
	abstract = {Interacting with relational databases often requires expertise in Structured Query Language (SQL), which limits accessibility for non-technical users. Natural Language Interfaces to Databases (NLIDBs) aim to bridge this gap by translating user questions in plain language into executable SQL queries. Recent developments in large language models (LLMs) have improved this translation process, yet decoder-only models face challenges in handling large schemas, generating accurate queries in complex scenarios, and managing prompt length efficiently. This study presents a hybrid approach that integrates a Retrieval-Augmented Generation (RAG) framework with an encoder-decoder model based on the Text-to-Text Transfer Transformer (T5). The system filters and retrieves schema components relevant to the user query and feeds them, along with the original input, to the model for SQL generation. Evaluated on both a real-world industrial dataset and the Spider benchmark, the proposed method demonstrates improvements in accuracy and execution success while significantly reducing token usage. Additionally, the model is optimized for low-latency inference through quantization and self-hosted deployment. The experimental results indicate that combining focused schema retrieval with encoder-decoder architectures enhances both performance and efficiency in natural language to SQL translation tasks. © 2025 IEEE.},
	author_keywords = {GPT Comparison; NLIDB; Retrieval Augmented Generation; Schema Optimization; T5; Text-to-SQL; Transformer},
	keywords = {Computational linguistics; Information retrieval; Natural language processing systems; Query languages; Query processing; Relational database systems; Search engines; Signal encoding; Text processing; Translation (languages); Encoder-decoder; GPT comparison; Natural language interface to database; Optimisations; Retrieval augmented generation; Schema optimization; Structured Query Language; T5; Text-to-structured query language; Transformer; Decoding},
