@CONFERENCE{Tripathi2025,
	author = {Tripathi, Anurag and Patle, Vaibhav and Jain, Abhinav and Pundir, Ayush and Menon, Sairam and Singh, Ajeet Kumar and Herremans, Dorien},
	title = {End-to-End Text-to-SQL with Dataset Selection: Leveraging LLMs for Adaptive Query Generation},
	year = {2025},
	journal = {Proceedings of the International Joint Conference on Neural Networks},
	pages = {},
	doi = {10.1109/IJCNN64981.2025.11227747},
	url = {https://www.scopus.com/pages/publications/105023963003?origin=resultslist},
	affiliations = {Infoorigin Pvt Ltd., India; J&J Innovative Medicine Technology, R&D, United States; Singapore University of Technology and Design, Singapore},
	abstract = {Text-to-SQL bridges the gap between natural language and structured database language, thus allowing nontechnical users to easily query databases. Traditional approaches model text-to-SQL as a direct translation task, where a given Natural Language Query (NLQ) is mapped to an SQL command. Recent advances in large language models (LLMs) have significantly improved translation accuracy, however, these methods all require that the target database is pre-specified. This becomes problematic in scenarios with multiple extensive databases, where identifying the correct database becomes a crucial yet overlooked step. In this paper, we propose a three-stage end-to-end text-to-SQL framework to identify the user's intended database before generating SQL queries. Our approach leverages LLMs and prompt engineering to extract implicit information from natural language queries (NLQs) in the form of a ruleset. We then train a large db_id prediction model, which includes a RoBERTa-based finetuned encoder, to predict the correct Database identifier (db_id) based on both the NLQ and the LLM-generated rules. Finally, we refine the generated SQL by using critic agents to correct errors. Experimental results demonstrate that our framework outperforms the current state-of-the-art models in both database intent prediction and SQL generation accuracy. © 2025 IEEE.},
	author_keywords = {LLM: Large language Model; RoBERTa: Robustly Optimized BERT Approach; SQL: Structured Query Language; text-to-SQL},
	correspondence_address = {A. Tripathi; Infoorigin Pvt Ltd., India; email: anurag.tripathi@infoorigin.com; V. Patle; Infoorigin Pvt Ltd., India; email: vaibhav.patle@infoorigin.com; A. Jain; Infoorigin Pvt Ltd., India; email: abhinav.jain@infoorigin.com; A. Pundir; Infoorigin Pvt Ltd., India; email: ayush.pundir@infoorigin.com; A.K. Singh; Infoorigin Pvt Ltd., India; email: ajeetkumar.singh@infoorigin.com},
