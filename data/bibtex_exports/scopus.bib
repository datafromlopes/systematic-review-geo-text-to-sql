	title = {Distill-C: Enhanced NL2SQL via Distilled Customization with LLMs},
	year = {2025},
	journal = {Proceedings of the 2025 Annual Conference of the Nations of the Americas Chapter of the Association for Computational Linguistics: Human Language Technologies: Long Papers, NAACL-HLT 2025},
	volume = {3},
	pages = {833 - 848},
	doi = {10.18653/v1/2025.naacl-industry.64},
	url = {https://www.scopus.com/pages/publications/105027174422?origin=resultslist},
	affiliations = {Oracle Analytics Cloud (OAC), Australia; Oracle Health & AI (OHAI), Australia; Oracle Labs, Switzerland},
	abstract = {The growing adoption of large language models (LLMs) in business applications has amplified interest in Natural Language to SQL (NL2SQL) solutions, in which there is competing demand for high performance and efficiency. Domain- and customer-specific requirements further complicate the problem. To address this conundrum, we introduce Distill-C, a distilled customization framework tailored for NL2SQL tasks. Distill-C utilizes large teacher LLMs to produce high-quality synthetic data through a robust and scalable pipeline. Fine-tuning smaller and open-source LLMs on this synthesized data enables them to rival or outperform teacher models an order of magnitude larger. Evaluated on multiple challenging benchmarks,<sup>1</sup> Distill-C achieves an average improvement of 36% in execution accuracy compared to the base models from three distinct LLM families. Additionally, on three internal customer benchmarks, Distill-C demonstrates a 22.6% performance improvement over the base models. Our results demonstrate that Distill-C is an effective, high-performing and generalizable approach for deploying lightweight yet powerful NL2SQL models, delivering exceptional accuracies while maintaining low computational cost. © 2025 Association for Computational Linguistics.},
	keywords = {Computational linguistics; Natural language processing systems; Open systems; Base models; Business applications; Customisation; High quality; Higher efficiency; Language model; Natural languages; Performance; Synthetic data; Teachers'; Benchmarking},
