	title = {On Modern Text-to-SQL Semantic Parsing Methodologies for Natural Language Interface to Databases: A Comparative Study},
	year = {2023},
	journal = {5th International Conference on Artificial Intelligence in Information and Communication, ICAIIC 2023},
	pages = {390 - 396},
