	keywords = {Automatic programming; Information systems; Information use; Large datasets; Natural language processing systems; Query languages; Query processing; Structured programming; Structured Query Language; Codegeneration; Data generation; Domain specific; Language model; Natural language interfaces; Software-systems; SQL-to-text; State of the art; Synthetic data; Text-to-SQL; Software reliability},
