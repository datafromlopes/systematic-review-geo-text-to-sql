@CONFERENCE{Lan202431,
	author = {Lan, Zhibo and Li, Shuangyin},
	title = {PS-SQL: Phrase-based Schema-Linking with Pre-trained Language Models for Text-to-SQL Parsing},
	year = {2024},
	journal = {2024 6th International Conference on Natural Language Processing, ICNLP 2024},
