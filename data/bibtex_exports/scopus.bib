}

@CONFERENCE{Gao2025661,
	author = {Gao, Weihong and Li, Xinying and Qin, Bin},
	title = {Lightweight Text-to-SQL Enhancement via Schema Ranking and Skeleton-Constrained CoT Distillation},
	year = {2025},
	journal = {Proceedings of 2025 5th International Symposium on Artificial Intelligence and Big Data, AIBDF 2025},
	pages = {661 - 666},
	doi = {10.1109/AIBDF67964.2025.11440751},
	url = {https://www.scopus.com/pages/publications/105036844275?origin=resultslist},
	affiliations = {Shenzhen University, Shenzhen, China},
	abstract = {Cross-database Text-to-SQL tasks require models to perform both structural planning (Skeleton Parsing) and Schema Linking on unfamiliar database schemas. The high coupling of these two subtasks significantly increases generation complexity and error rates. To address this challenge, this paper proposes a two-stage framework based on Chain-of-Thought (CoT) enhancement and decoupled generation. The first stage utilizes Parameter-Efficient Fine-Tuning (PEFT) to output a Ranked Schema sequence and a SQL Skeleton, thereby reducing the search space and providing macroscopic structural guidance. The second stage employs explicit Chain-of-Thought reasoning under the dual constraints of the skeleton and schema to complete the step-by-step filling and generation from logical planning to the final SQL. To overcome the insufficient reasoning capability of small-parameter models, we design an automated data synthesis pipeline based on large-parameter models to construct a high-quality CoT distillation dataset containing steps such as "Skeleton Fit Check"and "Constraint Inventory,"and perform instruction fine-tuning on the Qwen-8B model. Experiments on the Spider dataset demonstrate that this method effectively combines the advantages of schema decoupling and explicit reasoning, with the second-stage model achieving an Execution Accuracy (EX) of approximately 85%. Results confirm that the proposed ranking strategy, skeleton constraints, and CoT distillation paradigm significantly improve generation stability and executability in complex query scenarios. © 2025 IEEE.},
	author_keywords = {Chain-of-Thought (CoT); Knowledge Distillation; Lightweight Models; Schema Ranking; Text-to-SQL},
	keywords = {Chains; Database systems; Large datasets; Musculoskeletal system; Query processing; Tuning; Chain-of-thought; Database schemas; Error rate; Fine tuning; Knowledge distillation; Lightweight model; Parameter model; Schema ranking; Subtask; Text-to-SQL; Distillation},
	correspondence_address = {B. Qin; Shenzhen University, Shenzhen, China; email: qinbin@szu.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833156992-1},
	language = {English},
	abbrev_source_title = {Proc. Int. Symp. Artif. Intell. Big Data, AIBDF},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Ruskanda2025,
	author = {Ruskanda, Fariska Zakhralativa and Halim, Michael Jonathan},
	title = {Relevance Summarization for Example-Guided Text-to-SQL Generation in Complex Schema Database},
	year = {2025},
	journal = {2025 12th International Conference on Advanced Informatics: Concept, Theory and Application, ICAICTA 2025},
	pages = {},
	doi = {10.1109/ICAICTA67604.2025.11335034},
	url = {https://www.scopus.com/pages/publications/105033024505?origin=resultslist},
	affiliations = {Bandung Institute of Technology, School of Electrical Engineering and Informatics, Indonesia; Bandung Institute of Technology, Artificial Intelligence Center, Bandung, Indonesia},
	abstract = {Recent progress in Large Language Models has pushed Text-to-SQL systems closer to enabling natural language queries over complex relational databases. Unfortunately, the models sometimes misread the provided examples, making mistakes in joins, aggregations, or predicates, issues that we label as misunderstanding knowledge evidence. To tackle this, we introduce relevance summarization, a simple prompting technique that adds brief, natural-language overviews to few-shot examples, clarifying the role of each schema element. Tests on the Academic dataset, which contains twenty-two tables, indicate that this approach lifts performance. The execution accuracy rose from a baseline 75% to 85% with relevance summaries in a 3-shot prompt setup, while the rate of semantic errors decreased dramatically between models, including GPT-4.1 Mini, Gemini 1.5 Pro, and Deepseek V3. The findings reveal that this method increases the correct query execution rates and decreases typical logical errors, confirming its value for Text-to-SQL in practical environments.  © 2025 IEEE.},
	author_keywords = {large language models; misunderstanding knowledge evidence; relevance summarization; Text-to-SQL},
	keywords = {Computational linguistics; Natural language processing systems; Query languages; Query processing; Relational database systems; Language model; Large language model; Misunderstanding knowledge evidence; Natural language queries; Natural languages; Recent progress; Relational Database; Relevance summarization; Simple++; Text-to-SQL; Semantics},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833159178-6},
	language = {English},
	abbrev_source_title = {Int. Conf. Adv. Informatics: Concept, Theory Appl., ICAICTA},
	type = {Conference paper},
