	year = {2025},
	journal = {Proceedings of the 13th International Japan-Africa Conference on Electronics, Communications, and Computations, JAC-ECC 2025},
	pages = {235 - 239},
	doi = {10.1109/JAC-ECC67970.2025.11417544},
	url = {https://www.scopus.com/pages/publications/105036001575?origin=resultslist},
	affiliations = {Alexandria University, Faculty of Science, Department of Mathematics and Computer Science, Alexandria, Egypt; Benha University, Faculty of Engineering (Shoubra), Department of Electrical Engineering, Qalubiya, Banha, 13511, Egypt; Egypt-Japan University of Science and Technology, Department of Computer Science and Information Technology, New Borg El-Arab City, Alexandria, 21934, Egypt},
	abstract = {Large Language Models have recently emerged as a trans-formative paradigm for the Text-to-SQL task, exhibiting strong capabilities in translating natural language questions - including those expressed in Arabic - into executable database queries. Nevertheless, progress in this area remains constrained, highlighting a critical research gap and motivating the evaluation of large language models on the Arabic Text-to-SQL task to systematically assess their effectiveness, efficiency and cost in various linguistic contexts The main goal of the present study is to systematically evaluate the performance of large language models on the Arabic Text-to-SQL task. Building on these findings, we introduce a new integrated framework, which achieves 66.60% execution accuracy on the AraSpider Dataset, establishing a new state-of-the-art performance standard. We aim for our research to deepen the understanding of Arabic Text-to-SQL applications with LLMs and to encourage further exploration. © 2025 IEEE.},
