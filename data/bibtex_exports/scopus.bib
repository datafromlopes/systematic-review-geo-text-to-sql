	title = {Improving Demonstration Diversity by Human-Free Fusing for Text-to-SQL},
	year = {2024},
	journal = {EMNLP 2024 - 2024 Conference on Empirical Methods in Natural Language Processing, Findings of EMNLP 2024},
	pages = {1193 - 1207},
