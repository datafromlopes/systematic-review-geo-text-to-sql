@ARTICLE{Liu20256343,
	author = {Liu, Dingwei and Wang, Yan and Tian, Yuxuan and Zeng, Zhiqiang and Liu, Su and Zheng, Weipeng and Xiao, Yufeng},
	title = {MixCoT-SQL: A User-Adaptive Text-to-SQL Framework Based on Mixed Chain-of-Thought and Result Reflection Refinement},
	year = {2025},
	journal = {Proceedings of the IEEE International Conference on Big Data, BigData},
	number = {2025},
	pages = {6343 - 6352},
	doi = {10.1109/BigData66926.2025.11400955},
	url = {https://www.scopus.com/pages/publications/105037788882?origin=resultslist},
	affiliations = {Xiamen University of Technology, Xiamen, China; Fujian Provincial Tobacco, Monopoly Bureau, Fuzhou, China; Putian Municipal Tobacco, Monopoly Bureau, Putian, China; Fuzhou Municipal Tobacco, Monopoly Bureau, Fuzhou, China},
	abstract = {With the rapid development of large language models (LLMs), generating structured queries from natural language (Text-to-SQL) with LLMs has become a hot spot in combining databases with artificial intelligence. However, existing methods, such as based on simple prompts or finetuning, suffer from limited prompts or expensive training cost, which is not suitable for cold-start scenarios lacking of user interactions. To address these issues, MixCoT-SQL, a Text-toSQL framework based on mixing of multiple Chain-of-Thoughts, is proposed for adapting to the personalized needs of users. It employs a multi-path Chain-of-Thought prompting strategy to increase the diversity of generated SQLs, and incorporates a feedback-driven reflection mechanism to learn user preferences and optimize generation strategies dynamically. Extensive experiments on several datasets, such as Spider, BIRD, and a real-world enterprise dataset WT, have shown that the execution accuracy of MixCoT-SQL is superior to those of other baselines by 3% - 10%, which demonstrates high robustness on different domains. The code is available at https://github.com/peanutldw/MixCoT-SQL. © 2025 IEEE.},
	author_keywords = {Chain-of-Thought; cold-start; LLM; Multi-agent Framework; Text-to-SQL},
	keywords = {Chains; Intelligent agents; Natural language processing systems; Query languages; Starting; Chain-of-thought; Cold-start; Hotspots; Language model; Large language model; Multiagent framework; Natural languages texts; Structured queries; Text-to-SQL; User-adaptive; Multi agent systems},
	correspondence_address = {Y. Wang; Xiamen University of Technology, Xiamen, China; email: wangyan@xmut.edu.cn},
	editor = {Xu C.-Z. and U L.H. and Cheng X. and Gao J. and Polese G. and Mei H. and Boniol P. and Tatsubori M. and Zhao C. and Zhou D. and Hu X.},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	issn = {25732978},
	isbn = {979-833159447-3},
	language = {English},
	abbrev_source_title = {Proc.  IEEE Int. Conf. Big Data, BigData},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Guo2024341,
	author = {Guo, Chunxi and Tian, Zhiliang and Tang, Jintao and Li, Shasha and Wen, Zhihua and Wang, Kaixuan and Wang, Ting},
	title = {Retrieval-Augmented GPT-3.5-Based Text-to-SQL Framework with Sample-Aware Prompting and Dynamic Revision Chain},
	year = {2024},
	journal = {Lecture Notes in Computer Science (including subseries Lecture Notes in Artificial Intelligence and Lecture Notes in Bioinformatics)},
	volume = {14452 LNCS},
	pages = {341 - 356},
	doi = {10.1007/978-981-99-8076-5_25},
	url = {https://www.scopus.com/pages/publications/85188615905?origin=resultslist},
	affiliations = {College of Computer, National University of Defense Technology, Changsha, China},
	abstract = {Text-to-SQL aims at generating SQL queries for the given natural language questions and thus helping users to query databases. Prompt learning with large language models (LLMs) has emerged as a recent approach, which designs prompts to lead LLMs to understand the input question and generate the corresponding SQL. However, it faces challenges with strict SQL syntax requirements. Existing work prompts the LLMs with a list of demonstration examples (i.e. question-SQL pairs) to generate SQL, but the fixed prompts can hardly handle the scenario where the semantic gap between the retrieved demonstration and the input question is large. In this paper, we propose a retrieval-augmented prompting method for an LLM-based Text-to-SQL framework, involving sample-aware prompting and a dynamic revision chain. Our approach incorporates sample-aware demonstrations, which include the composition of SQL operators and fine-grained information related to the given question. To retrieve questions sharing similar intents with input questions, we propose two strategies for assisting retrieval. Firstly, we leverage LLMs to simplify the original questions, unifying the syntax and thereby clarifying the users’ intentions. To generate executable and accurate SQLs without human intervention, we design a dynamic revision chain that iteratively adapts fine-grained feedback from the previously generated SQL. Experimental results on three Text-to-SQL benchmarks demonstrate the superiority of our method over strong baseline models. © The Author(s), under exclusive license to Springer Nature Singapore Pte Ltd. 2024.},
	author_keywords = {Large language model; Prompt learning; Text-to-SQL},
	keywords = {Computational linguistics; Information retrieval; Iterative methods; Learning systems; Natural language processing systems; Semantics; Syntactics; Fine grained; Language model; Large language model; Model-based OPC; Natural language questions; Prompt learning; Semantic gap; SQL query; Text-to-SQL; User's intentions; Demonstrations},
	correspondence_address = {Z. Tian; College of Computer, National University of Defense Technology, Changsha, China; email: tianzhiliang@nudt.edu.cn},
	editor = {Luo B. and Cheng L. and Wu Z.-G. and Li H. and Li C.},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {03029743},
	isbn = {978-981998075-8},
	language = {English},
	abbrev_source_title = {Lect. Notes Comput. Sci.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 22}
}

@CONFERENCE{Prakash2026,
	author = {Prakash, P. Arul and Shakthi, S. and Sri Santhiya, M.P. and Shreeja, A.V. and Subash, S. and Eyamini, C.},
	title = {AI-Powered Transformer Framework for Intelligent Natural Language to SQL Query Generation},
	year = {2026},
	journal = {2026 International Conference on Smart Futuristic Technology, ICSFT 2026},
	pages = {},
	doi = {10.1109/ICSFT66733.2026.11507944},
	url = {https://www.scopus.com/pages/publications/105041639358?origin=resultslist},
	affiliations = {Suguna College of Engineering, Department of Artificial Intelligence and Data Science, Nehru Nagar West, Civil Aerodrome (PO), Tamilnadu, Coimbatore, 641014, India; Suguna College of Engineering, Department of Artificial Intelligence and Data Science, Tamil Nadu, Coimbatore, India},
	abstract = {Natural language database interfaces frequently do not generate SQL that is structurally correct when the queries involve complex joins, nested queries, and queries that are ambiguous in terms of schema. The work introduces an AI-powered Transformer framework that supports bidirectional semantic encoding, schema linking, and constraint-aware SQL generation. The model uses a pre-trained T5-Large encoder as well as a relational schema graph made up of 5,752 table-column nodes and 14,986 relationship edges allowing for reasoning over explicit structure. The framework is evaluated on the Spider and WikiSQL benchmarks of 10,181 training queries, 1,034 development queries, and 15,878 natural-language questions. The experiments achieve 84.72% exact-match accuracy on Spider and 92.41% logical-form accuracy on WikiSQL, surpassing the prior best baselines by 6.18% and 4.35%, respectively. SQL generation times were average 1.83 seconds and were brought down to 0.97 seconds for real time deployment. These results confirm that transformer driven semantic parsing leads to improvements in correctness, generalization and execution fidelity in NL-to-SQL translation. These results indicate that the framework proposed yields a gain in exact-match accuracy, reliability of execution and efficiency in latency in all types of database scenarios. © 2026 IEEE.},
	author_keywords = {Natural-Language Interface; Semantic Parsing; SQL Generation; Text-to-SQL; Transformer Architecture},
	keywords = {Information systems; Natural language processing systems; Query languages; Query processing; Semantic Web; Semantics; Structured Query Language; Syntactics; Encodings; Natural language database interface; Natural language interfaces; Natural languages; Query generation; Semantic parsing; SQL generation; SQL query; Text-to-SQL; Transformer architecture; Signal encoding},
	correspondence_address = {P.A. Prakash; Suguna College of Engineering, Department of Artificial Intelligence and Data Science, Coimbatore, Nehru Nagar West, Civil Aerodrome (PO), Tamilnadu, 641014, India; email: arulprakash247@gmail.com},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
