@CONFERENCE{Sun202311225,
	author = {Sun, Shuo and Zhang, Yuchen and Yan, Jiahuan and Gao, Yuze and Ong, Donovan and Chen, Bin and Su, Jian},
	title = {Battle of the Large Language Models: Dolly vs LLaMA vs Vicuna vs Guanaco vs Bard vs ChatGPT - A Text-to-SQL Parsing Comparison},
	year = {2023},
	journal = {Findings of the Association for Computational Linguistics: EMNLP 2023},
	pages = {11225 - 11238},
	doi = {10.18653/v1/2023.findings-emnlp.750},
