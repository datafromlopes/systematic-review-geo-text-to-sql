@CONFERENCE{Peng2026,
	author = {Peng, Zewu and Yang, Yufei and Zhou, Fangfang and Yao, Xu},
	title = {Bridging the reality gap in text-to-SQL: a multiparadigm empirical study on synthetic data efficacy across model scales},
	year = {2026},
	journal = {Proceedings of SPIE - The International Society for Optical Engineering},
	volume = {14170},
	pages = {},
	doi = {10.1117/12.3110251},
	url = {https://www.scopus.com/pages/publications/105039612532?origin=resultslist},
	affiliations = {Guangdong Power Grid Co., Ltd., Guangzhou, 510000, China},
	abstract = {The integration of Large Language Models (LLMs) into Natural Language Interfaces to Databases (NLIDBs) has transformed the field, yet their deployment in high-stakes, domain-specific environments is constrained by the chronic scarcity of high-quality, aligned text-SQL pairs. To circumvent the high costs of manual annotation, research has pivoted toward Data Synthesis; however, the current literature lacks a systematic evaluation of how these synthesis methodologies interact with the heterogeneous capabilities of base models. This paper addresses this gap by formalizing synthesis into four distinct paradigms: Rule-Based Augmentation, PLM-driven Reverse Generation, Agentic Frameworks, and Domain-Specific Refinement. We leverage this taxonomy to conduct an exhaustive empirical study, benchmarking representative synthesis frameworks across a diverse matrix of state-of-the-art code LLMs on standard benchmarks. Our evaluation reveals a non-linear "Inverse Capability Law": while weaker base models exhibit substantial performance gains from synthetic supervision, stronger models display heightened sensitivity to distributional shifts, occasionally suffering from performance regression. Furthermore, we demonstrate that although agentic paradigms significantly outperform traditional augmentation, a hybrid finetuning strategy consistently establishes state-of-the-art results. This study provides a rigorous, evidence-based roadmap for designing resilient Text-to-SQL systems, advocating for capability-aware data curricula over monolithic scaling.  © 2026 The Authors.},
	author_keywords = {data synthesis; large language models; Text-to-SQL},
	keywords = {Codes (symbols); Database systems; Inverse problems; Natural language processing systems; Base models; Data synthesis; Domain specific; Empirical studies; Language model; Large language model; Multi-paradigm; Reality gaps; State of the art; Text-to-SQL; Benchmarking},
