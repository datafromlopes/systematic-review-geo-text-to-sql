@CONFERENCE{Hao202529892,
	author = {Hao, Zhifeng and Huang, Junqi and Shi, Shaobin and Cai, Ruichu and Xu, Boyan},
	title = {GenLink: Generation-Driven Schema-Linking via Multi-Model Learning for Text-to-SQL},
	year = {2025},
	journal = {EMNLP 2025 - 2025 Conference on Empirical Methods in Natural Language Processing, Proceedings of the Conference},
	pages = {29892 - 29905},
	doi = {10.18653/v1/2025.emnlp-main.1518},
	url = {https://www.scopus.com/pages/publications/105040177503?origin=resultslist},
	affiliations = {School of Computer Science, Guangdong University of Technology, China; College of Science, Shantou University, China; Peng Cheng Laboratory, China},
	abstract = {Schema linking is widely recognized as a key factor in improving text-to-SQL performance. Supervised fine-tuning approaches enhance SQL generation quality by explicitly fine-tuning schema linking as an extraction task. However, they suffer from two major limitations: (i) The training corpus of small language models restricts their cross-domain generalization ability. (ii) The extraction-based fine-tuning process struggles to capture complex linking patterns. To address these issues, we propose GenLink, a generation-driven schema-linking framework based on multi-model learning. Instead of explicitly extracting schema elements, GenLink enhances linking through a generation-based learning process, effectively capturing implicit schema relationships. By integrating multiple small language models, GenLink improves schema-linking recall rate and ensures robust cross-domain adaptability. Experimental results on the BIRD and Spider benchmarks validate the effectiveness of GenLink, achieving execution accuracies of 67.34% (BIRD), 89.7% (Spider development set), and 87.8% (Spider test set), demonstrating its superiority in handling diverse and complex database schemas. Our implementation will be open-sourced at https://github.com/DMIRLAB-Group/GenLink. © 2025 Association for Computational Linguistics.},
	keywords = {Computational linguistics; Learning systems; Natural language processing systems; Personnel training; Tuning; Cross-domain; Fine tuning; Generalization ability; Key factors; Language model; Linking pattern; Model learning; Multi-modelling; Performance; Training corpus; Extraction},
	correspondence_address = {B. Xu; School of Computer Science, Guangdong University of Technology, China; email: hpakyim@gmail.com},
