@CONFERENCE{Zhao20261648,
	author = {Zhao, Jie and Wang, Minghao and Yang, Jingjing and Hu, Zhiguang and Jiang, Xuejun and Ding, Lifu},
	title = {PowerSQL: A Large Language Model-Assisted Domain-Adapted Text-to-SQL Framework for Power System Data Querying},
