	author = {Ma, Xingyu and Tian, Xin and Wu, Lingxiang and Wang, Xuepeng and Tang, Xueming and Wang, Jinqiao},
	title = {SQL-Checker: Error Detection and Labeling for Text-to-SQL with Interpretability Analysis},
	year = {2026},
	journal = {WWW 2026 - Proceedings of the ACM Web Conference 2026},
	pages = {2025 - 2036},
	doi = {10.1145/3774904.3792212},
	url = {https://www.scopus.com/pages/publications/105038555524?origin=resultslist},
	affiliations = {Huazhong University of Science and Technology, Wuhan, China; Wuhan AI Research, Wuhan, China; Institute of Automation, Chinese Academy of Sciences, Beijing, China; School of Artificial Intelligence, University of Chinese Academy of Sciences, China; Peng Cheng Laboratory, China},
	abstract = {Text-to-SQL technology converts natural language queries into SQL statements for database retrieval. Recent advances in large language models (LLMs) have improved Text-to-SQL performance, but generated SQL often contains semantic or syntax errors that degrade user experience and system stability. Existing SQL error detection methods are costly, lack interpretability, and do not support error labeling. To overcome these issues, we propose SQL-Checker a specialized model for Text-to-SQL error detection. We first analyze common error factors in Text-to-SQL, and we design a novel data synthesis framework based on these error factors. This framework simulates error factors to construct a basic error SQL data, and then using an error analysis template to distill high-quality SQL error analysis data from large-scale models. For complex errors, a self-guided iterative distillation strategy further enhances data quality. SQL-Checker is then trained on this distilled dataset. Additionally, we refine SQL error labeling and, integrate error label recognition into the detection task, enabling macro-level cause analysis. Experiments show SQL-Checker achieves state-of-the-art results on multiple error detection datasets. Incorporating SQL-Checker into the Text-to-SQL pipeline also improves execution accuracy. © 2026 Owner/Author.},
	author_keywords = {large language models; sql error detection; text-to-sql},
	keywords = {Computational linguistics; Error analysis; Error detection; Information retrieval systems; Iterative methods; Natural language processing systems; Query languages; Query processing; User experience; Database retrieval; Error factors; Interpretability; Labelings; Language model; Large language model; Natural language queries; Sql error detection; SQL statements; Text-to-sql; Semantics},
	correspondence_address = {X. Wang; Institute of Automation, Chinese Academy of Sciences, Beijing, China; email: xuepeng.wang@ia.ac.cn; X. Tang; Huazhong University of Science and Technology, Wuhan, China; email: xmtang@hust.edu.cn},
