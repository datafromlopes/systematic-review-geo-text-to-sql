@CONFERENCE{Nobre2026270,
	author = {Nobre, Lucas and Sousa, Suele and Teles, Savio and Soares, Anderson},
	title = {Language Effects in Text-to-SQL Across English and Portuguese},
	year = {2026},
	journal = {17th International Conference on Computational Processing of Portuguese, PROPOR 2026},
	volume = {1},
	pages = {270 - 280},
	url = {https://www.scopus.com/pages/publications/105040946871?origin=resultslist},
	affiliations = {Instituto de Informática, Universidade Federal de Goiás, Brazil},
	abstract = {Text-to-SQL systems allow users to query relational databases using natural language, but accuracy remains sensitive to the choice of language, model architecture, and prompting strategy. Although recent Large Language Models (LLMs) incorporate reasoning mechanisms that improve multi-step problem solving in other domains, their effects on multilingual Text-to-SQL are not yet well understood. This work evaluates a diverse set of LLMs on the BIRD benchmark and BIRD_PT, a Portuguese version produced by translating the questions and external knowledge while keeping the original English database schema and values unchanged. We compare four controlled scenarios that vary internal reasoning and guided reasoning for SQL generation. The results show a consistent decrease in accuracy when switching from English to Portuguese, with large variations in robustness across models. Reasoning alone does not reliably improve execution accuracy and can reduce performance in Portuguese, while combining reasoning with a guided plan provides the most stable improvements, although still weaker than in English. These findings highlight ongoing challenges in multilingual Text-to-SQL and emphasize the need to jointly consider language understanding, reasoning activation, and task-aligned planning when designing future systems. © 2026 Association for Computational Linguistics.},
	keywords = {Computational linguistics; Natural language processing systems; Problem solving; Query languages; External knowledge; Language effects; Language model; Modeling architecture; Multilingual texts; Multisteps; Natural languages; Problem-solving; Reasoning mechanism; Relational Database; Birds},
	publisher = {Association for Computational Linguistics (ACL)},
	isbn = {979-889176387-6},
	language = {English},
	abbrev_source_title = {Int. Conf. Comput. Process. Portuguese, PROPOR},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Junior2025211370,
	author = {Junior, Gilberto N. and Marcon, Cesar},
	title = {OPTIC—OPtimized Translation and Interaction for Cloud-Costs: Use of FOCUS Standardization and LLM Integration for Cloud Billing Analysis},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {211370 - 211381},
	doi = {10.1109/ACCESS.2025.3643821},
	url = {https://www.scopus.com/pages/publications/105024779960?origin=resultslist},
	affiliations = {Graduate Program in Computer Science, Pontifical Catholic University of Rio Grande do Sul (PPGCC/PUCRS), Rio Grande do Sul, Porto Alegre, 90619-900, Brazil},
	abstract = {Managing billing data across multicloud environments remains a significant challenge due to heterogeneous data formats, fragmented cost metrics, and the technical complexity of cost analysis. This paper introduces the OPtimized Translation & Interaction for Cloud-costs (OPTIC) framework, a novel approach that combines the FinOps Open Cost and Usage Specification (FOCUS) with Large Language Models (LLMs) to enable natural language interaction with standardized billing data. OPTIC automates the Extraction, Transformation, and Loading (ETL) of cost and usage data from major cloud providers, consolidates them into a unified SQL database, and translates natural user questions into SQL queries using LLM-based text-to-SQL techniques. A web-based interface supports both predefined dashboards and a chatbot for dynamic queries. Experimental results using benchmark datasets demonstrate an accuracy of up to 82.5% in SQL generation, showcasing the framework’s effectiveness in Financial Operations (FinOps) contexts. By simplifying multicloud cost analysis, OPTIC aims to democratize access to financial insights and support data-driven decision-making in both technical and non-technical teams. © 2013 IEEE.},
	author_keywords = {Cloud computing; cost analysis; data integration; data visualization; decision making; financial management; large language models (LLM); multicloud computing; natural language processing; natural language processing (NLP); SQL; standardization; web interfaces},
