	author = {Zhang, Weixu and Wang, Yifei and Song, Yuanfeng and Wei, Victor Junqiu and Tian, Yuxing and Qi, Yiyan and Chan, Jonathan H. and Wong, Raymond Chi-Wing and Yang, Haiqin},
	title = {Natural Language Interfaces for Tabular Data Querying and Visualization: A Survey (Extended Abstract)},
	year = {2025},
	journal = {Proceedings - International Conference on Data Engineering},
	pages = {4710 - 4711},
	doi = {10.1109/ICDE65448.2025.00384},
	url = {https://www.scopus.com/pages/publications/105015391372?origin=resultslist},
	affiliations = {International Digital Economy Academy (IDEA), China; Xi'an Jiaotong University, China; University of Toronto, Canada; WeBank Co., Ltd., China; Hong Kong University of Science and Technology, China; Xidian University, China; King Mongkut's University of Technology Thonburi, Thailand},
	abstract = {Natural Language Interfaces (NLIs) have transformed data interaction by enabling natural language querying and visualization of tabular data. Despite the growing importance of NLIs, prior research has examined querying and visualization tasks separately, lacking a unified perspective, especially in the era of Large Language Models (LLMs). To fill this gap, this survey provides a comprehensive analysis of NLIs for tabular data, examining their evolution and fundamental components: datasets, evaluation metrics, and architectural designs. By analyzing over 60 approaches and 38 datasets, we explore recent advancements in Text-to-SQL and Text-to-Vis tasks, focusing on semantic parsing techniques for natural language translation to SQL queries and visualization specifications. We evaluate the impact of LLMs on these systems, discussing their capabilities and limitations. Our systematic review serves as a roadmap for developing NLIs in the foundation model era.  © 2025 IEEE.},
	author_keywords = {Large Language Models; Natural Language Interface; Semantic Parsing; Text-to-SQL; Text-to-Visualization},
	keywords = {Abstracting; Computational linguistics; Data visualization; Natural language processing systems; Query languages; Query processing; Semantics; Syntactics; Data querying; Extended abstracts; Language model; Large language model; Natural language interfaces; Natural languages; Semantic parsing; Tabular data; Text to visualization; Text-to-SQL; Visualization},
	correspondence_address = {H. Yang; International Digital Economy Academy (IDEA), China; email: haiqin.yang@gmail.com},
	publisher = {IEEE Computer Society},
	issn = {10844627},
	isbn = {979-833153603-9},
	language = {English},
	abbrev_source_title = {Proc Int Conf Data Eng},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Dai2025829,
	author = {Dai, Yunsong},
	title = {Fine-Tuning Large Language Models for Text-to-SQL},
	year = {2025},
	journal = {2025 IEEE 5th International Conference on Electronic Technology, Communication and Information, ICETCI 2025},
	pages = {829 - 834},
	doi = {10.1109/ICETCI64844.2025.11084052},
	url = {https://www.scopus.com/pages/publications/105013072250?origin=resultslist},
	affiliations = {Jilin University, School of Business and Management, Changchun, China},
	abstract = {In recent years, the integration of natural language processing (NLP) with database querying has led to the emergence of Text-to-SQL systems, which enable nontechnical users to interact with databases using natural language. While existing models, particularly those based on large language models (LLMs), have demonstrated remarkable generalization capabilities, they face challenges in generating complex multi-table and nested queries, as well as adapting to cross-domain tasks. This paper proposes a novel approach for Text-to-SQL tasks by utilizing supervised fine-tuning (SFT) on large language models. By leveraging high-quality annotated datasets, the proposed method significantly improves the accuracy of complex SQL generation and enhances cross-domain adaptability. Comprehensive evaluations on the Spider and CHASE datasets demonstrate that our approach achieves superior performance, with Exact Match (EM) scores of 36.5% and 45.5% for the deepseek-SQL and Qwen2.5-SQL models, respectively. The findings highlight the effectiveness of fine-tuning in optimizing LLMs for Text-to-SQL tasks, reducing inference costs, and bridging the gap between semantic parsing accuracy and real-world application requirements. © 2025 IEEE.},
	author_keywords = {Large Language Model; Natural Language Processing; Supervised Fine-Tuning; Text-to-SQL},
	keywords = {Computational linguistics; Query languages; Query processing; Search engines; Semantics; Structured Query Language; Syntactics; Tuning; Cross-domain; Database querying; Fine tuning; Language model; Language processing; Large language model; Natural language processing; Natural languages; Supervised fine-tuning; Text-to-SQL; Natural language processing systems},
	correspondence_address = {Y. Dai; Jilin University, School of Business and Management, Changchun, China; email: daiys9922@mails.jlu.edu.cn},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
	isbn = {979-833153372-4},
	language = {English},
	abbrev_source_title = {IEEE Int. Conf. Electron. Technol., Commun. Inf., ICETCI},
	type = {Conference paper},
