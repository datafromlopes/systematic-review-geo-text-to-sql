	note = {Cited by: 22}
}

@CONFERENCE{Xia2025411,
	author = {Xia, Zhihong and Zhang, Xiankun and Pu, Zhen},
	title = {RAG-NL2SQL:Implementing the Conversion from Natural Language to Unstructured Database Query Language Based on RAG},
	year = {2025},
	journal = {Proceedings - 2025 IEEE International Symposium on Parallel and Distributed Processing with Applications, ISPA 2025},
	pages = {411 - 418},
	doi = {10.1109/ISPA67752.2025.00061},
	url = {https://www.scopus.com/pages/publications/105030142701?origin=resultslist},
	affiliations = {College of Artificial Intelligence, Tianjin University of Science and Technology, Tianjin, China},
	abstract = {So far, natural language to structured query language (NL2SQL) conversion has become a critical technology for database access and intelligent question answering. Unstructured databases have gained wide application in data storage for their flexibility. However, the complexity of unstructured databases and the diversity of natural language expressions present significant challenges for existing NL2SQL methods, particularly in semantic understanding and the generation of complex SQL queries. To address these issues, this paper proposes an NL2SQL approach based on Retrieval-Augmented Generation (RAG), which dynamically retrieves relevant contextual information to enhance the input of large language models, thereby improving the comprehension of complex semantics and the accuracy of SQL generation. The results show a promising direction for RAG to enhance the capabilities of current language models, even though their accuracy remains insufficient when used unsupervised. We conducted systematic experiments on public datasets, and the results demonstrate that the proposed method significantly outperforms traditional NL2SQL approaches and simple prompting techniques across multiple complex scenarios, exhibiting particularly strong adaptability and accuracy in unstructured data environments.  © 2025 IEEE.},
	author_keywords = {large language models; NL2SQL; Retrieval-Augmented Generation; unstructured databases},
	keywords = {Digital storage; Natural language processing systems; Query processing; Semantics; Structured Query Language; Systems analysis; Critical technologies; Database access; Database query language; Language model; Large language model; Natural languages; NL2SQL; Retrieval-augmented generation; Structured Query Language; Unstructured database; Query languages},
	correspondence_address = {X. Zhang; College of Artificial Intelligence, Tianjin University of Science and Technology, Tianjin, China; email: zhxkun@tust.edu.cn},
	editor = {Zhao L. and Sun Y. and Yang K. and Liu Z. and Bensliman A. and Malekian R.},
