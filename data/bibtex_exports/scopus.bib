@CONFERENCE{Sun2025,
	author = {Sun, Ni and Dong, Qi and Liu, Xiaokang and Wang, Yi},
	title = {Constructing a text-to-SQL knowledge base for enterprise environments using earth mover's distance in decarbonized field},
	year = {2025},
	journal = {Proceedings of SPIE - The International Society for Optical Engineering},
	volume = {13955},
	pages = {},
	doi = {10.1117/12.3092331},
	url = {https://www.scopus.com/pages/publications/105025742916?origin=resultslist},
	affiliations = {Audi FAW NEV Company Changchun, Jilin, Changchun, 130103, China; China FAW Group Co., Ltd. Changchun, Changchun, China; China Auto Information Technology (Tianjin) Co., Ltd., China},
	abstract = {In the dual-carbon era, automotive manufacturing plants deploy thousands of energy meters, PLC loggers and MES tables to trace electricity, thermal and material flows across stamping, welding, painting and final-assembly lines. These systems generate hundreds of inter-linked tables - covering kWh-level renewable share, kg-level CO2e per vehicle, and t-level carbon-quota balances - that domain engineers query with extremely long and intricate SQL to monitor real-time carbon footprints, optimize green-electricity dispatch and forecast compliance gaps. Yet the corresponding natural language questions remain strikingly short (8-12 tokens): "2024 BEV life-cycle CO2?"or "top three plants with renewable ratio >60 %?"This profound length/complexity mismatch cripples conventional Text-to-SQL retrieval: dense or sparse encodings collapse the fine-grained semantics of nested, multi-join carbon-accounting queries into a single vector, yielding poor recall and degraded end-to-end accuracy. We present EM-SQL-Carbon, a retrieval method that re-casts the similarity between a terse carbon question and a verbose SQL query as an optimal-transport problem via Earth Mover's Distance between token-level embeddings. By preserving the compositional structure of carbon-indicators, joins and filters, EM-SQL-Carbon avoids semantic collapse and delivers markedly higher recall. Evaluated on a real-world dual-carbon automotive dataset spanning 2.3 M rows of plant-level emissions and renewable-energy logs, EM-SQL-Carbon improves Hit@10 by 27 % over state-of-the-art baselines, setting a new benchmark for Text-to-SQL in sustainable automotive manufacturing. © COPYRIGHT SPIE.},
	author_keywords = {Earth Mover's Distance (EMD); Large Language Models (LLMs); Text-to-SQL},
	keywords = {Carbon footprint; Electric load dispatching; Flowmeters; Query languages; Query processing; Automotive manufacturing; Earth mover distance; Earth Movers Distance; Energy meters; Enterprise environment; Language model; Large language model; Manufacturing plant; Renewables; Text-to-SQL; Knowledge based systems; Life cycle},
