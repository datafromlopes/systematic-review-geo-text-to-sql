@inproceedings{10.1145/3769994.3770024,
author = {Laaksonen, Antti and Korpimies, Kai and Luukkainen, Matti},
title = {Trends in Students' SQL Queries in the Era of Generative AI},
year = {2025},
isbn = {9798400715990},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3769994.3770024},
doi = {10.1145/3769994.3770024},
abstract = {This paper studies recent trends in SQL queries in an introductory databases course. The course includes a set of SQL exercises where students create SQL queries that retrieve information from database tables. We analyze a dataset collected from the years 2020–2024, which consists of almost 340,000 queries students submitted to the course system. From the data, it can be seen that certain patterns in queries are clearly more prevalent in 2023 and 2024 than before. A possible reason for this is that the way generative AI tools create SQL queries can be seen in students’ submissions. Our results can help identify students who have used AI tools to create SQL queries and provide insight into how these tools might influence the way SQL queries are written.},
booktitle = {Proceedings of the 25th Koli Calling International Conference on Computing Education Research},
articleno = {48},
numpages = {7},
keywords = {Databases course, SQL queries, Generative AI},
location = {
