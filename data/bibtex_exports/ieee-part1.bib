@INPROCEEDINGS{10825844,
  author={Katikeri, Raghu and Phaniraja, Sai and Pratheek, Sai and Desai, Rajvi and Vaid, Amit and Shukla, Neelesh and Jain, Sandeep},
  booktitle={2024 IEEE International Conference on Big Data (BigData)}, 
  title={T2I-RISE: Text-to-Insights with Reinforcement learning, Integration of Semantic layers and Enrichment - A Comprehensive Approach with Conversational Context and Feedback Systems}, 
  year={2024},
  volume={},
  number={},
  pages={1993-1998},
  abstract={This study introduces T2I-RISE, an innovative approach aimed at enabling natural language querying of databases, which could transform data-driven decision making. Currently, database insights are mostly generated by a limited group of experts. Business Intelligence tools provide some insights, but these are often static. We propose a comprehensive solution tailored for enterprise applications to bridge the gap between user needs and existing capabilities. Despite the industry’s increasing use of Text2SQL powered by Large Language Models (LLM), implementation challenges remain, particularly in managing large-scale database schema representations. Our study explores the critical elements needed for user intent comprehension and the generation of corresponding SQL and insights. T2I-RISE offers a comprehensive framework and thorough analysis of these components, including our unique optimization strategies.},
  keywords={Structured Query Language;Databases;Large language models;Semantics;Natural languages;Decision making;Transforms;Reinforcement learning;Business intelligence;Optimization;LLM;Text2SQL;Insights Generation;Databases;Evaluation Framework},
  doi={10.1109/BigData62323.2024.10825844},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11403136,
  author={Chen, Hongyi},
  booktitle={2025 25th Conference of the Electric Power Supply Industry (CEPSI)}, 
  title={Research on an Ontology-Enhanced Intelligent Query System for Power Equipment Based on IEC 61970/61968 Standards}, 
  year={2025},
  volume={},
  number={},
  pages={912-917},
  abstract={To address the semantic gap between natural language queries and structured databases in power equipment management, this paper proposes an enhanced Text2SQL optimization method. Our approach integrates IEC 61970/61968 standards with ontology and leverages large models to generate SQL. By constructing a power equipment ontology library that conforms to the Common Information Model (CIM), designing a deep learning model with a hierarchical attention mechanism, and integrating the natural language understanding capabilities of large language models, this study achieves precise conversion from natural language to standardized SQL queries. Experiments show that the system's exact matching rate in complex query scenarios has increased to 82.3%, and the accuracy of multi-table association has reached 89.3%, effectively supporting business needs such as equipment status monitoring, energy efficiency analysis, and fault early warning. This research provides theoretical support and a technological innovation path for the intelligent operation and maintenance of power systems.},
  keywords={Technological innovation;Structured Query Language;Large language models;Semantics;Optimization methods;Ontologies;Cognition;Common Information Model (electricity);IEC Standards;Standards;IEC 61970/61968;Ontology;Text2SQL;Large Language Model;Power Equipment Management;Common Information Model (CIM) Model},
  doi={10.1109/CEPSI66359.2025.11403136},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11129346,
  author={Sann, Thet Su and Kimsong, Tang and Rojanarowan, Jerapong and Patanavijit, Vorapoj},
  booktitle={2025 10th International STEM Education Conference (iSTEM-Ed)}, 
  title={VMES Chatbot: Leveraging Large Language Models for SQL-Based Information Retrieval}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={AI-driven chatbots have become a powerful tool in educational settings due to the increasing demand to optimize academic information retrieval. This paper introduces Vincent Mary School of Engineering, Science and Technology chatbot (VMES chatbot), a conversational AI system that leverages large language models (LLMs) and Text-to-SQL generation to automate course-related queries. In order to ensure rapid and reliable database interactions, the chatbot uses few-shot prompting to convert user questions into optimized SQL queries. Furthermore, a hybrid agent-based approach improves adaptability across different academic information systems by enabling flexible querying of relational databases and structured data. The system offers faculty members and students an easy-to-use platform by integrating with an API and web interface. The potential of LLM-powered agents is demonstrated by VMES Chatbot, which enhances accessibility to academic resources by combining natural language understanding, structured data processing, and query optimization in university information retrieval systems.},
  keywords={Structured Query Language;Large language models;Query processing;Education;Relational databases;Transforms;Chatbots;Information retrieval;Multilingual;Reliability;Text-to-SQL;conversational AI;large language models;academic information retrieval;natural language processing},
  doi={10.1109/iSTEM-Ed65612.2025.11129346},
  ISSN={},
  month={July},}@INPROCEEDINGS{10822294,
  author={Zhang, Haodi and Nie, Jinyin and Liu, Zeming and Lei, Dong and Song, Yuanfeng},
  booktitle={2024 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={Automatic SQL Query Generation from Code Switched Natural Language Questions on Electronic Medical Records}, 
  year={2024},
  volume={},
  number={},
  pages={2844-2851},
  abstract={Electronic Medical Records (EMRs) meticulously document patient information in relational databases, presenting a challenging task for medical professionals to effectively retrieve this data. Natural Language Question to SQL query (NL2SQL), a critical task in natural language processing (NLP), shows promising performance in addressing this challenge. However, existing medical NL2SQL studies often focus on generating SQL queries from monolingual questions in English. None of them have studied medical NL2SQL for the Chinese domain.In Chinese EMRs, the questions are primarily in Chinese, while many medical terms, such as drugs and diseases, are commonly described in English. This phenomenon is generally known as code-switching (CS) in the field. Given that underlying systems are typically monolingual, CS has proven to pose significant accuracy challenges, as observed in many tasks such as Automatic Speech Recognition (ASR) and Machine Translation (MT). However, the potential effects on EMRs NL2SQL have not been explored. In this study, we investigate the CS-NL2SQL problem, focusing on CS in the context of Chinese questions for the NL2SQL task on EMRs. To assess the model’s performance on this task, we construct the first CS-NL2SQL dataset named CS-MIMICSQL in medical domains. We then explore different CS-NL2SQL architectures along two dimensions: cascaded (translation followed by SQL generation) vs. end-to-end. Our results demonstrate that the proposed end-to-end structure can outperform much better than the cascaded baselines.},
  keywords={Drugs;Structured Query Language;Translation;Biological system modeling;Focusing;Switches;Relational databases;Machine translation;Electronic medical records;Diseases;Electronic Medical Records Analysis;NL2SQL;Code Switching},
  doi={10.1109/BIBM62325.2024.10822294},
  ISSN={2156-1133},
  month={Dec},}@INPROCEEDINGS{11313204,
  author={Madkor, Nour and El Nezamy, Rana and Abdou, Rawan and Yasser, Salma and Essam, Mohamed and El-Regaily, Salsabil},
  booktitle={2025 Twelfth International Conference on Intelligent Computing and Information Systems (ICICIS)}, 
  title={LexaQuery: Automated Query Generation}, 
  year={2025},
  volume={},
  number={},
  pages={721-727},
  abstract={In today's data-driven world, organizations rely heavily on meaningful insights to make rapid decisions, yet non-technical stakeholders often face challenges when dealing with complex database systems. Traditional reliance on SQL experts or data analysts delays important decision-making. To bridge this gap, we present LexaQuery, a secure, on-premises system that enables users to interact with both SQL and NoSQL (Typesense) databases using plain natural language. LexaQuery is powered by large language models (LLMs), specifically Qwen-Coder 2.5, to provide an easy-to-use chat-based interface that eliminates the need for technical experience and knowledge. The system integrates a multilayer security pipeline ensuring input validation and protecting the model against prompt and SQL injection attacks, achieving 98.28% validation accuracy. For SQL query generation, the Qwen-Coder 2.5 3B model achieves 76.8% accuracy on the Spider benchmark, while the beta version of the NoSQL module, driven by customized prompt engineering, successfully generated valid Typesense queries for 7 out of 10 representative test cases. LexaQuery also includes automated data visualization of the results to enhance the interpretation of results for non-technical users. Experimental results show that the system delivers high accuracy, strong security, and ease of use, significantly reducing the time needed to gain business insights.},
  keywords={Structured Query Language;Accuracy;Large language models;Natural languages;Pipelines;Syntactics;Transformers;Security;Prompt engineering;Usability;text-to-SQL;text-to-NoSQL;Generative AI;Large Language Models (LLMs);Prompt Injection},
  doi={10.1109/ICICIS66182.2025.11313204},
  ISSN={2831-5952},
  month={Nov},}@INPROCEEDINGS{10096172,
  author={Li, Yuntao and Su, Zhenpeng and Li, Yutian and Zhang, Hanchu and Wang, Sirui and Wu, Wei and Zhang, Yan},
  booktitle={ICASSP 2023 - 2023 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={T5-SR: A Unified Seq-to-Seq Decoding Strategy for Semantic Parsing}, 
  year={2023},
  volume={},
  number={},
  pages={1-5},
  abstract={Translating natural language queries into SQLs in a seq2seq manner has attracted much attention recently. However, compared with abstract-syntactic-tree-based SQL generation, seq2seq semantic parsers face much more challenges, including poor quality on schematical information prediction and poor semantic coherence between natural language queries and SQLs. This paper analyses the above difficulties and proposes a seq2seq-oriented decoding strategy called SR, which includes a new intermediate representation SSQL and a reranking method with score re-estimator to solve the above obstacles respectively. Experimental results demonstrate the effectiveness of our proposed techniques and T5-SR-3b achieves new state-of-the-art results on the Spider dataset.},
  keywords={Structured Query Language;Semantics;Natural languages;Coherence;Signal processing;Acoustics;Decoding;Semantic Parsing;Text-to-SQL;Seq-to-Seq Decoding;Natural Language Processing},
  doi={10.1109/ICASSP49357.2023.10096172},
  ISSN={2379-190X},
  month={June},}@INPROCEEDINGS{10773417,
  author={Arslan, Erhan and Harinda, Eugen},
  booktitle={2024 9th International Conference on Computer Science and Engineering (UBMK)}, 
  title={Innovating SQL Automation: Evaluating Open-Source Large Language Models with a Dual-Stage Approach for Corporate Data Solutions}, 
  year={2024},
  volume={},
  number={},
  pages={68-73},
  abstract={As Large Language Models (LLMs) continue to advance in their ability to process natural language, their potential to transform industries and reshape the future of human-computer interaction becomes increasingly evident. This study evaluates the application of Large Language Models (LLM) to automate SQL query generation from natural language inputs in enterprise environments. We investigated the feasibility of using open-source LLMs, including Mistral, CodeLlama, Phi-3, and DeepSeek Coder, by fine-tuning them with a custom dataset reflecting company-specific data tables. This dataset was iteratively constructed using a baseline LLM that allows fine-tuning to address unique enterprise data structures and use cases. A two-stage filtering and refinement mechanism was implemented to improve query accuracy. The first stage identifies relevant tables and the second stage adds an iterative error correction step to improve the SQL query generation process. The resulting system significantly reduced query errors and increased accuracy by 84%,88%,81%, and 90% for Mistral, CodeLlama, Phi-3, and DeepSeek Coder LLM. However, challenges remain in resource consumption and logical error handling. Future work will focus on improving contextual understanding and integrating advanced AI techniques to further enhance robustness and applicability.},
  keywords={Industries;Structured Query Language;Accuracy;Filtering;Large language models;Computational modeling;Natural languages;Transforms;Robustness;Iterative methods;Large Language Models;Text-to-SQL;Corporate Data Management;Automated Reporting;Query Automation},
  doi={10.1109/UBMK63289.2024.10773417},
  ISSN={2521-1641},
  month={Oct},}@INPROCEEDINGS{11539707,
  author={LK, Shoba and Biradavolu, Geethika and Pandi, Himasree},
  booktitle={2026 12th International Conference on Communication and Signal Processing (ICCSP)}, 
  title={AI-Powered SQL Generation Using Natural Language Processing for Intelligent Database Interaction}, 
  year={2026},
  volume={},
  number={},
  pages={352-357},
  abstract={Natural language interfaces for databases have gained significant attention as organizations seek to democratize data access for non-technical users while maintaining query correctness and security. Recent advances in large language models have enabled more accurate translation of natural language queries into structured query language, yet challenges remain in schema awareness, safety enforcement, and crossdatabase compatibility. This work presents an AI-powered, schema-aware natural language-to-SQL generation framework that enables intelligent and secure database interaction through a web-based interface. The system automatically discovers database schemas, including tables, attributes, and relational constraints, and incorporates this contextual knowledge into a prompt-engineered language model pipeline for accurate SQL synthesis. Multi-layer validation mechanisms enforce read-only query execution, prevent malicious operations, and ensure syntactic correctness using dialect-aware parsing. The generated queries are dynamically adapted to multiple database engines, enabling seamless interoperability across heterogeneous environments. Additionally, the framework supports file-driven table creation, real-time query execution, and interactive result visualization to enhance analytical usability. Experimental evaluation using diverse query categories demonstrates reliable SQL generation, robust safety compliance, and efficient execution performance. The proposed approach highlights the feasibility of integrating large language models with schema intelligence and execution safeguards to enable trustworthy natural language database interaction in real-world data-driven applications.},
  keywords={Databases;Structured Query Language;Artificial intelligence;Natural languages;Modeling;Visualization;Printing;Timing;Large language models;Engines;Natural language processing;Text-to-SQL generation;schema-aware learning;large language models;database security;SQL validation},
  doi={10.1109/ICCSP68173.2026.11539707},
  ISSN={2836-1873},
  month={April},}@INPROCEEDINGS{11060527,
  author={Jooste, Reuben and Rananga, Seani and Sindane, Thapelo},
  booktitle={2025 IST-Africa Conference (IST-Africa)}, 
  title={Optimising SQL Generation for Afrikaans Through an English-to-Afrikaans Double Translation Method}, 
  year={2025},
  volume={},
  number={},
  pages={1-10},
  abstract={Neural Machine Translation (NMT) has achieved remarkable progress in translating languages with varying resource levels. However, the performance can be hindered by limited data availability and poor-quality corpora for low-resource languages (LRL). The aim of this study is to optimise SQL generation for Afrikaans through a “query double translation” method. Here, high-resource language (HRL) prompts (e.g., English) are translated to a LRL (e.g., Afrikaans) to improve SQL query generation. First, we evaluate three NMT models for English-to-Afrikaans translation, selecting the best-performing model to translate an English-to-SQL dataset. This dataset is then fine-tuned for Afrikaans-to-SQL conversion. The resulting model's performance is benchmarked against the original English SQL data and compared with two large language models (LLM). This study addresses NMT challenges in LRLs and highlights potential SQL generation improvements for underrepresented languages.},
  keywords={Measurement;Structured Query Language;Adaptation models;Translation;Large language models;Neural machine translation;Benchmark testing;Data models;Meteors;Neural Machine Translation (NMT);low-resource language (LRL);high-resource language (HRL);Text-to-SQL},
  doi={10.23919/IST-Africa67297.2025.11060527},
  ISSN={2576-8581},
  month={May},}@INPROCEEDINGS{11023950,
  author={Busany, Nimrod and Hadad, Hananel and Maszlanka, Zofia and Shelke, Rohit and Price, Gregory and Akhigbe, Okhaide and Amyot, Daniel},
  booktitle={2025 IEEE/ACM 47th International Conference on Software Engineering: New Ideas and Emerging Results (ICSE-NIER)}, 
  title={Optimizing Experiment Configurations for LLM Applications Through Exploratory Analysis}, 
  year={2025},
  volume={},
  number={},
  pages={46-50},
  abstract={The integration of Large Language Models (LLMs) into software applications necessitates informed design choices across various configurations, including LLM selection, prompting techniques, and their parameters, and prompt templates. Many of these choices are arbitrary, and developers often lack guidance on optimizing configurations. In this work, we define the Experiment Configuration Optimization Problem and illustrate it with a real-world Text-to-SQL application we developed. Our results show that most configurations are sub-optimal, with only a few offering a favorable trade-off between accuracy and cost. Highlighting the critical need for systematic exploration, we show that extensive experimentation is expensive, underscoring the importance for cost-effective methods to navigate the configuration space. Our findings motivate further research into methodologies that effectively optimize LLM application configurations.},
  keywords={Analytical models;Systematics;Costs;Navigation;Large language models;Retrieval augmented generation;Software;Prompt engineering;Optimization;Software engineering;Feature Modeling;Prompt Engineering;Prompting Techniques;LLM;Retrieval-Augmented Generation},
  doi={10.1109/ICSE-NIER66352.2025.00015},
  ISSN={2832-7632},
  month={April},}@ARTICLE{11299524,
  author={Junior, Gilberto N. and Marcon, César},
  journal={IEEE Access}, 
  title={OPTIC—OPtimized Translation and Interaction for Cloud-Costs: Use of FOCUS Standardization and LLM Integration for Cloud Billing Analysis}, 
  year={2025},
  volume={13},
  number={},
  pages={211370-211381},
  abstract={Managing billing data across multicloud environments remains a significant challenge due to heterogeneous data formats, fragmented cost metrics, and the technical complexity of cost analysis. This paper introduces the OPtimized Translation & Interaction for Cloud-costs (OPTIC) framework, a novel approach that combines the FinOps Open Cost and Usage Specification (FOCUS) with Large Language Models (LLMs) to enable natural language interaction with standardized billing data. OPTIC automates the Extraction, Transformation, and Loading (ETL) of cost and usage data from major cloud providers, consolidates them into a unified SQL database, and translates natural user questions into SQL queries using LLM-based text-to-SQL techniques. A web-based interface supports both predefined dashboards and a chatbot for dynamic queries. Experimental results using benchmark datasets demonstrate an accuracy of up to 82.5% in SQL generation, showcasing the framework’s effectiveness in Financial Operations (FinOps) contexts. By simplifying multicloud cost analysis, OPTIC aims to democratize access to financial insights and support data-driven decision-making in both technical and non-technical teams.},
  keywords={Costs;Structured Query Language;Cloud computing;Translation;Standards organizations;Standardization;Organizations;Optical sensors;Loading;Integrated optics;Cloud computing;cost analysis;data integration;decision making;financial management;large language models (LLM);multicloud computing;natural language processing (NLP);SQL;standardization;data visualization;natural language processing;web interfaces},
  doi={10.1109/ACCESS.2025.3643821},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11504675,
  author={Yu, Wangyan},
  booktitle={2026 IEEE 8th International Conference on Communications, Information System and Computer Engineering (CISCE)}, 
  title={Research on Intelligent Sensing and Operational Co-Optimization for 5G-A Networks}, 
  year={2026},
  volume={},
  number={},
  pages={327-330},
  abstract={This paper proposes a novel end-to-end 5G-A network operation optimization method with three core innovative modules based on multi-source data fusion and intelligent sensing, and verifies it in a provincial-level commercial network. Based on actual operational data of a provincial commercial 5G-A network, the study constructs a multi-source dataset integrating terminal specification information, network access characteristics, performance indicators, and user tags, covering 15 months of operational data, 230 million network event records, and 287,000 user samples from across the province. Firstly, a pre-trained large language model is introduced to construct a novel LLM-driven dynamic data closed-loop mechanism for terminal information calibration; furthermore, based on general natural language to query (Text2SQL) technology and combined with 5G-A domain knowledge, an innovative domain-enhanced intelligent query engine is constructed, supporting semantic understanding of business terms, multi-round interactive queries, and automatic result visualization. Experimental results show that the proposed method increases the collection coverage of key 5G-A network indicators from 0% to 100%; the accuracy of terminal user identification increases from 30% of traditional methods to 95.3%; the intelligent query system reduces the average data acquisition time for frontline personnel from 2 hours to 4.2 minutes, achieves a multi-round query intent understanding accuracy of 91.5%, and generates dynamic reports covering 23 business scenarios. The research results have been widely applied in network operations, supporting related business analysis and efficiency improvement. The study demonstrates that multi-source data fusion and intelligent sensing methods can effectively improve the operational efficiency and user identification capabilities of 5G-A networks, providing valuable practical experience for the intelligent operation of communication networks.},
  keywords={Radio networks;Radio broadcasting;Central Processing Unit;Oscillators;5G mobile communication;Internet of Things;Communication systems;Internet;Mobile communication;Wireless communication;5G-A;multi-source data fusion;terminal identification;operational collaboration;Text2SQL;knowledge graph},
  doi={10.1109/CISCE69494.2026.11504675},
  ISSN={2833-2423},
  month={March},}@ARTICLE{11264326,
  author={Liao, Yuan and Bian, Jiang and Yun, Yuhui and Wang, Shuo and Zhang, Yubo and Chu, Jiaming and Wang, Tao and Li, Yuchen and Li, Xuhong and Ji, Shilei and Xiong, Haoyi},
  journal={IEEE Transactions on Services Computing}, 
  title={SageCopilot: An LLM-Empowered Autonomous Agent for Data Science as a Service}, 
  year={2026},
  volume={19},
  number={1},
  pages={642-656},
  abstract={While the field of natural language to SQL(NL2SQL) has made significant advancements in translating natural language instructions into executable SQL scripts for data querying and processing, achieving full automation within the broader data science pipeline–encompassing data querying, analysis, visualization, and reporting–remains a complex challenge. This study introduces SageCopilot, an advanced, industry-grade system that automates the data science pipeline by integrating Large Language Models (LLMs), Autonomous Agents (AutoAgents), and Language User Interfaces (LUIs). Designed with a two-phase architecture, SageCopilot uses an offline phase to generate high-quality demonstrations supporting In-Context Learning (ICL), which powers the online phase to transform user inputs into executable scripts for database queries, analysis, and visualization tasks. Leveraging specialized components such as NL2SQL, Text2Analyze, and Text2Viz, as well as chain-of-thought prompting for multi-turn interactions, SageCopilot achieves superior end-to-end automation. Rigorous experimentation with real-world datasets demonstrates the system’s ability to minimize human intervention while ensuring correctness and user-friendly operation.},
  keywords={Data visualization;Data science;Structured Query Language;Pipelines;Accuracy;Semantics;Visual databases;Metadata;Autonomous agents;Automation;LLMs;agents;data analysis;in-context learning;human-computer interaction},
  doi={10.1109/TSC.2025.3635384},
  ISSN={1939-1374},
  month={Jan},}@INPROCEEDINGS{11182823,
  author={Zhang, Junrui and Gou, Haosong and Qiao, Shaojie and Zhang, Gaoyi and Han, Nan},
  booktitle={2025 5th International Conference on Artificial Intelligence, Big Data and Algorithms (CAIBDA)}, 
  title={SPG-SQL: Semantic Path Guided SQL Generation Model with Gumbel-Enhanced Graph Pruning}, 
  year={2025},
  volume={},
  number={},
  pages={1658-1663},
  abstract={Aiming to reduce the learning cost of database operations, Text-to-SQL methods provide a strategy of automatically generating structured query language (SQL), which is an active research direction by integrating natural language processing and database techniques. However, the existing approaches still have disadvantages in complex structure modeling, semantic path selection, and graph structure pruning, which affect the accuracy and robustness of query generation. To address these challenges, we propose a Semantic Path Guided SQL generation model (called SPG-SQL) that integrates heterogeneous graph modeling, path attention mechanisms, and soft pruning techniques to model semantic relationships between natural languages and database schemas in a hierarchical manner. Extensive experiments on the Spider benchmark demonstrate that SPG-SQL outperforms the state-of-the-art models in exact match accuracy, which validates its effectiveness and practicability.},
  keywords={Structured Query Language;Accuracy;Costs;Databases;Semantics;Big Data;Robustness;Natural language processing;Data models;Cognition;Text-to-SQL;graph pruning;semantic path;structure awareness},
  doi={10.1109/CAIBDA65784.2025.11182823},
  ISSN={},
  month={June},}@INPROCEEDINGS{10940103,
  author={Motiwala, Mohommed Arman and Joshi, Ananya and Chapaneri, Radhika},
  booktitle={2025 IEEE International Students' Conference on Electrical, Electronics and Computer Science (SCEECS)}, 
  title={Auto-Assess: Automated Evaluation Platform for Enhanced SQL learning}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This work describes the designing and development of an AI-driven SQL learning and teaching platform that could be used for automating SQL query generation, evaluation, and feedback. Based on NLP and AI methodologies, the proposed platform makes use of Ollama’s Llama 3 for schema extraction, question generation, and grading. For answer generation, a fine-tuned Llama 3 model on a variation of the spider dataset is used. MongoDB has been utilized for scalable data storage and React for an intuitive front-end interface. The platform enables an instructor to upload datasets and automatically generate SQL-based tests for students. Students are also given immediate feedback regarding their SQL queries, which otherwise is a labor-intensive task. The platform can also overcome challenges that traditional SQL education face, such as inconsistency in grading and delay in giving feedback, thereby offering personalized feedback, comprehensive performance reports, and engaging learners. Our solution would lighten the burden of teaching SQL by ensuring less effort from instructors while teaching their students dynamically, through the assessment of queries in a real-time setting. By automation in conjunction with the feature of real-time interactivity, this solution has been steered toward an effective and scalable learning experience for SQL by both educators and learners.},
  keywords={Training;Structured Query Language;Databases;Computational modeling;Query processing;Natural languages;Memory;Real-time systems;Question generation;Artificial intelligence;Natural Language Processing(NLP);Text2SQL;AI;LLMs;SQL},
  doi={10.1109/SCEECS64059.2025.10940103},
  ISSN={2688-0288},
  month={Jan},}@ARTICLE{9311114,
  author={Bai, Tian and Ge, Yan and Guo, Shuyu and Zhang, Zhenting and Gong, Leiguang},
  journal={IEEE Access}, 
  title={Enhanced Natural Language Interface for Web-Based Information Retrieval}, 
  year={2021},
  volume={9},
  number={},
  pages={4233-4241},
  abstract={Database application is at the core of most web application systems such as web-based email, source codes repository management, public scientific data repository management, news portals, and publication repository of various fields. However, the usage of these database systems for data and information retrieval is severely limited because of lacking support for processing search queries expressed in a natural language (NL). Most web interfaces for databases today only take search queries entered in some form of logical combination of keywords or text strings, which restrict the scope and depth of what a web user really wants to search for, even though natural language based data or information retrieval has made significant advances in recent years. To overcome or at least to alleviate such limitation in web information services, we propose in this article an improved neural model based on an existing framework IRNet for NL query of databases, in which a representation of Gated Graph Neural Network (GGNN) is introduced to encode the database entities and relations. We also represent and use the database values in the prediction model to identify and match table and column names for automatic synthesize a correct SQL statement from a query expressed in a NL sentence. Experiments with a public dataset demonstrates the promising potential of our approach.},
  keywords={Databases;Structured Query Language;Natural languages;Web pages;Information retrieval;Task analysis;Predictive models;Neural network;natural language processing;text-to-SQL;gated graph neural network},
  doi={10.1109/ACCESS.2020.3048164},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11584552,
  author={Zhang, Xuyan and Cui, Rongning and Chen, Shuo and Shi, Hao and Bakaev, Maxim and Wang, Xijie and Gao, Min},
  booktitle={2026 3rd International Conference on Electronic Engineering and Information Systems (EEISS)}, 
  title={A Method for Converting Complex Natural Language Queries into SQL Statements}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={Complex natural language to SQL (CNLSQL) aims to reliably map natural-language queries with nested reasoning structures - such as subqueries, aggregation, grouped filtering, and multi-table joins - into their corresponding SQL statements. However, directly applying large language models (LLMs) to CNLSQL often yields unsatisfactory performance, especially for complex queries. To address this issue, we propose a precise SQL generation method optimized for complex queries. Experimental results demonstrate that the proposed approach is robust and adaptable across multiple business database scenarios and consistently improves the generation accuracy for complex queries. On a dataset of 600 real-world queries spanning education, enterprise management, e-commerce, and video rental domains, our method achieves a conversion accuracy of 91.2%, outperforming existing methods as well as direct LLM-based conversion.},
  keywords={Structured Query Language;Modeling;Natural languages;Printing;Databases;Accuracy;Business;Large language models;Metadata;CNLSQL;metadata completeness;relevant table selection;query type classification;prompt engineering},
  doi={10.1109/EEiSS69782.2026.11584552},
  ISSN={},
  month={April},}@INPROCEEDINGS{11430925,
  author={Kulkarni, Chaitanya and Medicherla, Chandrashekhar and Vulugundam, Bharadwaj and Patel, Tejas Pravinbhai and Shivam, Sandeep and Padhy, Amit Kumar},
  booktitle={2025 International Conference on Computer and Applications (ICCA)}, 
  title={Evaluating Natural Language Business Intelligence with Autonomous AI Databases: Architecture and Business Applications using Oracle Select AI}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Natural language interfaces enable non-technical users to extract insights from enterprise data without SQL expertise. This paper presents Oracle Select AI, an NL2SQL system embedded within Oracle Autonomous Database that translates conversational queries into executable SQL while maintaining enterprise-grade security. The system integrates Retrieval-Augmented Generation (RAG) with Oracle APEX and DBMS_CLOUD_AI package through a six-layer architecture encompassing user interfaces, natural language processing, AI generation, data management, security controls, and database execution.We demonstrate cross-domain applicability using mortgage lending (50,000 applications) and healthcare analytics (35,000 patient visits) datasets. Non-technical users loan officers, risk analysts, clinical administrators perform complex analytical tasks including eligibility screening, risk segmentation, readmission analysis, and cost evaluation through natural language. The system successfully interprets domain-specific terminology, constructs multi-table joins automatically, and enhances queries with contextual metrics. Deployment on Oracle Cloud Infrastructure leverages OCI Generative AI service with Cohere Command-R+ model.Our qualitative analysis identifies capabilities and limitations, including challenges with ambiguous terminology and complex temporal logic. This work contributes practical NL2SQL implementation insights for production environments, demonstrates architectural patterns for embedding conversational interfaces in autonomous databases, and validates cross-domain generalizability for natural language business intelligence systems.},
  keywords={Structured Query Language;Translation;Databases;Terminology;Retrieval augmented generation;Production;Medical services;Natural language processing;Business intelligence;Logic;natural language interfaces;business intelligence;autonomous database;Oracle Select AI;NL2SQL;retrieval-augmented generation;conversational analytics;enterprise data access},
  doi={10.1109/ICCA66035.2025.11430925},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11163399,
  author={Lin, Wan-Yun and Shih, Chih-Hsuan},
  booktitle={2025 International Conference on Advanced Robotics and Intelligent Systems (ARIS)}, 
  title={Empowered Smart Manufacturing Based on an Intelligent Robotic Workcell Assistant}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Large language models (LLMs) have recently demonstrated impressive capabilities in diverse applications such as text generation, machine translation, and educational assistance. However, when applied to real-world scenarios, particularly those involving physical interactions, their performance is often limited. This limitation is primarily due to their lack of access to on-site data, insufficient understanding of practical troubleshooting procedures, and limited comprehension of the complexities inherent in robotic actions. Hence, this paper proposed a server–client control framework augmented with a multi-agent LLM (Large Language Model) to enhance the robustness, scalability, and efficiency of robotic manufacturing workcells. Our system develops an AI assistant that outperforms traditional manual methods by using a centralized TCP-based protocol with JSON messages for cross-platform integration. It excels in three tasks: natural language robot code generation, text-to-SQL query, and fault diagnosis retrieval using a RAG-based semantic search. Experiments show improved robot control, accurate production data queries, and a 47.6% reduction in fault handling time, boosting maintenance efficiency and decision support.},
  keywords={Fault diagnosis;Structured Query Language;Codes;Semantic search;Large language models;Natural languages;Production;Manuals;Maintenance;Robots},
  doi={10.1109/ARIS66143.2025.11163399},
  ISSN={2572-6919},
  month={Aug},}@INPROCEEDINGS{11450575,
  author={Kumar, Nitin and Sagar, Vikas and Jain, Garima},
  booktitle={2025 International Conference on Emerging Technologies and Innovation for Sustainability (EmergIN)}, 
  title={A Comprehensive Study and Implementation of Agentic AI via MCP Servers}, 
  year={2025},
  volume={},
  number={},
  pages={42-49},
  abstract={Agentic and Multi-Agent Artificial Intelligence (AI) systems are revolutionizing business operations and collaborative decision-making. The convergence of Agentic Artificial Intelligence (Agentic AI) and Multi-Agent Systems (MAS) into enterprise ecosystems marks a paradigm shift to autonomous, adaptive, and context-aware decision-making. A structured approach is taken, classifying the literature into five themes: agentic architectures, multi-agent coordination, ethical governance, tool ecosystems, and enterprise case studies. Comparative analysis picks up improvements like layered agentic frameworks and real-time anomaly detection, as well as revealing substantial deficits in scalability, explainability, persistent learning, and multi-agent orchestration. Standardized evaluation benchmarks, interoperable toolchains, ethical governance models, and hybrid human-agent collaboration frameworks need to be developed through future research. The research concludes that the shift from conceptual innovation to enterprise-level deployment is a multidisciplinary exercise that synergizes AI research, systems engineering, and organizational change management. This review has been designed to steer researchers and practitioners alike to convert Agentic AI into an actionable force for sustainable digital transformation in enterprise settings. Additionally, we introduce a multi-location MCP(Model Context Protocol) Server implementation comprising three servers: (1) a Web/API server, (2) a data source server hosting Text-to-SQL and RAG tools, and (3) a secondary data source server with identical tools, all operating in distributed locations. The MCP servers are critical for aggregating and managing data from heterogeneous sources, enabling seamless integration with Large Language Models (LLMs) for real-time query resolution and reasoning.},
  keywords={Agentic AI;Ethics;Biological system modeling;Scalability;Ecosystems;Decision making;Real-time systems;Cognition;Servers;Multi-agent systems;Agentic AI;Multi-Agent Systems;Enterprise AI;LLM Agents;Enterprise Decision Support;Model Context Protocol},
  doi={10.1109/EmergIN67762.2025.11450575},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11525045,
  author={Yang, Haolan and Li, Zhengbo and Yin, Ruolin and Ding, Shurui and Wang, Xianrui and Liu, Youbo},
  booktitle={2026 11th Asia Conference on Power and Electrical Engineering (ACPEE)}, 
  title={Agent-Driven Topology Assembly: Trustworthy LLM Dispatch Reasoning in Distribution Networks}, 
  year={2026},
  volume={},
  number={},
  pages={1091-1096},
  abstract={Trustworthy integration of Large Language Models (LLMs) into distribution network operations is hindered by a critical structural mismatch: while safe grid operation requires explicit topology awareness, industry-standard Common Information Model (CIM) databases encode physical connectivity implicitly across fragmented relational tables. Consequently, conventional semantic retrieval fails to capture continuous physical connectivity, while unconstrained natural-language-to-SQL generation frequently yields erroneous queries due to the intricate, fragmented CIM schema. To resolve this, this paper proposes the Agent-driven Topology Assembly (ATA) framework, a tool-augmented dual-agent architecture for verifiable dispatch decision support. By decoupling cognitive exploration from deterministic data retrieval, ATA encapsulates the LLM within a secure sequential decision-making loop. Specifically, a Planner agent orchestrates deterministic topological operators to dynamically assemble a task-relevant electrical subgraph. A strictly decoupled Reasoner agent then synthesizes this assembled state into actionable, evidence-backed dispatch recommendations. Validated on a realistic CIM-compliant dataset, ATA demonstrates overwhelming superiority over traditional baselines in multi-hop topological tracing and reasoning under data uncertainty, establishing a rigorously safe paradigm for deploying AI in safety-critical grid infrastructures.},
  keywords={Modeling;Topology;Dispatching;Common Information Model (computing);Common Information Model (electricity);Computer integrated manufacturing;In-memory computing;Large language models;Databases;Cognition;agentic architecture;RAG;topology assembly;large language models;trustworthy reasoning},
  doi={10.1109/ACPEE69242.2026.11525045},
  ISSN={2996-2951},
  month={April},}@INPROCEEDINGS{10822485,
  author={Zhang, Wenlong and He, Chengyang and Yang, Guanqun and Bandyopadhyay, Dipankar and Shi, Tian and Wang, Ping},
  booktitle={2024 IEEE International Conference on Bioinformatics and Biomedicine (BIBM)}, 
  title={Natural Language Querying on Domain-Specific NoSQL Database with Large Language Models}, 
  year={2024},
  volume={},
  number={},
  pages={5174-5181},
  abstract={Efficiently and accurately retrieving specific information from healthcare datasets, such as the Vaccine Adverse Event Reporting System (VAERS) 1, presents significant challenges. A promising solution to this problem is the Text-to-ESQ approach, which is akin to Text-to-SQL tasks but leverages NoSQL database Elasticsearch, to thoroughly explore VAERS data. Non-relational databases are particularly adept at managing complex and dynamic data formats, thereby enabling the extraction of more valuable insights. However, generating executable NoSQL queries is still challenging due to the limited availability of NoSQL query datasets, which constrains model training. One potential remedy involves the use of large language models (LLMs), which can be applied in few-shot and even zero-shot learning scenarios. Nonetheless, the lack of prior evaluation for this novel task, coupled with the absence of a comprehensive, unbiased assessment of existing LLMs and prompting strategies, impedes the development of a robust architecture. Motivated by these challenges, we introduce a new Instruction-Enhanced Explainable (InstructEx) Chain-of-Thought (CoT) prompting by integrating existing CoT prompts and conducting a comprehensive investigation of LLMs and CoT prompting. The extensive experimental analysis demonstrates the effectiveness of using LLMs for Text-to-ESQ when combined with the InstructExCoT prompting. It also sheds light on the strengths and weaknesses of these methods from multiple perspectives.},
  keywords={Training;Databases;NoSQL databases;Large language models;Natural languages;Zero shot learning;Merging;Data models;Vaccines;Data mining;Natural language querying;NoSQL;Text-to-ESQ;VAERS;Elasticsearch query},
  doi={10.1109/BIBM62325.2024.10822485},
  ISSN={2156-1133},
  month={Dec},}@INPROCEEDINGS{11118725,
  author={Praneeth, Samuji and Kumar, R Prasanna and Pallavi, Gundala},
  booktitle={2025 International Conference on Computing Technologies (ICOCT)}, 
  title={QueryVerse: Transform Prompts Into Data}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The research demonstrates to create an optimized system that converts natural language to SQL queries by fine-tuning Llama-3.2-1B with Spider dataset training and LoRA (Low-Rank Adaptation) for efficient parameter tuning. The experimental setup included Unsloth’s tokenizer, gradient check-pointing, and 4-bit quantization to reduce memory consumption while maintaining inference efficiency. The model achieved evaluation results through ROUGE scores (ROUGE-1: 0.1772, ROUGE-2: 0.0345, ROUGE-L: 0.1772) and cosine similarity (0.2022) to evaluate its ability to produce structured SQL queries. The CUDA acceleration and quantization techniques led to a 50% reduction in inference time which enhanced real-time usability. A Gradio UI interface enabled the system deployment to provide users with an easy-to-use interface for generating SQL queries from their input and database schema information. The system demonstrated strong performance in single-table queries yet faced difficulties with complex multi-table joins, which require future development of schema-aware learning methods. The research advances database interaction studies by developing automatic query generation systems that enable users without extensive technical skills to use SQL.},
  keywords={Training;Structured Query Language;Adaptation models;Quantization (signal);Databases;Natural languages;Memory management;Graphics processing units;Real-time systems;Usability;LLama 3.2;SQL;ROUGE;Cosine similarity},
  doi={10.1109/ICOCT64433.2025.11118725},
  ISSN={},
  month={June},}@INPROCEEDINGS{10633550,
  author={Cagliero, Luca and Farinetti, Laura and Fior, Jacopo and Manenti, Andrea Ignazio},
  booktitle={2024 IEEE 48th Annual Computers, Software, and Applications Conference (COMPSAC)}, 
  title={ChatGPT, be my Teaching Assistant! Automatic Correction of SQL Exercises}, 
  year={2024},
  volume={},
  number={},
  pages={81-87},
  abstract={The use of Large Language Models (LLMs) such as OpenAI ChatGPT to enhance teachers' and learners' experience has become established. The impressive capabilities of ChatGPT in solving Text2SQL problems prompts their use in database courses to solve SQL exercises. In this paper, we dig deep into ChatGPT abilities applied to SQL exercises. We quantitatively and qualitatively evaluate the performance of a ChatGPT-as-a-SQL-assistant on benchmark data, with particular attention paid to its ability to correctly detect syntactic and semantic errors, provide insightful judgment explanations, and assign grades comparable to those of human teachers. Furthermore, we also analyze the benefits of leveraging few-shot learning to adapt LLM responses to the expectation.},
  keywords={Structured Query Language;Databases;Large language models;Computational modeling;Semantics;Education;Syntactics;Learning Analytics;SQL;Large Language Models;University-level education},
  doi={10.1109/COMPSAC61105.2024.00021},
  ISSN={2836-3795},
  month={July},}
