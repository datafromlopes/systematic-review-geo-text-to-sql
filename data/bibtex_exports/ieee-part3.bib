@INPROCEEDINGS{10696753,
  author={Yi, Jiawen and Chen, Guo and Shen, Zixiang},
  booktitle={2024 6th International Conference on Electronic Engineering and Informatics (EEI)}, 
  title={RH-SQL: Refined Schema and Hardness Prompt for Text-to-SQL}, 
  year={2024},
  volume={},
  number={},
  pages={1340-1343},
  abstract={Text-to-SQL is a technology that converts natural language queries into the structured query language SQL. A novel research approach that has recently gained attention focuses on methods based on the complexity of SQL queries, achieving notable performance improvements. However, existing methods entail significant storage and training costs, which hampers their practical application. To address this issue, this paper introduces a method for Text-to-SQL based on Refined Schema and Hardness Prompt. By filtering out low-relevance schema information with a refined schema and identifying query hardness through a Language Model (LM) to form prompts, this method reduces storage and training costs while maintaining performance. It's worth mentioning that this method is applicable to any sequence-to-sequence (seq2seq) LM. Our experiments on the Spider dataset, specifically with large-scale LMs, achieved an exceptional Execution accuracy (EX) of 82.6%, demonstrating the effectiveness and greater suitability of our method for real-world applications.},
  keywords={Training;Structured Query Language;Costs;Natural languages;Filtering algorithms;Information filters;Generators;Complexity theory;Informatics;Lenses;Text-to-SQL;Semantic Parsing;Natural Language Precessing},
  doi={10.1109/EEI63073.2024.10696753},
  ISSN={},
  month={June},}@INPROCEEDINGS{11368553,
  author={Kumar, Valicharla Karuna and Kanta, Kurivella Bala Venkata Mani and Srinivas, Gunti and Balaji, Gundabattini and Nagendra Kumar, Yalla Jeevan and Seetha, Maddala and Moturi, Sireesha},
  booktitle={2025 IEEE 6th Global Conference for Advancement in Technology (GCAT)}, 
  title={Semantic-Augmented Prompt-Guided Sketch Filling for Text-to-SQL Generation}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Querying relational databases through natural language remains a difficult task, especially for users without knowledge of SQL. Existing Text-to-SQL approaches often face issues of semantic ambiguity and invalid query generation. This paper introduces a prompt-guided sketch filling framework based on the T5 encoder–decoder architecture. Instead of producing entire SQL statements directly, the model completes predefined sketches by filling placeholders using both the user query and the database schema. Structured prompts and schema-aware attention strengthen the mapping between user intent and relational structure, ensuring syntactic correctness and semantic alignment. The approach was trained and evaluated on the WikiSQL benchmark, which contains over 80,000 question–SQL pairs. Experimental results show that the proposed model achieves an execution accuracy of 85.1%, outperforming the SQLNet baseline by 6.7%. These findings confirm that integrating prompt design with partial query templates provides a reliable and effective solution for natural language to SQL conversion, making database access more practical for non-technical users.},
  keywords={Deep learning;Structured Query Language;Semantics;Natural languages;Relational databases;Syntactics;Benchmark testing;Reliability engineering;Filling;Faces;Text-to-SQL;Semantic Parsing;Natural Language Interfaces;Deep Learning;SQL Sketch Filling;Schema-Aware Attention},
  doi={10.1109/GCAT66372.2025.11368553},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11522618,
  author={Zhu, Taipeng and Liu, Ye and Liu, Chenghui and Zhou, Fangfang and Liang, Yingwei},
  booktitle={2025 Asian Conference on Artificial Intelligence Technology (ACAIT)}, 
  title={MTSL-SQL: Multi-Turn Schema Linking for Context-dependent Text-to-SQL Paring with Open-Source LLMs}, 
  year={2025},
  volume={},
  number={},
  pages={973-978},
  abstract={Recently, context-dependent text-to-SQL parsing has garnered significant attention, which plays a crucial role in translating natural language into SQL within an interactive process. Existing LLM-based methods leverage context information either from interaction history or from previously predicted SQL queries, but they struggle to utilize both effectively due to mismatches between natural language and database schemas. In this paper, we propose a context-dependent text-to-SQL framework with multi-turn schema linking method, called MTSL-SQL. Specifically, MTSL-SQL integrates historical conversations and current dialogue information for schema linking, and subsequently fine-tunes open-source large language models to use selected schema and dialogue information to generate SQL queries. Extensive experimental results demonstrate that our method achieves state-of-the-art (SOTA) performance among LLM-based approaches on the SParC and CoSQL datasets.},
  keywords={Modeling;Structured Query Language;Turning;Context;Databases;Large language models;Joining processes;Printing;Current;Natural languages;text-to-SQL;schema linking;artificial intelligence},
  doi={10.1109/ACAIT67930.2025.11522618},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11362752,
  author={Nutalapati, Pavan and Keshava, Rakesh and Seshagiri, Nandagopal and Harve, Bindu Mohan and Kole, Deepak and Sahoo, Isan and Soni, Vinay},
  booktitle={2025 5th International Conference on Intelligent Cybernetics Technology & Applications (ICICyTA)}, 
  title={AI-Powered Text-to-SQL Translation: Enabling Natural Language Interfaces for Databases}, 
  year={2025},
  volume={},
  number={},
  pages={624-629},
  abstract={The complexity of Structured Query Language (SQL) creates a barrier for non-technical users who need to access insights from relational databases. This paper presents an AI-powered framework for translating natural language queries into SQL, aiming to bridge the gap between user intent and structured data access. By leveraging advancements in Natural Language Processing (NLP), particularly transformer-based models like T5 and BART, we propose a hybrid neural-symbolic architecture that incorporates schema-aware embeddings, SQL grammar constraints, and contextual understanding of user queries. Our system is designed to generalize across domains and handle complex query structures, including nested and multi-table queries. We evaluate its performance using benchmark datasets such as Spider and demonstrate real-world utility through integration with a business intelligence chatbot for retail sales analytics. The model achieves high execution accuracy and semantic match rates, outperforming baseline models like Seq2SQL and SQLNet. We also present a detailed error analysis and discuss limitations in handling ambiguous or underspecified queries. This work contributes a practical solution for democratizing data access in enterprise environments and sets the stage for further enhancements such as multilingual support, interactive query clarification, and integration with visualization platforms. Our approach empowers users of all technical backgrounds to extract meaningful insights from data through natural language interaction.},
  keywords={Structured Query Language;Translation;Accuracy;Semantics;Benchmark testing;Syntactics;Transformers;Robustness;Multilingual;Usability;Natural Language Processing (NLP);Transformer Models;Semantic Parsing;Structured Query Language (SQL);Schema Linking},
  doi={10.1109/ICICyTA68677.2025.11362752},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10067134,
  author={Visperas, Moses and Adoptante, Aunhel John and Borjal, Christalline Joie and Abia, Ma. Teresita and Catapang, Jasper Kyle and Peramo, Elmer},
  booktitle={2023 International Conference on Artificial Intelligence in Information and Communication (ICAIIC)}, 
  title={On Modern Text-to-SQL Semantic Parsing Methodologies for Natural Language Interface to Databases: A Comparative Study}, 
  year={2023},
  volume={},
  number={},
  pages={390-396},
  abstract={NLIDB research has gained popularity recently, mainly as a means of enhancing outcomes and performance. This study makes an effort to give readers background information on how the subject has evolved recently using different text-to-SQL procedures and approaches, as well as an appraisal of the advantages and disadvantages of each methodology. In contrast with past studies, this paper describes the search and selection processes and provide an overview of the complete process for each approach under review before making comparisons. The authors also evaluated the performance of each methodology against a widely recognized benchmark dataset. Along with model performance, each model was compared and assessed based on its overall structure and associated processes, such as using pre-trained language models and intermediate representations. The results of this study show that the field of text-to-SQL semantic parsing has advanced significantly in recent years, as seen by the improved performance of the models under consideration. It was clear that most recent developments concentrated on the encoder side, even if each technique follows an encoder-decoder design. The imbalance opens up much room for decoder advancement in subsequent studies. Using pre-trained language models was also noteworthy for improving the models' performances; the authors will consider this for future efforts. The selection of intermediate representations, on the other hand, is wholly arbitrary.},
  keywords={Structured Query Language;Databases;Semantics;Natural languages;Syntactics;Benchmark testing;Decoding;text-to-SQL;natural language query;natural language processing;semantic parsing;NLIDB},
  doi={10.1109/ICAIIC57133.2023.10067134},
  ISSN={2831-6983},
  month={Feb},}@INPROCEEDINGS{11228279,
  author={Guo, Ziming and Ma, Chao and Sun, Yinggang and Zhao, Tiancheng and Wang, Guangyao and Huang, Hai},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={Evaluating and Enhancing LLMs for Multi-turn Text-to-SQL with Multiple Question Types}, 
  year={2025},
  volume={},
  number={},
  pages={1-10},
  abstract={Recent advancements in large language models (LLMs) have significantly improved text-to-SQL systems. However, most datasets and LLM-based methods tend to focus narrowly on SQL generation, often neglecting the complexities inherent in real-world conversational queries. This oversight can result in unreliable responses, particularly for ambiguous questions that cannot be directly addressed with SQL. To address this gap, we propose MMSQL, a comprehensive test suite designed to evaluate LLMs’ question classification and SQL generation capabilities by simulating real-world scenarios with diverse question types and multi-turn Q&A interactions. Utilizing MMSQL, we assessed the performance of popular LLMs, including both open-source and closed-source models, and identified key factors influencing their performance in these contexts. Furthermore, we introduce an LLM-based multi-agent framework that employs specialized agents to identify question types and determine appropriate answering strategies. Experimental results demonstrate that this method effectively enhances baseline models’ ability to handle diverse question types in conversational scenarios. Our approach simultaneously considers multiple question types and multi-turn interactions, providing a new, realistic perspective, and offering a valuable advancement toward more reliable and versatile text-to-SQL systems. Our dataset and code are publicly available at https://mcxiaoxiao.github.io/MMSQL.},
  keywords={Structured Query Language;Limiting;Navigation;Intent recognition;Large language models;Neural networks;Robustness;Complexity theory;Usability;Context modeling;Text-to-SQL;Dialogue Systems;Large Language Model;Intent Recognition;Multi-Agent},
  doi={10.1109/IJCNN64981.2025.11228279},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{11507944,
  author={Prakash, P. Arul and S, Shakthi and M P, Sri Santhiya and A V, Shreeja and S, Subash and C, Eyamini},
  booktitle={2026 International Conference on Smart Futuristic Technology}, 
  title={AI-Powered Transformer Framework for Intelligent Natural Language to SQL Query Generation}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={Natural language database interfaces frequently do not generate SQL that is structurally correct when the queries involve complex joins, nested queries, and queries that are ambiguous in terms of schema. The work introduces an AI-powered Transformer framework that supports bidirectional semantic encoding, schema linking, and constraint-aware SQL generation. The model uses a pre-trained T5-Large encoder as well as a relational schema graph made up of 5,752 table-column nodes and 14,986 relationship edges allowing for reasoning over explicit structure. The framework is evaluated on the Spider and WikiSQL benchmarks of 10,181 training queries, 1,034 development queries, and 15,878 natural-language questions. The experiments achieve 84.72% exact-match accuracy on Spider and 92.41% logical-form accuracy on WikiSQL, surpassing the prior best baselines by 6.18% and 4.35%, respectively. SQL generation times were average 1.83 seconds and were brought down to 0.97 seconds for real time deployment. These results confirm that transformer driven semantic parsing leads to improvements in correctness, generalization and execution fidelity in NL-to-SQL translation. These results indicate that the framework proposed yields a gain in exact-match accuracy, reliability of execution and efficiency in latency in all types of database scenarios.},
  keywords={Structured Query Language;Modeling;Databases;Accuracy;Printing;Natural languages;Decoding;Transformers;Timing;Equations;Natural-Language Interface;SQL Generation;Transformer Architecture;Semantic Parsing;Text-to-SQL},
  doi={10.1109/ICSFT66733.2026.11507944},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11335034,
  author={Ruskanda, Fariska Zakhralativa and Halim, Michael Jonathan},
  booktitle={2025 12th International Conference on Advanced Informatics: Concept, Theory and Application (ICAICTA)}, 
  title={Relevance Summarization for Example-Guided Text-to-SQL Generation in Complex Schema Database}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Recent progress in Large Language Models has pushed Text-to-SQL systems closer to enabling natural language queries over complex relational databases. Unfortunately, the models sometimes misread the provided examples, making mistakes in joins, aggregations, or predicates, issues that we label as misunderstanding knowledge evidence. To tackle this, we introduce relevance summarization, a simple prompting technique that adds brief, natural-language overviews to few-shot examples, clarifying the role of each schema element. Tests on the Academic dataset, which contains twenty-two tables, indicate that this approach lifts performance. The execution accuracy rose from a baseline 75% to 85% with relevance summaries in a 3-shot prompt setup, while the rate of semantic errors decreased dramatically between models, including GPT-4.1 Mini, Gemini 1.5 Pro, and Deepseek V3. The findings reveal that this method increases the correct query execution rates and decreases typical logical errors, confirming its value for Text-to-SQL in practical environments.},
  keywords={Accuracy;Large language models;Semantics;Natural languages;Relational databases;Informatics;Text-to-SQL;large language models;misunderstanding knowledge evidence;relevance summarization},
  doi={10.1109/ICAICTA67604.2025.11335034},
  ISSN={2996-2552},
  month={Sep.},}@INPROCEEDINGS{11227969,
  author={Ma, QiYun and Jiang, ShuMing and Wei, ZhiQiang and Zhao, Jing},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={CCS-SQL: Enhancing Text-to-SQL Framework for Computational Queries via Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={The Text-to-SQL task is to convert natural language queries into Structured Query Language (SQL) to achieve a natural language interface for database queries. The current research on Text-to-SQL primarily focuses on handling complex queries (such as nested queries and multi-table joins), while neglecting those that require complex computations. To address this issue, this paper constructs a Text-to-SQL dataset with a relatively high proportion of computational questions, termed as ESDS, and designs a Text-to-SQL framework based on large language models, named CCS-SQL, to enhance the parsing capability for computational questions. The three core modules of the framework are Schema Linking(SL), Query Classification and Prompting(QCP), and Consistency Calibration Optimization(CCO). SL is responsible for accurately matching the table column names and primary-foreign key relationships involved in the questions; the QCP classifies the questions and designs differentiated prompting strategies; the CCO verifies and optimizes the SQL statements generated by the large language model. Experiments conducted on the ESDS dataset, as well as public datasets, have demonstrated the effectiveness and generalizability of the CCS-SQL framework.},
  keywords={Structured Query Language;Accuracy;Databases;Large language models;Natural languages;Neural networks;Electrostatic discharges;Robustness;Calibration;Text-to-SQL;large language models;educational statistics;prompting strategies},
  doi={10.1109/IJCNN64981.2025.11227969},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{11354389,
  author={Ramya, D and Devi, N and Preetham Murthy, B and Saravana Kumar, B and Sarumathi, K M},
  booktitle={2025 5th International Conference on Mobile Networks and Wireless Communications (ICMNWC)}, 
  title={NL2Database: A Text-to-SQL Framework for Seamless Natural Language Interaction with Relational Databases}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={The complexity of Structured Query Language (SQL) often restricts non-technical users from efficiently accessing information stored in relational databases. To address this limitation, this paper presents NL2Database, an intelligent text-to-SQL system designed to enable seamless natural language interaction with relational databases. The proposed framework leverages natural language processing (NLP) techniques and deep learning models to accurately translate user queries expressed in natural language into executable SQL statements. NL2Database incorporates semantic parsing, query optimization, and database schema adaptation to enhance translation accuracy and scalability across diverse domains. Experimental evaluation on benchmark text-to-SQL datasets demonstrates that the system achieves high query translation accuracy while maintaining low execution latency. The results highlight the potential of NL2Database as an effective solution for bridging the gap between human language and database systems, thereby improving accessibility, usability, and decision-making in data-driven environments.},
  keywords={Wireless communication;Structured Query Language;Accuracy;Translation;Scalability;Semantics;Relational databases;Transformers;Natural language processing;Usability;text-to-SQL;natural language processing;relational databases;query translation;human-computer interaction;intelligent systems},
  doi={10.1109/ICMNWC66779.2025.11354389},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10705186,
  author={Vichev, Sergey and Marchev, Angel},
  booktitle={2024 IEEE 12th International Conference on Intelligent Systems (IS)}, 
  title={RAGSQL: Context Retrieval Evaluation on Augmenting Text-to-SQL Prompts}, 
  year={2024},
  volume={},
  number={},
  pages={1-6},
  abstract={Text-to-SQL area evolves rapidly in the era of large language models (LLMs) as organizations look for adapting the technology. A gained popularity method to improve LLM outputs is through giving relevant context about the database and organizational data as few-shot prompting. Recent research showcases that better results in text-to-SQL tasks can be achieved in a Retrieval Augmented Generation (RAG) setting by augmenting the prompt context in dynamic fashion during the LLM inference. In this paper we design such experiment by adapting data from BIRD benchmark, on more than 10 thousand examples and evaluate existing embedding models, both closed and open source, for such tasks reporting the comparison results. We then fine-tune an open-source sentence transformer model that outperforms the state-of-the-art (SOTA) embedding models on both question-to-evidence and question-to-SQL retrieval experiments.},
  keywords={Training;Adaptation models;Structured Query Language;Databases;Natural languages;Organizations;Benchmark testing;Transformers;Birds;Data models;text-to-sql;information retrieval;fine-tuning;sentence-transformers;Large Language Models},
  doi={10.1109/IS61756.2024.10705186},
  ISSN={2767-9802},
  month={Aug},}@INPROCEEDINGS{10554719,
  author={Song, Yewei and Ezzini, Saad and Tang, Xunzhu and Lothritz, Cedric and Klein, Jacques and Bissyandé, Tegawendé and Boytsov, Andrey and Ble, Ulrick and Goujon, Anne},
  booktitle={2024 IEEE/ACM 46th International Conference on Software Engineering: Software Engineering in Practice (ICSE-SEIP)}, 
  title={Enhancing Text-to-SQL Translation for Financial System Design}, 
  year={2024},
  volume={},
  number={},
  pages={252-262},
  abstract={Text-to-SQL, the task of translating natural language questions into SQL queries, is part of various business processes. Its automation, which is an emerging challenge, will empower software practitioners to seamlessly interact with relational databases using natural language, thereby bridging the gap between business needs and software capabilities. In this paper, we consider Large Language Models (LLMs), which have achieved state of the art for various NLP tasks. Specifically, we benchmark Text-to-SQL performance, the evaluation methodologies, as well as input optimization (e.g., prompting). In light of the empirical observations that we have made, we propose two novel metrics that were designed to adequately measure the similarity between SQL queries. Overall, we share with the community various findings, notably on how to select the right LLM on Text-to-SQL tasks. We further demonstrate that a tree-based edit distance constitutes a reliable metric for assessing the similarity between generated SQL queries and the oracle for benchmarking Text2SQL approaches. This metric is important as it relieves researchers from the need to perform computationally expensive experiments such as executing generated queries as done in prior works. Our work implements financial domain use cases and, therefore contributes to the advancement of Text2SQL systems and their practical adoption in this domain.},
  keywords={Measurement;Structured Query Language;Natural languages;Training data;Standardization;Benchmark testing;Software;Text-to-SQL;Large Language Models;Evaluation Metrics;Natural Language Processing},
  doi={10.1145/3639477.3639732},
  ISSN={2832-7659},
  month={April},}@INPROCEEDINGS{11102354,
  author={Huang, Zheyuan and Ma, Shuaisen and Wang, Hongxia and Zheng, Zilong and Yu, Jiahui and Xia, Yifan},
  booktitle={2025 6th International Conference on Computer Engineering and Application (ICCEA)}, 
  title={Evaluating Fine-Tuned LLMs with RAG and Text2SQL for the Water Conservancy Domain}, 
  year={2025},
  volume={},
  number={},
  pages={1331-1334},
  abstract={This study presents WaterQA, an intelligent question-answering platform addressing challenges in water resource management using Large Language Models (LLMs) and Retrieval-Augmented Generation (RAG). By integrating RAG for accurate information retrieval from a dynamic knowledge hub and employing fine-tuned Text2SQL for querying real-time water level databases, the system enhances decision support. Supervised fine-tuning of the model demonstrated superior performance on complex, domain-specific tasks compared to other models. WaterQA, also incorporating water level prediction, offers a practical and accurate solution, advancing smart water conservancy through enhanced data accessibility and analysis.},
  keywords={Accuracy;Databases;Semantics;Retrieval augmented generation;Water conservation;Predictive models;Information retrieval;Real-time systems;Water resources;Standards;LLM;RAG;Text2SQL;Fine-tuning;Q&A;Water Level Prediction;Semantic Parsing},
  doi={10.1109/ICCEA65460.2025.11102354},
  ISSN={2159-1288},
  month={April},}@INPROCEEDINGS{11504381,
  author={Wang, Yao and Lv, Huiyong and Qian, Yurong},
  booktitle={2026 9th International Conference on Advanced Electronic Technology, Computers and Software Engineering (AETCSE)}, 
  title={Multi-Agent NL2SQL: An Adaptive S-N-M Framework for Chinese Text-to-SQL with Weighted Selection}, 
  year={2026},
  volume={},
  number={},
  pages={952-960},
  abstract={Text-to-SQL systems face significant challenges when processing diverse and complex Chinese natural language queries. Existing large language model (LLM)-based methods suffer from limitations in computational resource allocation and query diversity handling. We propose Multi-Agent NL2SQL, a Chinese Text-to-SQL system built on an S-N-M adaptive framework. Our approach introduces two key innovations: (1) a dynamic weighted selection mechanism that uses category probability distributions from the S-N-M classifier to adjust weights of three specialized processing modules, enabling intelligent selection based on both category probabilities and SQL quality; (2) an error feedforward correction strategy that addresses Chinese semantic ambiguity through error type-based correction, significantly improving system robustness. On Chase and CSpider benchmarks, our system achieves Execution Accuracy (EA) of 53.1% and 63.1%, outperforming DIN-SQL by 7.3 and 11.0 percentage points respectively (p < 0.01). Processing speed improves by 39.3% and throughput by 63.2%, demonstrating a scalable and efficient solution for production deployment.},
  keywords={Modules (abstract algebra);Structured Query Language;Modeling;Information rates;Throughput;Accuracy;Probability;Equations;Arrays;Timing;Chinese Text-to-SQL;S-N-M adaptive framework;weighted selection;error feedforward;dynamic weight adjustment},
  doi={10.1109/AETCSE69203.2026.11504381},
  ISSN={},
  month={March},}@INPROCEEDINGS{11227320,
  author={Parab, Ganesh and Ahmad, Zishan and Birru, Dagnachew},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={HI-SQL: Optimizing Text-to-SQL Systems through Dynamic Hint Integration}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Text-to-SQL generation bridges the gap between natural language and databases, enabling users to query data without requiring SQL expertise. While large language models (LLMs) have significantly advanced the field, challenges remain in handling complex queries that involve multi-table joins, nested conditions, and intricate operations. Existing methods often rely on multi-step pipelines that incur high computational costs, increase latency, and are prone to error propagation. To address these limitations, we propose HI-SQL, a pipeline that incorporates a novel hint generation mechanism utilizing historical query logs to guide SQL generation. By analyzing prior queries, our method generates contextual hints that focus on handling the complexities of multi-table and nested operations. These hints are seamlessly integrated into the SQL generation process, eliminating the need for costly multi-step approaches and reducing reliance on human-crafted prompts. Experimental evaluations on multiple benchmark datasets demonstrate that our approach significantly improves query accuracy of LLM-generated queries while ensuring efficiency in terms of LLM calls and latency, offering a robust and practical solution for enhancing Text-to-SQL systems.},
  keywords={Structured Query Language;Accuracy;Databases;Large language models;Pipelines;Natural languages;Semantics;Benchmark testing;Computational efficiency;Complexity theory;Large Language Models;Natural Language to SQL;Agents},
  doi={10.1109/IJCNN64981.2025.11227320},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{11427190,
  author={Liu, Ye and Yang, Yufei and Zhu, Taipeng and Liang, Yingwei and Chen, Yue and Yan, Liang},
  booktitle={2025 IEEE 7th International Conference on Artificial Intelligence, Computer Science, and Information Processing (AICSIP)}, 
  title={EPSP-SQL: Enhancing Text-To-SQL by Explicit Prompt-Based Self-Play Fine-Tuning}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Self-Play Fine-Tuning (SPIN) has attracted significant attention in recent years, as it enables large language models (LLMs) to iteratively improve their performance through simulated self-interactions, effectively transforming a weaker model into a stronger one. However, applying SPIN to text-to-SQL tasks remains challenging, primarily due to the model's limited ability to capture implicit schema relationships among database tables during training. To address this limitation, we propose a novel SPIN-based finetuning framework tailored for text-to-SQL tasks, termed EPSP-SQL. Our approach leverages in-context learning to construct explicit prompts that highlight the relationships between database schemas, thereby guiding the model to better understand table interactions during self-play. Experimental results on the Spider dataset demonstrate that EPSP-SQL significantly outperforms existing state-of-the-art methods, achieving superior performance in execution accuracy.},
  keywords={Training;Computer science;Structured Query Language;Accuracy;Databases;Large language models;Natural languages;Information processing;Feature extraction;Solids;LLM;Text-to-SQL;Self-Play},
  doi={10.1109/AICSIP65423.2025.11427190},
  ISSN={},
  month={July},}@INPROCEEDINGS{10487773,
  author={Huynh, Y Thien and Nguyen, Nhat Viet and Cao, Nhan Thi},
  booktitle={2023 IEEE Asia-Pacific Conference on Computer Science and Data Engineering (CSDE)}, 
  title={Investigating Pretrained Language Models and Learning Methods for Vietnamese Text-to-SQL}, 
  year={2023},
  volume={},
  number={},
  pages={1-6},
  abstract={Text-to-SQL is one of the most challenging tasks in Natural language processing (NLP), which automatically constructs an executable Structured query language (SQL) query from a given database schema and natural utterances. Current datasets like Spider bring more challenges for the NLP community by considering the domain shift among databases, especially in low-resource languages such as Vietnamese. One of the main current approaches is finetuning pretrained language models (PLMs), which leverages the language knowledge encoded in PLMs to adapt to a new specific task. In this paper, we investigate both the effects of different PLMs, including monolingual and multilingual PLMs, and the impacts of learning methods on the Vietnamese Text-to-SQL task. We also proposed a simple but effective learning approach to address the domain shift problem in the Vietnamese Spider dataset. The experimental results show that our method gives competitive results compared to other strong baselines.},
  keywords={Learning systems;Training;Structured Query Language;Analytical models;Risk minimization;Databases;Feature extraction;Text-to-SQL;Meta-learning;Vietnamese Text-to-SQL;Domain shift;Domain Generalization;Quantile Risk Minimization},
  doi={10.1109/CSDE59766.2023.10487773},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11198017,
  author={Zhan, Guosong and Shi, Ge and Liu, Xiaoguo and Wang, Nan},
  booktitle={2025 21st International Conference on Natural Computation, Fuzzy Systems and Knowledge Discovery (ICNC-FSKD)}, 
  title={Natural Language to SQL Using Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={495-502},
  abstract={This survey provides a comprehensive overview of the transformative impact of Large Language Models (LLMs) on the field of NL2SQL. NL2SQL(aka Text2SQL), the task of converting natural language questions into executable SQL queries, is crucial for democratizing data access, bridging the gap between human language and structured database querying statement. A significant paradigm shift has occurred in this field, redirecting the focus from rule-based method or training models from scratch to adapting pretrained large language models, which has considerably advanced NL2SQL capabilities. The advancements driven by LLMs have not only enhanced accuracy but have also fundamentally altered research methodologies in NL2SQL, transitioning from a focus on model architecture innovation to an emphasis on prompt engineering and data-centric strategies. The core contributions of this survey include a novel taxonomy of LLM-based NL2SQL methods, an in-depth analysis of trends in schema representation, prompt engineering strategies and fine-tuning techniques. Furthermore, this work presents a critical review of benchmark datasets (e.g., Spider, BIRD, SParC) and evaluation methodologies (e.g., Exact Match, Execution Accuracy). Finally, key unresolved challenges, such as handling large schemas, ensuring faithfulness, enabling reasoning over data content, and improving scalability, are identified, alongside promising future research directions poised to shape the next generation of NL2SQL systems.},
  keywords={Surveys;Training;Structured Query Language;Accuracy;Large language models;Natural languages;Benchmark testing;Birds;Cognition;Prompt engineering},
  doi={10.1109/ICNC-FSKD67701.2025.11198017},
  ISSN={},
  month={July},}@INPROCEEDINGS{11065889,
  author={Zhang, Tianrong and Liu, Yulong},
  booktitle={2025 IEEE 7th International Conference on Communications, Information System and Computer Engineering (CISCE)}, 
  title={Graph-Fusion RESDSQL: Enhancing NL2SQL Robustness with Dynamic Schema Linking and Contextual Integration}, 
  year={2025},
  volume={},
  number={},
  pages={221-225},
  abstract={In this paper, we tackle the Natural Language to SQL (NL2SQL) task, which aims to convert user queries in natural language into executable SQL statements, enabling non-professionals to easily access database information without needing programming skills. We propose a new model that builds upon the RESDSQL framework by incorporating graph encoding strategies and a fusion layer. The graph encoding dynamically models tables, columns, and questions using multi-layer graph attention, enhancing the schema linking component of RESDSQL. Additionally, the fusion layer interconnects contextual information between skeleton parsing and schema linking, facilitating information sharing and mutual influence. This approach improves robustness when generating complex SQL statements. Experimental results on the Spider dataset demonstrate that our model outperforms RESDSQL, achieving significant improvements in both Execution Accuracy (EX) and Exact-Match Accuracy (EM), particularly when dealing with complex multi-table joins and nested SQL statements. Our contributions lie in integrating graph structure encoding and self-attention mechanisms into the NL2SQL process, thereby enhancing the model's ability to capture relationships between database entities and natural language queries.},
  keywords={Structured Query Language;Accuracy;Databases;Computational modeling;Natural languages;Encoding;Skeleton;Robustness;Decoding;Joining processes;NL2SQL;Transformer;self-attention;RESDSQL},
  doi={10.1109/CISCE65916.2025.11065889},
  ISSN={2833-2423},
  month={May},}@INPROCEEDINGS{11182085,
  author={Zhu, Jingxin and Tang, Chanjuan and Qiu, Guozhan and Lin, Riqi and Tian, Bingxin and Ren, Jiuchun},
  booktitle={2025 7th International Conference on Next Generation Data-driven Networks (NGDN)}, 
  title={Power Communication Planning Data Query System Based on the NL2SQL Framework}, 
  year={2025},
  volume={},
  number={},
  pages={78-86},
  abstract={With the explosive growth of data volume and the complication of business requirements in the field of power communication planning, efficient data acquisition and analysis have become key challenges in the industry. This paper proposes a power communication planning data query system that integrates a domain-knowledge-enhanced NL2SQL framework. The system achieves accurate conversion from natural language to SQL through the Qwen2.5-7B-Instruct large language model and designs a closed-loop interaction mode of "natural language → SQL → natural language response". The system architecture covers the user interaction layer, large model processing layer, data storage layer, and result generation layer, innovatively introducing domain knowledge prompt templates, intelligent SQL execution and error handling mechanisms, and multi-level cache optimization strategies. Experimental results show that the Elec-TS model (for text-to-SQL) proposed in this paper achieves an accuracy rate of 91.40%, a recall rate of 100%, and an F1 value of 95.51% on a professional dataset of 1,000 entries. The business fit of the PC-RG model (for result generation) reaches 4.7/5, significantly improving data query efficiency and user experience in power communication planning scenarios and providing a new technical path for industry digital transformation.},
  keywords={Industries;Structured Query Language;Accuracy;Natural languages;Systems architecture;Data models;User experience;Planning;Optimization;Business;Power communication planning;Natural Language to SQL;Question - answering system;Data query},
  doi={10.1109/NGDN66208.2025.11182085},
  ISSN={},
  month={June},}@INPROCEEDINGS{10394829,
  author={Anbarasi, A. and Jagadeesan, S and Nithyasree, K. C.},
  booktitle={2023 International Conference on System, Computation, Automation and Networking (ICSCAN)}, 
  title={Converting Structured Forms to Storable Databases using Form2DB}, 
  year={2023},
  volume={},
  number={},
  pages={1-4},
  abstract={Document understanding is a set of related tasks involving understanding of semantic syntactic as well as visual structure of document images. Form understanding is a subset of document understanding, which specifically deals with semantic entity relationship between elements in a form, with no prior information on form template. There are multiple models that have been developed to solve this task, however they tend to be languagespecific and rely heavily on OCR/HWR for functioning. Thus, we create a pipeline for converting form images into relational database (like SQL) data entries. We further try to implement the training process in a language-agnostic fashion. The questionanswer pairs are extracted from forms and passed to LLM, which can handle complex text-to-SQL conversion queries. We compare the performance of various modules in a qualitative manner, analysing the different errors and issues arising. We also use existing benchmarks to compare the performances of various models.},
  keywords={Training;Visualization;Structured Query Language;Semantics;Pipelines;Optical character recognition;Switches;Form understanding;Large Language model;Optical character recognition;text-to-SQL},
  doi={10.1109/ICSCAN58655.2023.10394829},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10982609,
  author={Yalova, Kateryna and Zhuravel, Andrii},
  booktitle={2024 IEEE 19th International Conference on Computer Science and Information Technologies (CSIT)}, 
  title={Transformer-Based Model for the Natural Language Textual Sequences to SQL-Queries Conversion}, 
  year={2024},
  volume={},
  number={},
  pages={1-4},
  abstract={The concept of using natural language instead of SQL queries formed the basis of a new type of data processing called Natural Language Interface to Database (NLIDB). This paper considers a neural network (NN) approach for the NLIDB systems development. Its essence is the transformation of the input text sequence specified by the user in natural language into commands in SQL, which is inherent in text-to-SQL and sequence-to-sequence tasks. The Transformer model architecture of the NN was justified in the research. This architecture allows the NN to convert an input sequence (such as a natural language text query) into an output sequence (translated into SQL format text query). WikiSQL dataset was used for NN learning and testing. Numerous experiments were conducted in order to determine the optimal parameters of the NN model were conducted. Bilingual Evaluation Understanding (BLEU) metric was used as a metric for evaluating the quality of converting an input text sequence to SQL queries. The BLEU metric for the neural network model trained on the WikiSQL sample is 56%.},
  keywords={Measurement;Structured Query Language;Accuracy;Translation;Computational modeling;Artificial neural networks;Computer architecture;Transformers;Vectors;Machine translation;natural language interface to database;text-to SQL;transformer neural network},
  doi={10.1109/CSIT65290.2024.10982609},
  ISSN={2766-3639},
  month={Oct},}@INPROCEEDINGS{11307842,
  author={Karthikeya, Kommuru and Pakala, Vishal Reddy and Sona, Deepika Rani and Das, Rashmi Ranjan},
  booktitle={2025 Innovations in Power and Advanced Computing Technologies (i-PACT)}, 
  title={Natural Language to SQL Framework: A Streamlit-based Interface for Non-Technical Users}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={The objective of this paper is to develop an AIpowered system for translating natural language into SQL queries, intended to streamline database interactions for nontechnical users. The proposed system generates executable SQL statements from user inputs by leveraging the Gemini API, which naturally facilitates retrieval augmented generation. A Streamlit-based interface enables users to upload structured Excel datasets and execute Create, Read, Update and Delete (CRUD) operations using conversational commands. The process encompasses schema parsing, sample data extraction, and prompt engineering to ease query generation. When analyzed using a student information dataset, the system attained a query generation accuracy of 92% and an execution success rate of 90 %. Use case scenarios such as data insertion, filtering, updating, and deletion illustrate the effectiveness of the model in understanding the user intent. Despite its dependable functioning, issues such as response latency and sporadic misreading of natural language inquiries persist. This study illustrates the practical capabilities of large language models, like Gemini, in connecting natural language with structured data access, thus improving database interactions.},
  keywords={Structured Query Language;Technological innovation;Translation;Databases;Filtering;Large language models;Retrieval augmented generation;Data models;Prompt engineering;Data mining;Natural Language to SQL;Large Language Models;SQL Query Translation;Database Interaction},
  doi={10.1109/i-PACT65952.2025.11307842},
  ISSN={},
  month={Sep.},}@ARTICLE{11418908,
  author={Hoang, Mia and Madisetti, Vijay K.},
  journal={IEEE Access}, 
  title={To RAG or Not to RAG, That Is the Question: Effective Text-to-SQL Generation Under Ambiguity}, 
  year={2026},
  volume={14},
  number={},
  pages={35440-35458},
  abstract={Natural language interfaces to databases promise to democratize data access, yet current text-to-SQL systems fail to address a fundamental challenge: user questions are often ambiguous. Existing benchmarks and frameworks either ignore ambiguity entirely or require extensive training data and domain expertise during inference, limiting their practical deployment. We present two contributions to address this gap. First, we introduce Ambrosia+, a comprehensive benchmark that extends Ambrosia with 2535 unanswerable questions, creating a total of 6777 examples spanning linguistic ambiguity (scope, attachment, vagueness) and unanswerability across 16 domains and multi-table databases. Second, we propose Shakespeare-SQL, an efficient modular framework that integrates adaptive question routing, hybrid retrieval combining structural and semantic similarity, and curriculum-based Group Relative Policy Optimization (GRPO) with AI feedback for interpretation generation. Our framework achieves 72.6% full coverage on the schema-ambiguous AmbiQT benchmark using only 300 training examples—a 36.5% relative improvement over the state-of-the-art DFPL (53.2%). On Ambrosia+, Shakespeare-SQL achieves 73.0% full coverage compared to DFPL’s 30.5%, while generating 89% fewer SQL queries. On unambiguous benchmarks, our framework maintains satisfactory performance: 86.7% execution accuracy on SPIDER and 56.8% on BIRD. This work demonstrates that a strategic training methodology outweighs dataset size in ambiguity resolution, enabling production deployment without extensive and costly fine-tuning.},
  keywords={Benchmark testing;Databases;Retrieval augmented generation;Structured Query Language;Pipelines;Business;Training;Toy manufacturing industry;Large language models;Electronic mail;Text-to-SQL;natural language interfaces;query ambiguity resolution;retrieval-augmented generation;curriculum learning;group relative policy optimization;unanswerability detection;large language models;agentic AI;database management},
  doi={10.1109/ACCESS.2026.3670064},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11406408,
  author={Cheng, Jinrui and Huang, Shuai and Zhao, Kang},
  booktitle={2025 5th International Conference on Communication Technology and Information Technology (ICCTIT)}, 
  title={GTR-SQL: Graph Pruning, Tournament Selection, and Taxonomy Repair for Text-to-SQL}, 
  year={2025},
  volume={},
  number={},
  pages={185-189},
  abstract={Deploying Text-to-SQL in resource-constrained enterprise environments presents a dichotomy: proprietary Large Language Models (LLMs) pose privacy and cost concerns, while smaller open-source models often lack the reasoning depth for complex queries. To address this, we introduce GTR-SQL, a lightweight, training-free multi-agent framework designed to empower smaller models (e.g., 7B parameters) via orchestrated inference-time scaling. GTR-SQL targets specific failure modes through three components: (1) Graph-connected schema linking, which uses Steiner Tree approximation to guarantee topological connectivity for multi-hop joins; (2) Tournament-based selection, employing an execution-aware judge to filter subtle logical flaws; and (3) Repair-guided correction, utilizing a fine-grained error taxonomy to drive dual-path repairs rather than blind retries. Evaluations on the Spider and CSpider development sets (N=1034) demonstrate that GTR-SQL significantly augments the reasoning capabilities of lightweight models. Without fine-tuning, the framework delivers substantial gains in Execution Accuracy over direct prompting (+13.35% on Spider, +13.74% on CSpider) and maintains a Valid SQL rate exceeding 99%, proving its robustness for real-world applications.},
  keywords={Steiner trees;Structured Query Language;Privacy;Large language models;Taxonomy;Spread spectrum communication;Maintenance engineering;Cognition;Robustness;Multi-agent systems;Text-to-SQL;Inference-Time Scaling;Graph Steiner Tree;Self-Correction;Multi-Agent Systems},
  doi={10.1109/ICCTIT68197.2025.11406408},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11558631,
  author={Bian, Yiyang and Magdy, Amr},
  booktitle={2026 IEEE 42nd International Conference on Data Engineering Workshops (ICDEW)}, 
  title={CityChat: Template-Guided Text-to-SQL over City-Scale Spatial Data}, 
  year={2026},
  volume={},
  number={},
  pages={222-230},
  abstract={Urban spatial question answering requires translating everyday questions about places, distances, and regions into executable queries over spatial databases. We formulate this task as natural-language to geospatial structured query translation (NL2GeoSQL). In this work, we present CityChat, an LLM-driven NL2GeoSQL framework for urban spatial question answering. CityChat improves reliability by combining schema-aware prompting with template-guided generation that constrains outputs to valid query shapes, and by using execution feedback to repair hard database errors. We evaluate CityChat on a multiple-city Southern California PostGIS workload across multiple LLM backbones. Results show that CityChat substantially increases executability and error recovery, and remains effective even for lightweight local models, offering a practical path toward reliable natural-language spatial querying at the urban scale.},
  keywords={Modeling;Maintenance engineering;Large language models;Structured Query Language;Skeleton;Databases;Generative Pre-trained transformer;Urban areas;Natural languages;Printing;Natural language interfaces;NL2GeoSQL;Urban geospatial data;spatial question answering;Large language models (LLMs)},
  doi={10.1109/ICDEW71238.2026.00028},
  ISSN={2473-3490},
  month={May},}@INPROCEEDINGS{10779814,
  author={Zhao, Xinke and Yilahun, Hankiz and Hamdulla, Askar},
  booktitle={2024 IEEE 5th International Conference on Pattern Recognition and Machine Learning (PRML)}, 
  title={Text-to-CQL Based on Large Language Model and Graph Pattern Enhancement}, 
  year={2024},
  volume={},
  number={},
  pages={114-119},
  abstract={With the wide application of knowledge graphs in various scenarios and Neo4j graph databases becoming excellent knowledge graph carriers, Cypher (CQL for short) has become the most popular graph database query language. However, when performing graph database retrieval, the complex pattern and syntax make constructing CQL statements a complicated and time-consuming task. Therefore, similar to Text-to-SQL, it is necessary and urgent to study an effective method for end-to-end transformation of natural languages into CQL. There have been many advances in Text-to-SQL for traditional relational databases, but these methods cannot be well applied to Text-to-CQL, so there is still a lack of effective work on Text-to-CQL for graph databases. In recent years, as large language models have been widely applied to different tasks with good results, and considering that the fundamental difference between CQL and SQL is the representation of graph patterns. We propose in this paper PA-LLM, a Text-to-CQL method that utilizes large language models combined with graph patterns enhancement, which combines large language models and subdivides the graph patterns into three categories according to their respective characteristics. They are simple query patterns, multi-hop query patterns, and function query patterns. For different graph patterns, the method optimizes the process of generating CQL for the model, which can be subdivided into four sub-methods, simple pattern enhancement method, multi-hop pattern enhancement method, function pattern enhancement method, and entity-relationship enhancement method. The experimental results show that the method improves the quality of the CQL statements generated by the model, including the logical accuracy ACCLX and the execution result accuracy ACCEX, and achieves better results on the SpCQL dataset proposed by the National Defense University of Science and Technology (NDUST). It provides an effective solution for the task of converting CQL to natural language end-to-end.},
  keywords={Structured Query Language;Accuracy;Quantization (signal);Large language models;Natural languages;Knowledge graphs;Relational databases;Syntactics;Real-time systems;Pattern recognition;Knowledge graph;Neo4j;Text-to-CQL;ChatGLM;Graph patterns enhancement},
  doi={10.1109/PRML62565.2024.10779814},
  ISSN={},
  month={July},}@INPROCEEDINGS{11228968,
  author={Hao, Zhifeng and Cai, Yuyuan and Shi, Shaobin and Xu, Boyan and Cai, Ruichu},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={PEFT Innovations in Text-to-SQL: Adapter and Prefix Tuning Methods with Structural Awareness}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={The goal of the Cross-domain Text-to-SQL task is to accurately translate natural language questions into executable SQL queries, even when applied to previously unseen databases. Recently, full fine-tuning of pretrained T5 models has achieved remarkable results. However, as the model size increases, this paradigm incurs significant computational costs. In this paper, we explore the effectiveness of existing parameter-efficient fine-tuning (PEFT) methods for training the T5 model on the Text-to-SQL task. Recognizing the limitations of PEFT methods in structure learning, we propose two structure-aware variants for Adapter and Prefix tuning methods, integrating a relational graph neural network within their architectures. We conducted extensive experiments to demonstrate the effectiveness of our proposed structure-aware adapter and structure-aware prefix tuning methods, which achieve performance comparable to the state-of-the-art T5-3B model while requiring only about 5.43% of the training parameters needed.},
  keywords={Training;Adaptation models;Technological innovation;Structured Query Language;Translation;Databases;Computational modeling;Computer architecture;Graph neural networks;Tuning;component;formatting;style;styling;insert},
  doi={10.1109/IJCNN64981.2025.11228968},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{10327960,
  author={Cheng, Guang-Yu and Yu, Shuo and Jiang, Wen-Bin and Ma, Shuai and Ao, Xiang and He, Qing},
  booktitle={2023 International Conference on Machine Learning and Cybernetics (ICMLC)}, 
  title={Lifting the Answer: Reranking Candidates on Data Augmented Text-to-SQL}, 
  year={2023},
  volume={},
  number={},
  pages={303-309},
  abstract={The text-to-SQL task is a realistic and challenging job, which aims to translate natural language questions into corresponding SQL queries. When attempting to generate SQL queries in the text-to-SQL task, prevailing semantic parsing models employ beam search to generate several candidates. Based on our pilot study, we observe that the gold-standard SQL answer may exist in the n-best candidate list produced by the decoder, rather than the first. Hence, we aim to lift the correct answer given several candidates generated by semantic parsing models for text-to-SQL. To this end, we propose a reranking module that reorders the n-best list of candidate SQL queries by pair-wise hinge loss. Meanwhile, a data augmentation module is leveraged to enrich the inadequate training instances for providing candidates with better qualities. These two modules can be easily grafted onto text-to-SQL backbone networks, and extensive experiments on the cross-domain text-to-SQL benchmark Spider demonstrate that our method achieves 73.8% in accuracy on the Spider dataset, surpassing the base model by up to 3.5%.},
  keywords={Training;Structured Query Language;Semantics;Natural languages;Machine learning;Benchmark testing;Predictive models;Text-to-SQL;Reranking candidates;Data augmentation},
  doi={10.1109/ICMLC58545.2023.10327960},
  ISSN={2160-1348},
  month={July},}@INPROCEEDINGS{10661162,
  author={Yang, Hao and Yang, Zhaoyong and Zhao, Ruyang and Li, Xiaoran and Rao, Gaoqi},
  booktitle={2024 International Conference on Asian Language Processing (IALP)}, 
  title={The implementation solution for automatic visualization of tabular data in relational databases based on large language models}, 
  year={2024},
  volume={},
  number={},
  pages={175-180},
  abstract={In the data analysis process, visualized data can help users gain better insights. To make it easier and faster for users to obtain visual charts from data, natural language interfaces for data visualization have emerged. Users only need to provide the visualization model with the data to be visualized and a description of their visualization needs, and the model will return a visual chart(NL2VIS). In real-world scenarios, most data is stored in relational databases. To visualize this data, it is first necessary to generate a structured query statements based on the user’s visualization requirements(NL2SQL), and then proceed with the subsequent visualization operations. This study breaks down the task of automatic visualization of tabular data in relational databases into three main steps: generating SQL, determining the chart type, and mapping data to visual channels. We utilize the Chain-of-Thought(CoT) technique of generative large language models to address the task of automatic visualization of tabular data. Finally, we evaluated our approach on the nvBench dataset, and the results show that CoT-based automatic visualization of tabular data performs well.},
  keywords={Visualization;Structured Query Language;Accuracy;Data analysis;Large language models;Natural languages;Data visualization;NL2VIS;NL2SQL;Chain-of-Thought;Large Language Model},
  doi={10.1109/IALP63756.2024.10661162},
  ISSN={2159-1970},
  month={Aug},}@INPROCEEDINGS{10629374,
  author={Zhu, Jerry and Bazaz, Saad Ahmed and Dutta, Srimonti and Anuraag, Bhavaraju and Haider, Imran and Bandopadhyay, Srijita},
  booktitle={2023 4th International Conference on Data Analytics for Business and Industry (ICDABI)}, 
  title={Talk to your data: Enhancing Business Intelligence and Inventory Management with LLM-Driven Semantic Parsing and Text-to-SQL for Database Querying}, 
  year={2023},
  volume={},
  number={},
  pages={321-325},
  abstract={This paper delves into the potential of Large Language Models (LLMs) in revolutionizing business intelligence and inventory management through semantic parsing and text-to-SQL methodologies. It assesses various LLM models, such as DIN-SQL, DSP, NSQL, GPT, CoPilot, and LLaMa, elucidating their capabilities and contributions. Two critical analyses are presented here. The first compares cutting-edge LLM models using cosine similarity and cost efficiency metrics. The second analysis enhances GPT’s precision through prompt engineerings, like few-shot techniques, and explores frameworks like DIN-SQL, NSQL, and DSP. DIN-SQL substantially boosts accuracy, and NSQL demonstrates potential in specific scenarios. This research underscores the transformative potential of LLM-driven models in business intelligence and inventory management. DIN-SQL, in particular, emerges as a game-changer with the potential to reshape inventory management practices. GPT showcases its versatility through fine-tuning for tasks beyond conventional programming, while CoPilot offers a cost-effective alternative. This study emphasizes the importance of cost-effectiveness in real-world applications, with LLaMa and CoPilot being practical choices. NSQL, with its budget-friendly and semi-accurate solution, holds promise for semantic parsing in growing companies. These insights are a foundation for further innovation, promising unmatched efficiency and competitiveness across industries in the evolving Artificial intelligence landscape.},
  keywords={Industries;Structured Query Language;Technological innovation;Costs;Large language models;Semantics;Inventory management;Semantic parsing;Text to SQL;Structured Query Language;Large Language Models;Natural Language Processing;Business Intelligence},
  doi={10.1109/ICDABI60145.2023.10629374},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{10066976,
  author={Borjal, Christalline Joie and Visperas, Moses and Adoptante, Aunhel John and Abia, Ma. Teresita and Catapang, Jasper Kyle and Peramo, Elmer},
  booktitle={2023 International Conference on Artificial Intelligence in Information and Communication (ICAIIC)}, 
  title={Parallel Corpus Curation for Filipino Text-to-SQL Semantic Parsing}, 
  year={2023},
  volume={},
  number={},
  pages={163-169},
  abstract={Text-to-SQL models were developed over the years to allow non-technical users to interact with relational databases. Deep learning approaches require large amounts of labeled data, but the majority of the available datasets used today for natural language processing task are in English. These make text-to-SQL semantic parsing in Filipino a promising yet challenging endeavor. This research presents the iTanong corpus-a hand-labeled parallel semantic parsing corpus for Filipino Text-to-SQL tasks. The frequent code-switching or the practice of alternating between two or more languages or varieties of language in conversation and written text poses another challenge in semantic parsing for the Filipino language. The iTanong corpus contains 16,113 Filipino question and SQL pairs from two institutional databases sourced from students and employees and curated by the research team. The researchers employed Part-of-Speech tagging to guide the annotation process and analyze the various structure of the natural language queries. The usability of the corpus is tested with GPT-3 with 1,150 question-SQL pairs and achieved an execution and exact-match accuracy of 87.4% and 89.8%, respectively.},
  keywords={Deep learning;Structured Query Language;Annotations;Semantics;Relational databases;Oral communication;Tagging;relational databases;deep learning;semantic parsing;code-switching;Part-of-Speech Tagging;GPT-3},
  doi={10.1109/ICAIIC57133.2023.10066976},
  ISSN={2831-6983},
  month={Feb},}@INPROCEEDINGS{10355492,
  author={Aadhil Rushdy, M.R. and Thayasivam, Uthayasanker},
  booktitle={2023 Moratuwa Engineering Research Conference (MERCon)}, 
  title={Application of Noise Filter Mechanism for T5-Based Text-to-SQL Generation}, 
  year={2023},
  volume={},
  number={},
  pages={95-100},
  abstract={The objective of the text-to-SQL task is to convert natural language queries into SQL queries However, the presence of extensive text-to-SQL datasets across multiple domains, such as Spider, introduces the challenge of effectively generalizing to unseen data. Existing semantic parsing models have struggled to achieve notable performance improvements on these cross-domain datasets. As a result, recent advancements have focused on leveraging pre-trained language models to address this issue and enhance performance in text-to-SQL tasks. These approaches represent the latest and most promising attempts to tackle the challenges associated with generalization and performance improvement in this field. This paper proposes an approach to evaluate and use the Seq2Seq model providing the encoder with the most pertinent schema items as the input and to generate accurate and valid cross-domain SQL queries using the decoder by understanding the skeleton of the target SQL query. The proposed approach is evaluated using Spider dataset which is a well-known dataset for text-to-sql task and able to get promising results where the Exact Match accuracy and Execution accuracy has been boosted to 72.7% and 80.2% respectively compared to other best related approaches.},
  keywords={Structured Query Language;Matched filters;Filtering;Semantics;Natural languages;Skeleton;Decoding;Text-to-SQL;Seq2Seq model;BERT;RoBERTa;T5-Base},
  doi={10.1109/MERCon60487.2023.10355492},
  ISSN={2691-364X},
  month={Nov},}@ARTICLE{10530359,
  author={Zhang, Weixu and Wang, Yifei and Song, Yuanfeng and Wei, Victor Junqiu and Tian, Yuxing and Qi, Yiyan and Chan, Jonathan H. and Wong, Raymond Chi-Wing and Yang, Haiqin},
  journal={IEEE Transactions on Knowledge and Data Engineering}, 
  title={Natural Language Interfaces for Tabular Data Querying and Visualization: A Survey}, 
  year={2024},
  volume={36},
  number={11},
  pages={6699-6718},
  abstract={The emergence of natural language processing has revolutionized the way users interact with tabular data, enabling a shift from traditional query languages and manual plotting to more intuitive, language-based interfaces. The rise of large language models (LLMs) such as ChatGPT and its successors has further advanced this field, opening new avenues for natural language processing techniques. This survey presents a comprehensive overview of natural language interfaces for tabular data querying and visualization, which allow users to interact with data using natural language queries. We introduce the fundamental concepts and techniques underlying these interfaces with a particular emphasis on semantic parsing, the key technology facilitating the translation from natural language to SQL queries or data visualization commands. We then delve into the recent advancements in Text-to-SQL and Text-to-Vis problems from the perspectives of datasets, methodologies, metrics, and system designs. This includes a deep dive into the influence of LLMs, highlighting their strengths, limitations, and potential for future improvements. Through this survey, we aim to provide a roadmap for researchers and practitioners interested in developing and applying natural language interfaces for data interaction in the era of large language models.},
  keywords={Data visualization;Structured Query Language;Task analysis;Semantics;Electronic mail;Surveys;Databases;Large language models;natural language interface;semantic parsing;text -to-SQL;text-to-visualization},
  doi={10.1109/TKDE.2024.3400824},
  ISSN={1558-2191},
  month={Nov},}@INPROCEEDINGS{11256835,
  author={Peng, Zewu and Zhu, Taipeng and Liu, Chenghui and Chen, Yue and Zhang, Zhixin and Ye, Ziming},
  booktitle={2025 IEEE 3rd International Conference on Sensors, Electronics and Computer Engineering (ICSECE)}, 
  title={SAGE: Synthetic-Augmented Generation with Error Feedback for Text-to-SQL}, 
  year={2025},
  volume={},
  number={},
  pages={656-661},
  abstract={The development of text-to-SQL systems has been constrained by the scarcity of high-quality training data. Due to the high cost and limited scalability of manual annotation, researchers have increasingly turned to large language models (LLMs) to generate synthetic data. However, existing synthetic data generation methods often produce questions that are not representative of real-world scenarios, and there is frequently a lack of strict semantic alignment between the natural language queries (NLQs) and their corresponding SQL statements. This limits the effectiveness of model training and hampers performance in practical deployments. To address these challenges, this paper proposes a novel NLQ-SQL data synthesis framework embedded with an error feedback mechanism. The method introduces a structured feedback loop that automatically detects, categorizes, and feeds synthesis errors back to the LLM, enabling iterative optimization of the model and continuous improvement in data quality. This closed-loop mechanism enhances the realism and semantic alignment of the generated SQL queries, making them more reflective of actual business scenarios. Experimental results based on standard text-to-SQL benchmarks demonstrate that the proposed approach significantly improves the generalization capability of text-to-SQL models},
  keywords={Training;Structured Query Language;Scalability;Large language models;Data integrity;Semantics;Training data;Data models;Iterative methods;Synthetic data;Text-to-SQL;Synthetic Data;Error Feedback Mechanism;Large Language Models},
  doi={10.1109/ICSECE65727.2025.11256835},
  ISSN={},
  month={Aug},}@INPROCEEDINGS{11400955,
  author={Liu, Dingwei and Wang, Yan and Tian, Yuxuan and Zeng, Zhiqiang and Liu, Su and Zheng, Weipeng and Xiao, Yufeng},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={MixCoT-SQL: A User-Adaptive Text-to-SQL Framework Based on Mixed Chain-of-Thought and Result Reflection Refinement}, 
  year={2025},
  volume={},
  number={},
  pages={6343-6352},
  abstract={With the rapid development of large language models (LLMs), generating structured queries from natural language (Text-to-SQL) with LLMs has become a hot spot in combining databases with artificial intelligence. However, existing methods, such as based on simple prompts or finetuning, suffer from limited prompts or expensive training cost, which is not suitable for cold-start scenarios lacking of user interactions. To address these issues, MixCoT-SQL, a Text-toSQL framework based on mixing of multiple Chain-of-Thoughts, is proposed for adapting to the personalized needs of users. It employs a multi-path Chain-of-Thought prompting strategy to increase the diversity of generated SQLs, and incorporates a feedback-driven reflection mechanism to learn user preferences and optimize generation strategies dynamically. Extensive experiments on several datasets, such as Spider, BIRD, and a real-world enterprise dataset WT, have shown that the execution accuracy of MixCoT-SQL is superior to those of other baselines by 3% - 10%, which demonstrates high robustness on different domains. The code is available at https://github.com/peanutldw/MixCoT-SQL.},
  keywords={Training;Costs;Codes;Databases;Large language models;Natural languages;Diversity reception;Birds;Reflection;Robustness;Text-to-SQL;LLM;Chain-of-Thought;cold-start;Multi-agent Framework},
  doi={10.1109/BigData66926.2025.11400955},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11418133,
  author={Binit, Anubhav and Kumar, Nitish and Hanawal, Manjesh Kumar},
  booktitle={2026 18th International Conference on COMmunication Systems and NETworks (COMSNETS)}, 
  title={NL2SQL for Cybersecurity: Automating Osquery Threat Hunting via Natural Language Queries}, 
  year={2026},
  volume={},
  number={},
  pages={1130-1134},
  abstract={Osquery is a widely used security monitoring and endpoint visibility platform that exposes system state through a large, fixed schema of more than 100 tables. Threat hunters and security analysts often struggle to use the schema effectively, as it requires translating their investigative intent into precise SQL queries—creating a barrier to fast and efficient threat detection.. To remove this barrier, we propose a domain-specific Natural Language to SQL (NL2SQL) system for Osquery. Our approach constructs a synthetic Osquery-focused dataset, where Large Language Models generate realistic threat-hunting questions paired with accurate SQL queries. Using this dataset, we develop a Retrieval-Augmented Generation (RAG) pipeline: a retrieval module selects the most relevant Osquery tables for a given natural language input, and a generative model produces the final SQL query conditioned on the retrieved schema. Our strategy showcases the possibilities of integrating retrieval-augmented generation with domain specialization for high accuracy, schema-awareness, and efficiency in NL2SQL conversion for big structured databases.},
  keywords={Training;Structured Query Language;Accuracy;Translation;Retrieval augmented generation;Pipelines;Named entity recognition;Threat assessment;Robustness;Synthetic data;Osquery;LLM;RAG;Threat Hunting;NL2SQL},
  doi={10.1109/COMSNETS67989.2026.11418133},
  ISSN={2155-2509},
  month={Jan},}@INPROCEEDINGS{11005216,
  author={Karki, Sujan and Karki, Pukar and Shrestha, Binay Lal and Jha, Tantra Nath},
  booktitle={2025 International Conference on Inventive Computation Technologies (ICICT)}, 
  title={Smaller Large Language Models for Text-To-Sql: Performance Analysis and Optimal Performance}, 
  year={2025},
  volume={},
  number={},
  pages={1-7},
  abstract={Text-to-SQL aims to transform natural language queries into executable SQL, a task in which Large Language Models (LLMs) have demonstrated significant success. However, their extremely high computational demands often make practical implementation challenging. This study investigates the performance of smaller models, ranging from 0.5B to 3.8 B parameters, after fine-tuning with Parameter-Efficient Fine-Tuning (PEFT) techniques, namely LoRA and QLoRA. Experimental results indicate that such small models can achieve execution accuracy as high as $7 6. 8 3 \%$, comparable to much larger models such as Mistral, Gemma-2, and Qwen2.5 Coder 7B, while requiring significantly fewer computational resources. These findings highlight the feasibility of smaller models for real-world Text-to-SQL applications and challenge the prevailing assumption that high accuracy and efficiency are attainable only through large-scale models.},
  keywords={Training;Adaptation models;Structured Query Language;Accuracy;Computational modeling;Large language models;Natural languages;Transforms;Performance analysis;Optimization;Text-to-SQL;Fine-tuning;LLMs;PEFT},
  doi={10.1109/ICICT64420.2025.11005216},
  ISSN={2767-7788},
  month={April},}@INPROCEEDINGS{11462681,
  author={Su, Jinhang and Duan, Shaoming and Zhang, Yuhao and Liu, Chuanyi and Han, Peiyi},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={ITDS-SQL: Enhancing Text-to-SQL Parsing by In-Context Learning with Inference Time Data Synthesis}, 
  year={2026},
  volume={},
  number={},
  pages={16552-16556},
  abstract={Recent work has shown that fine-tuning LLMs with synthetic data improves text-to-SQL performance. However, synthetic data for in-context learning (ICL) remains underexplored. Existing data synthesis methods face two key limitations when applied to ICL: (1) they require the pre-generation of large-scale synthetic datasets for example retrieval, which is resource-intensive, and (2) they often introduce domain-irrelevant or query-intent-inconsistent natural language question (NLQ)–SQL pairs, leading to significant performance degradation. To address these challenges, we propose ITDS-SQL, an inference-time data synthesis framework for ICL augmentation in text-to-SQL tasks. Unlike prior approaches, ITDS-SQL generates high-quality synthetic NLQ-SQL pairs on-the-fly during inference, eliminating the need for pre-synthesized datasets. To ensure domain relevance and query intent consistency, we first employ a hybrid strategy to generate plausible SQL skeletons tailored to the input NLQ. Guided by these skeletons, it then synthesizes complete SQL queries and their corresponding NLQ′. These dynamically generated, semantically aligned pairs are subsequently used as few-shot examples in the ICL prompt to elicit accurate SQL predictions. Experiments on two cross-domain text-to-SQL benchmarks (Spider and Bird) show ITDS-SQL significantly boosts open-source LLMs, outperforming state-of-the-art methods using synthetic data for fine-tuning or in-context learning, setting a new benchmark for effective ICL in text-to-SQL.},
  keywords={Filtering;Filters;Media Access Control;Protocols;Communication systems;HTTP;Radio access networks;Radio access technologies;Regional area networks;Wide area networks;Text-to-SQL;LLM;Inference-time Data Synthesis;In-context Learning Augmentation},
  doi={10.1109/ICASSP55912.2026.11462681},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11323205,
  author={Zhang, Rui and Zhao, Shenghui},
  booktitle={2025 IEEE 31th International Conference on Parallel and Distributed Systems (ICPADS)}, 
  title={SafeSQL-LLM: A Synthetic Data Approach to Privacy-Preserving Text-to-SQL}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Text-to-SQL systems powered by large language models (LLMs) enable intuitive natural language access to structured databases, but querying sensitive tables via cloud-hosted models raises critical privacy concerns. We present SafeSQLLLM, a hybrid framework that preserves privacy without sacrificing query accuracy. Our approach uses a local LLM to generate synthetic table rows that statistically mimic the original data distribution, validates them through safety checks to prevent real data leakage, and shares only the database schema and verified synthetic rows with a cloud-based model for SQL generation. Evaluated on the Spider benchmark [1], SafeSQL-LLM achieves 83.1% execution accuracy-a 2.8-percentage-point improvement over schema-only baselines (80.3%) and comparable performance to methods that expose real data (84.4%). Ablation studies reveal that even a single synthetic row per table yields significant gains, with optimal performance using 3-5 rows before diminishing returns set in. Furthermore, integration with the DEA-SQL framework demonstrates the generalizability of our approach, maintaining 83.6% accuracy using only synthetic data versus 85.6% with real data. These results establish that locally generated synthetic data can effectively bridge the privacy-utility gap in LLM-based database querying, offering a practical solution for privacy-sensitive domains such as healthcare and finance.},
  keywords={Structured Query Language;Privacy;Accuracy;Systematics;Large language models;Natural languages;Finance;Medical services;Benchmark testing;Synthetic data;Text-to-SQL;privacy preservation;synthetic data generation;large language models;hybrid architecture},
  doi={10.1109/ICPADS67057.2025.11323205},
  ISSN={2690-5965},
  month={Dec},}@INPROCEEDINGS{11407744,
  author={De Silva, Eranda and Asanka, Dinesh},
  booktitle={2025 International Conference on Advances in Technology and Computing (ICATC)}, 
  title={Text to SQL AI Agentic Workflow Implementations: A Systematic Literature Review}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={This study comprehensively examines recent advancements and persistent challenges in the development of Text-to-SQL systems, specifically focusing on the integration of agentic workflows with a RAG or Graph-Retrieval Augmented Generation (Graph-RAG) approach. The core task of translating natural language queries into Structured Query Language (SQL) statements aims to democratize data access. However, existing methods, including standalone Large Language Models (LLMs), frequently exhibit limitations related to the ambiguity of natural language, the complexity of real-world database schemas, and the generation of factually incorrect or syntactically invalid SQL. This review synthesizes the literature to demonstrate how multi-agentic frameworks with RAG and Graph-RAG architectures address these issues. The decomposition of complex queries into sub-tasks including intent classification, schema linking, and error corrections posited to enhance the system's flexibility, generalization capabilities, and overall reliability. Concurrently, the RAG and Graph-RAG database context approach offers a promising method for grounding LLMs with high-fidelity, structured, and contextual information. By leveraging vector databases or knowledge graphs to represent database schemas and domain-specific knowledge, these RAG systems augment the LLM’s prompt, thereby mitigating hallucinations and improving the accuracy of the generated SQL. TigerVector illustrates the potential of hybrid retrieval methods that combine semantic and relational search within a single graph database, enabling multi-hop reasoning crucial for handling complex enterprise and financial datasets. Despite these advancements, several challenges remain, notably the automation of creating effective, LLM-friendly database representations and achieving fully autonomous continual learning. Future research should focus on fortifying security protocols to facilitate the robust and scalable Text-to-SQL AI Agentic Graph-RAG workflows.},
  keywords={Structured Query Language;Accuracy;Translation;Databases;Grounding;Large language models;Retrieval augmented generation;Cognition;Complexity theory;Systematic literature review;ai agents;graph-rag;large language models;rag;text-to-sql},
  doi={10.1109/ICATC68823.2025.11407744},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10075969,
  author={Xusheng, Liu and Yeteng, An and Jingxian, Lv and Huimin, Zhang and Yumeng, Zhang and Min, Li and Wei, Zhao and Wei, Han and Liangfei, Sun and Huiqin, Li},
  booktitle={2023 IEEE 3rd International Conference on Power, Electronics and Computer Applications (ICPECA)}, 
  title={Research on BERT-based Text2SQL Multi-task Learning}, 
  year={2023},
  volume={},
  number={},
  pages={864-868},
  abstract={With the continuous development of computer technology, the Internet has entered the era of big data, which has spawned massive data in various fields and stored it in the database in a structured form. As an important national infrastructure, the power system is also constantly generating various types of data, and has become an important resource for daily operation and maintenance. During the interaction with the database, business personnel need to manually write SQL statements, which poses a challenge to a large number of nonprofessionals; At the same time, for experienced professionals, the conditions of SQL statements are complex and changeable, which is easy to make mistakes, thus affecting the utilization of data and the efficiency of queries. Therefore, how to fully explore the relationship between natural language and SQLstatements and apply them to power operation and maintenance is an important research topic. This paper studies the method of transforming natural language into SQL statement according to the current situation of power field. In terms of solution strategy, this paper divides the problem into several subproblems and combines BERT to carry out multi task learning. The experimental results show that this method is effective on Text2SQL tasks.},
  keywords={Structured Query Language;Databases;Natural languages;Maintenance engineering;Multitasking;Power electronics;Power systems;Text2SQL;NL2SQL;Deep learning;Multi-task learning},
  doi={10.1109/ICPECA56706.2023.10075969},
  ISSN={},
  month={Jan},}@INPROCEEDINGS{11342895,
  author={Wang, Bing and Zhang, Youming and Zhang, Xingpeng and Zhao, Chunlan and Zhang, Chi and Cai, Chaoqi},
  booktitle={2025 IEEE International Conference on Systems, Man, and Cybernetics (SMC)}, 
  title={Text-to-SQL Correction Based on Correlation Degree and Multi-round Error Evaluation}, 
  year={2025},
  volume={},
  number={},
  pages={2199-2204},
  abstract={Text-to-SQL is an innovative tool that automatically converts natural language queries into structured SQL statements, enabling users to extract data from complex databases efficiently. Automatic correction techniques are employed to enhance the performance of Text-To-SQL models. However, these corrections encounter challenges stemming from a lack of critical information in input sequences, substantial noise, and insufficient contextual knowledge, all hindering optimal parser performance. We propose a correction method based on correlation degree and multi-round error evaluation (CMC) to address these issues. Our approach uses a correlation evaluator to eliminate redundant table columns, emphasize key aspects of the input sequence, and minimize unnecessary noise. The multi-round error evaluator integrates database execution analysis of SQL queries, allowing for the updating of erroneous information and background knowledge to better guide model correction. Experimental results indicate that our method achieves a 3.3% increase in exact set execution accuracy (EX) and a 2.0% increase in exact match accuracy (EM) on the Spider benchmark, surpassing current mainstream automatic correction methods. Additionally, our correction technique has significantly improved the performance of the Text-To-SQL baseline model.},
  keywords={Structured Query Language;Analytical models;Correlation;Accuracy;Databases;Noise;Natural languages;Benchmark testing;Data mining;Cybernetics;Text-to-SQL;Automatic correction;correlation degree;multi-round error evaluation},
  doi={10.1109/SMC58881.2025.11342895},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11380122,
  author={Potdar, Mokshada and Potdar, Mahesh and Potdar, Shubhangi},
  booktitle={2025 International Conference on Electronics and Computing, Communication Networking Automation Technologies (ICEC2NT)}, 
  title={Advancing NLIDB Systems with T5-RAG: An Encoder-Decoder Approach to SQL Query Generation}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Interacting with relational databases often requires expertise in Structured Query Language (SQL), which limits accessibility for non-technical users. Natural Language Interfaces to Databases (NLIDBs) aim to bridge this gap by translating user questions in plain language into executable SQL queries. Recent developments in large language models (LLMs) have improved this translation process, yet decoder-only models face challenges in handling large schemas, generating accurate queries in complex scenarios, and managing prompt length efficiently. This study presents a hybrid approach that integrates a Retrieval-Augmented Generation (RAG) framework with an encoder-decoder model based on the Text- to- Text Transfer Transformer (TS). The system filters and retrieves schema components relevant to the user query and feeds them, along with the original input, to the model for SQL generation. Evaluated on both a real-world industrial dataset and the Spider benchmark, the proposed method demonstrates improvements in accuracy and execution success while significantly reducing token usage. Additionally, the model is optimized for low-latency inference through quan-tization and self-hosted deployment. The experimental results indicate that combining focused schema retrieval with encoder-decoder architectures enhances both performance and efficiency in natural language to SQL translation tasks.},
  keywords={Structured Query Language;Translation;Accuracy;Filters;Large language models;Retrieval augmented generation;Relational databases;Transformers;Hybrid power systems;Low latency communication;Text-to-SQL;NLIDB;Transformer;TS;Re-trieval Augmented Generation;GPT Comparison;Schema Opti-mization},
  doi={10.1109/ICEC2NT65402.2025.11380122},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11125795,
  author={Chinta, Pratima and Naidu, Gokul and B, Manjunatha and Ponnath, Anand},
  booktitle={2025 IEEE International Conference on Omni-layer Intelligent Systems (COINS)}, 
  title={Optimizing Financial Decision-Making in Cloud Environments: A GenAI-driven Approach to Convert Natural Language to SQL}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Modern enterprises increasingly leverage public cloud services to host application workloads with underlying cloud components, service tiers, and associated costs. These usage-based charging models introduce complexity. This necessitates the analysis of substantial data volumes to derive valuable insights. In this paper, we aim to address the challenge of enabling business and financial stakeholders to efficiently interpret cloud cost data and its trends without SQL expertise. We present an AI-powered system built on the DSPy framework that translates natural language questions into SQL queries using an enterprise-grade Large Language Model (LLM), delivering context-aware and desired responses. Existing dashboards and NLP approaches rely on rule-based parsing, requiring predefined data schemas and manual configuration. DSPy also uses these schemas but enhances flexibility by adapting them through structured pipelines and multi-step reasoning to improve accuracy. To train and evaluate our model, we augment a small dataset of question-SQL pairs through LLM-based generation and manual refinement. Additionally, we develop a custom recommendation engine using search-based techniques in Python to identify and disambiguate field names and values for both users and the LLM. Our system achieves 90% execution accuracy on our dataset, which indicates that the generated SQL queries return correct results when executed on the target database. These results demonstrate the effectiveness of prompt-tuned LLMs and in-context learning in providing a scalable, accessible solution for enterprise data analysis, ultimately enhancing decision-making in financial management.},
  keywords={Structured Query Language;Cloud computing;Costs;Accuracy;Translation;Large language models;Decision making;Manuals;Natural language processing;Stakeholders;Natural language processing;Text-to-SQL;Large Language Models;Generative AI;Cloud Cost Data insights},
  doi={10.1109/COINS65080.2025.11125795},
  ISSN={2996-5330},
  month={Aug},}@INPROCEEDINGS{11590836,
  author={Raut, Atharva and Shah, Mahi and Patil, Rutika and Patil, Yuvraj and Khodaskar, Manish},
  booktitle={2026 International Conference on Next Generation Electronics (NELEX)}, 
  title={Scalable, Secure and Persistent Natural Language Interfaces for SQL Databases}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Natural Language to SQL (NL2SQL) systems are increasingly serving interactive analytical workloads across many databases and tenants; however, current architectures do not balance low latency, strong isolation, and conversational persistence. Traditional approaches based on shared, stateless execution or centrally-managed language model services contribute to context leakage and cold starts, often with limited support for long-lived sessions. This paper proposes a per-user, long-lived execution architecture for NL2SQL systems which describes an isolated runtime with a local language model, a vector database, and query-execution logic for each user implemented through a centralized control plane. The proposed design can handle several concurrent conversational threads per user, dynamic binding to heterogeneous databases, and secure, scoped access to a database to maintain persistent conversational state. We also contrast five open-source language models with the Spider benchmark that consists of 1,034 complex NL2SQL queries across 20 databases. All models will be run with fixed inference parameters (greedy decoding with temperature set to 0.0, TopP to 1.0 and a maximum generation limit of 512-1024 tokens) in order to be reproducible. The experimental results indicate execution accuracy between 13% and 59% per model with inference latency of $3.63 \mathrm{~s}-16.04 \mathrm{~s}$ per query. The architecture we proposed minimizes cold-start overhead via persistent execution contexts, thus providing a high degree of isolation and robustness under concurrent workloads.},
  keywords={Modeling;Structured Query Language;Printing;Databases;Containers;Architecture;Computer architecture;Accuracy;Natural languages;Context;Natural Language to SQL;NL2SQL;Large Language Models;Database Interfaces;Query Translation;Privacy-Preserving Systems},
  doi={10.1109/NELeX69209.2026.11590836},
  ISSN={},
  month={May},}@INPROCEEDINGS{11113237,
  author={Zhang, Meng and Ma, Kexin and Xu, Liyang and Zhang, Kedi and Peng, Yuanxi and Jin, Ruochun},
  booktitle={2025 IEEE 41st International Conference on Data Engineering (ICDE)}, 
  title={CLEAR: A Parser-Independent Disambiguation Framework for NL2SQL}, 
  year={2025},
  volume={},
  number={},
  pages={1-14},
  abstract={Parsing Natural Language to SQL (NL2SQL) helps users who are not proficient in databases to efficiently query desired data through natural language. Although existing NL2SQL parsers demonstrate good capabilities in processing clear queries, ambiguity still remains an unresolved issue which makes parsers produce unstable outputs that deviate from the user's actual intent. To bridge the gap, this paper introduces the CLEAR framework, a systematic study of disambiguation for NL2SQL, including ambiguity detection, clarification, and reformulation, which benefits any NL2SQL parsers. Firstly, CLEAR employs a pipeline using Large Language Models (LLMs) and a series of rules to detect ambiguities, thus obtaining the “candidate mapping” for ambiguity representation. Secondly, an interactive selection module is employed to collect the clarification information from users through multiple-choice questions, thus obtaining the “selection mapping”. Finally, rewriting rules are employed to reformulate the question and schema, thus obtaining a clear input for parsers to generate clear SQLs. Furthermore, we construct CLAMBSQL, a novel benchmark for systematic evaluation for NL2SQL disambiguation, which contains fine-grained ambiguity and clarification annotations. Experiments on various datasets and baselines demonstrate that CLEAR can successfully address seven types of ambiguity. When parsers are integrated with CLEAR, the performance of ambiguous SQLs detection achieves a significant improvement of 30.5 % on AMBROSIA in the AllFound metric and 21.1 % on AmbiQT in the BothInTop-5 metric, the performance of ambiguity clarification achieves a remarkable improvement of 16.2 % on CLAMBSQL in the CEX metric, and the performance of the general prediction achieves an increase of 1.6 % in the EX metric and 7.7 % in the CSR metric on BIRD. The CLEAR code and CLAMBSQL dataset are available at https://github.com/mengzhang18/CLEAR.},
  keywords={Measurement;Structured Query Language;Systematics;Codes;Databases;Large language models;Natural languages;Pipelines;Data engineering;Birds;NL2SQL;Ambiguity;LLM;Interaction},
  doi={10.1109/ICDE65448.2025.00247},
  ISSN={2375-026X},
  month={May},}@INPROCEEDINGS{10148562,
  author={Shen, Ran and Sun, Gang and Shen, Hao and Li, Yiling and Jin, Liangfeng and Jiang, Han},
  booktitle={2023 7th International Conference on Machine Vision and Information Technology (CMVIT)}, 
  title={SPSQL: Step-by-step Parsing Based Framework for Text-to-SQL Generation}, 
  year={2023},
  volume={},
  number={},
  pages={115-122},
  abstract={Converting text into the structured query language (Text2SQL) is a research hotspot in the field of natural language processing (NLP), which has broad application prospects. In the era of big data, the use of databases has penetrated all walks of life, in which the collected data is large in scale, diverse in variety, and wide in scope, making the data query cumbersome and inefficient, and putting forward higher requirements for the Text2SQL model. In practical applications, the current mainstream end-to-end Text2SQL model is not only difficult to build due to its complex structure and high requirements for training data, but also difficult to adjust due to massive parameters. In addition, the accuracy of the model is hard to achieve the desired result. Based on this, this paper proposes a pipelined Text2SQL method: SPSQL. This method disassembles the Text2SQL task into four subtasks——table selection, column selection, SQL generation, and value filling, which can be converted into a text classification problem, a sequence labeling problem, and two text generation problems, respectively. Then, we construct data formats of different subtasks based on existing data and improve the accuracy of the overall model by improving the accuracy of each submodel. We also use the named entity recognition module and data augmentation to optimize the overall model. We construct the dataset based on the marketing business data of the State Grid Corporation of China. Experiments demonstrate our proposed method achieves the best performance compared with the end-to-end method and other pipeline methods.},
  keywords={Structured Query Language;Machine vision;Pipelines;Text categorization;Training data;Data models;Natural language processing;Text2SQL;natural language processing;pipeline;dataset},
  doi={10.1109/CMVIT57620.2023.00030},
  ISSN={},
  month={March},}@INPROCEEDINGS{11358579,
  author={Caldeira, Carlos Eduardo and Kretzer, Arthur Raulino and Siqueira, Frank and De Mello, Alexandre Reeberg},
  booktitle={2025 12th International Conference on Soft Computing & Machine Intelligence (ISCMI)}, 
  title={LLM-Based Text-to-SQL for SparkSQL Queries in Manufacturing Data Lakes: An Architecture for Industry 4.0}, 
  year={2025},
  volume={},
  number={},
  pages={300-304},
  abstract={The transition to Industry 4.0 has significantly increased the volume and complexity of manufacturing data, creating a barrier for domain experts without deep technical knowledge. To address this challenge, this paper proposes a flexible, on-premises-first architecture that integrates Small or Large Language Models (S/LLMs), agents, and SparkSQL to enable semantic querying of manufacturing data lakes. The architecture features a multi-agent pipeline for schema analysis, table selection, prompt enrichment, and execution-based query refinement, supported by on-premises components for storage, processing (Apache Spark), and orchestration. This design ensures data privacy and low-latency operation. A service-based backend exposes schema and execution endpoints to the agents, and a web interface allows users to interact with the system. The architecture’s capabilities were validated using a custom dataset of natural language queries in Portuguese, demonstrating Executability Rate (ER) of 100%, with Precision of 62.44% and Recall scores of 56,34% in the test set benchmark when using LLM. This result confirms the viability of the multi-agent design, setting a clear performance target for future on-premises models and opening pathways for more human-centric data access in smart manufacturing systems.},
  keywords={Data privacy;Large language models;Semantics;Pipelines;Natural languages;Big Data applications;Fourth Industrial Revolution;Low latency communication;Machine intelligence;Smart manufacturing;Industry 4.0;Text-to-SQL;SparkSQL;Large Language Models;Data Lake;Big Data},
  doi={10.1109/ISCMI67495.2025.11358579},
  ISSN={2640-0146},
  month={Nov},}@INPROCEEDINGS{11472190,
  author={Viswanathan, Venkatraman and Agrawal, Atharva Mangeshkumar and Pandurang Shinde, Rutika and Ghosh, Hemanta and Shah, Harshal and Katakam, Raghuram},
  booktitle={2025 5th International Conference on Electrical, Computer and Energy Technologies (ICECET)}, 
  title={Efficient NLP Model for Text-to-SQL}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Text-to-SQL conversion plays a crucial role in streamlining data analysis across various industries. The objective is to generate SQL queries that precisely correspond to natural language prompts and are applicable to an organization’s private database, ensuring comprehensive retrieval of necessary information. However, a notable gap in existing research is the lack of comprehensive studies comparing different embeddings and language models for this task. There is a pressing need for structured evaluations to identify optimal models for accurately converting text into SQL queries tailored to private databases commonly used in enterprise settings.To address this gap, we employ the Retrieval-Augmented Generation (RAG) framework. Our study integrates various embedding techniques and large language models (LLMs), utilizing the Retrieval-Augmented Generation Assessment (RAGAs) framework [1] to systematically assess their performance. Evaluation metrics encompass faithfulness, relevancy, context precision, and recall. Our experimental results highlight the effectiveness of our approach in generating accurate SQL queries from natural language inputs.This research makes a significant contribution to advancing the understanding of text-to-SQL conversion methodologies and their real-world applicability in enterprise data environments.},
  keywords={Filtering;Filters;Recommender systems;Information filtering;Internet;Communication systems;Computer networks;Protocols;HTTP;Radio access technologies;Text-to-SQL;Retrieval-Augmented Generation (RAG);RAGAs;Large Language Models (LLMs);Natural Language Processing (NLP);SQL Query Generation;Embedding Models;Database Query Automation},
  doi={10.1109/ICECET63943.2025.11472190},
  ISSN={},
  month={July},}
