@article{LIU2026130197,
title = {Few-shot dialogue state tracking via context ranking and dynamic contrastive decoding},
journal = {Expert Systems with Applications},
volume = {300},
pages = {130197},
year = {2026},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2025.130197},
url = {https://www.sciencedirect.com/science/article/pii/S0957417425038126},
author = {Zhanghui Liu and Chaoxiong Zhou and Yuzhong Chen and Zeping Zheng},
keywords = {Dialogue state tracking, Dynamic contrastive decoding, Context ranking, Task-oriented dialogue,},
abstract = {Dialogue State Tracking (DST) is crucial in accurately monitoring user goals and system actions in task-oriented dialogue systems. While utilizing large language models (LLMs) in few-shot DST enhances generalization under limited supervision, few-shot DST still faces several challenges in practical applications. Specifically, the progressive refinement of user goals makes it difficult to accurately identify the correct slot value among semantically similar candidates, while the redundant context introduced when LLMs process the full dialogue context further complicates the effective utilization of relevant information. We propose CoRD-DST, a novel few-shot DST framework based on Context Ranking and Dynamic Contrastive Decoding to address these issues. During training, a context-aware auxiliary task guides CoRD-DST to focus on relevant dialogue turns, while adversarial instruction tuning enables CoRD-DST to learn both correct and incorrect response patterns. In inference, the dynamic contrastive decoding method contrasts outputs under different instructions to suppress incorrect slot values and adaptively weight slots without manual tuning. Experimental results demonstrate the effectiveness of CoRD-DST and its advantages over the state-of-the-art DST models on the MultiWOZ 2.1 and MultiWOZ 2.4 datasets. To facilitate reproduction, our code is available at https://github.com/ChaoxiongZhou/CoRD-DST.}
}
@article{XU2025536,
title = {DeepSeek: implications for data science and management in the AI era},
journal = {Data Science and Management},
volume = {8},
number = {4},
pages = {536-541},
year = {2025},
issn = {2666-7649},
doi = {https://doi.org/10.1016/j.dsm.2025.09.001},
url = {https://www.sciencedirect.com/science/article/pii/S2666764925000451},
author = {Zongben Xu and Shan Liu and Wei Huang and Junmin Shi and Fengmin Xu and Xin Tang and Haibing Lu},
keywords = {DeepSeek, Large language models (LLMs), Cost-efficient AI, AI-driven analytics, AI for business},
abstract = {DeepSeek has emerged as a disruptive force in artificial intelligence (AI). Unlike traditional large language models (LLMs), which demand extensive computational resources, DeepSeek delivers comparable performance to industry-leading models at a fraction of the cost. Its impact spans both data science and business. In data science, DeepSeek enhances data processing, feature engineering, and statistical modeling, enabling enterprises to deploy AI-driven analytics more cost-effectively. In business, DeepSeek supports various industry sectors, making advanced AI more accessible to small and medium-sized enterprises (SMEs). Additionally, its source-available licensing model promotes transparency and adaptability, challenging the dominance of proprietary AI ecosystems. This paper explores the implications of DeepSeek, reviews its technological advancements and challenges, and outlines future research directions.}
}
@article{TENG2026130481,
title = {Program of actions (PoA): Interactive semantic action parser as more powerful dialogue state tracker through code generation},
journal = {Expert Systems with Applications},
volume = {301},
pages = {130481},
year = {2026},
issn = {0957-4174},
doi = {https://doi.org/10.1016/j.eswa.2025.130481},
url = {https://www.sciencedirect.com/science/article/pii/S0957417425040965},
author = {Dechuan Teng and Zheng Yan and Wanxiang Che},
keywords = {Dialogue state tracking, Semantic action parsing, Code generation, Large language model},
abstract = {Recent studies have shown promising results of large language models (LLMs) in zero-shot dialogue state tracking (DST) due to their expressive language understanding capabilities learned from general text corpora. However, these studies reframe DST as a slot-filling problem and do not explicitly model the causal relationship between user semantics and state updates, thus not fully aligning with the goal of dialogue state tracking. To address this issue, we propose a novel interactive semantic action parser, named Program of Actions (PoA), to seamlessly integrate semantic action parsing and dialogue state tracking through code generation. Specifically, we first define domain schemas and two sets of semantic actions for users and systems using the Python syntax, called prefix code. LLMs are then prompted with prefix code and the previously parsed dialogue context to convert the current message into a sequence of semantic action code. Finally, the action code is executed directly to update the dialogue state, thereby functioning as a state tracker. Experimental results on MultiWOZ, a large-scale task-oriented dialogue benchmark, demonstrate that PoA outperforms existing DST prompting methods by a significant margin and achieves competitive performance compared to state-of-the-art zero-shot DST models. Further analysis shows that PoA is effective across a wide range of LLMs (from 3B to 671B) and exhibits a consistent performance scaling law with the model capacity.}
}
@article{MONTAZERI2026100136,
title = {PublicAgent: Multi-agent design principles from an LLM-based open data analysis framework},
journal = {Digital Engineering},
volume = {11},
pages = {100136},
year = {2026},
issn = {2950-550X},
doi = {https://doi.org/10.1016/j.dte.2026.100136},
url = {https://www.sciencedirect.com/science/article/pii/S2950550X26000488},
author = {Sina Montazeri and Yunhe Feng and Kewei Sha},
keywords = {Multi-agent systems, Large language models, Open data, Data analysis, Natural language interfaces, Agent orchestration},
abstract = {Open data repositories hold potential for evidence-based decision-making, yet remain inaccessible to non-experts who lack expertise in dataset discovery, schema mapping, and statistical analysis. While large language models show promise for individual tasks, end-to-end analytical workflows expose fundamental limitations: attention dilutes across growing contexts, specialized reasoning patterns interfere, and errors propagate without detection. We present PublicAgent, a multi-agent framework that addresses these limitations through targeted decomposition into specialized agents for intent clarification, dataset discovery, analysis, and reporting. This architecture maintains focused attention within agent contexts and enables validation at each pipeline stage. Benchmark evaluation across eight models and ablations across five representative models on 50 queries identify empirical design guidelines for multi-agent LLM systems in open-data analysis. The results show that specialization improves performance across the evaluated models, that discovery and analysis agents provide the most consistent value, and that report and intent agents show stronger model-dependent effects. Ablations further indicate that different agents mitigate distinct failure modes, with discovery and analysis failures often causing unusable outputs while report and intent removal more often degrades quality. These findings provide evidence for when and why specialization helps complex analytical workflows, while also highlighting the need for broader benchmarks, human validation, and continued evaluation as frontier models evolve.}
}
@article{WANG2026100479,
title = {Multimodal Cryptocurrency Volatility Prediction Analysis Based on LLM},
journal = {Blockchain: Research and Applications},
pages = {100479},
year = {2026},
issn = {2096-7209},
doi = {https://doi.org/10.1016/j.bcra.2026.100479},
url = {https://www.sciencedirect.com/science/article/pii/S2096720926000412},
author = {Huiqing Wang and Renguang Chen and Zhide Chen and Kexin Zhu and Chen Feng and Xu Yang and Hui Cui and Xuechao Yang},
keywords = {LLM, Multimodal Data, Market Sentiment Analysis, Cryptocurrency, Realized Volatility},
abstract = {As the digital currency market rapidly evolves, predicting cryptocurrency volatility has become a critical area of financial research. However, traditional and machine learning approaches struggle to effectively capture the multi-dimensional market dynamics, abrupt fluctuations, and long-term dependencies, while also facing interpretability challenges. This study introduces a multimodal prediction approach leveraging large language models (LLMs) to enhance cryptocurrency volatility forecasting. We propose Multimodal Optimized Deep Embedding Learner (MODEL), a comprehensive framework that integrates historical volatility data with textual news information. MODEL incorporates a bimodal encoding module, an attention alignment mechanism, and a sequence prediction module to enhance predictive performance. Empirical analysis on main transaction data from Bitcoin (BTC), Ethereum (ETH), and Binance Coin (BNB) demonstrates the superior accuracy and robustness of our approach compared to existing techniques. By effectively capturing multimodal market signals and sentiment, MODEL improves prediction reliability. Ablation studies further validate the contributions of each module, underscoring the theoretical and practical significance of our research for quantitative trading strategies and related domains.}
}
@article{FERNANDES2026742,
title = {Evaluating Model Context Protocol in the context of a Conversational Agent supporting an Agro-Food Blockchain Logistics Platform},
journal = {Procedia Computer Science},
volume = {278},
pages = {742-750},
year = {2026},
note = {CENTERIS - International Conference on ENTERprise Information Systems / ProjMAN - International Conference on Project MANagement / HCist - International Conference on Health and Social Care Information Systems and Technologies},
issn = {1877-0509},
doi = {https://doi.org/10.1016/j.procs.2026.03.046},
url = {https://www.sciencedirect.com/science/article/pii/S1877050926006381},
author = {Afonso Fernandes and Luís Oliveira and Carlos Machado Antunes and Marisa Maximiano and Ricardo Gomes and Vítor Távora and Orlando Remédios},
keywords = {Agro-food, Farm-to-fork, Traceability, Blockchain: LLM, MCP, A2A, ReAct},
abstract = {This paper presents the design and implementation of a modular conversational agent architecture that enables natural language access to blockchain-based traceability data in the agro-food industry. The research addresses a critical challenge: end-users and consumers require access to traceability data but cannot feasibly receive training on complex technical systems. We propose an LLM-based chatbot that allows stakeholders to query supply chain information using natural language interactions. The architecture integrates two complementary execution backends - LangGraph for structured reasoning with state management, and Gemini Live API for real-time multilingual voice interactions - demonstrating that conversational interfaces can effectively bridge the gap between complex blockchain systems and non-technical users. Through the Model Context Protocol, the system connects heterogeneous data sources including documents, APIs, and blockchain event logs, while role-based access controls ensure appropriate information access across different stakeholder types. A proof-of-concept implementation validates the technical feasibility of this approach, demonstrating that end-users can access verifiable supply chain data through natural dialogue without prior training in blockchain technology or traceability protocols. This work establishes an architectural foundation for making decentralized traceability systems operationally accessible, eliminating the user training barrier that has hindered consumer-facing blockchain applications in agri-food supply chains.}
}
@article{CHEN2025102808,
title = {Transforming health and wellness: Exploring the captivating convergence of rehabilitation, exercise, and cutting-edge health gadgets in the rapidly evolving tech-driven world},
journal = {Technology in Society},
volume = {81},
pages = {102808},
year = {2025},
issn = {0160-791X},
doi = {https://doi.org/10.1016/j.techsoc.2024.102808},
url = {https://www.sciencedirect.com/science/article/pii/S0160791X24003567},
author = {Yadong Chen and Wei Li and Albę Słabi Hussam and S. Baghaei and S. Salahshour},
keywords = {Gadgets, Technology, Smart medicine, Rehabilitation, Exercise health gadgets, Tech-driven world, Data-driven approaches, Transformative potential},
abstract = {In the rapidly evolving tech-driven landscape, a captivating convergence of rehabilitation, exercise, and cutting-edge health gadgets is fundamentally reshaping individual health and fitness pursuits. The adoption of innovative health gadgets, ranging from wearable fitness trackers to advanced robotic exoskeletons, has gained significant momentum among those seeking to optimize performance and expedite recovery processes. This synergy is particularly notable in the field of rehabilitation, where patients undergoing recovery from injuries or surgeries can harness the benefits of health gadgets that offer precision and data-driven approaches to their healing journey. Smart sensors integrated into physical therapy equipment can monitor and analyze a patient's movements, providing instantaneous feedback to both the patient and their therapist, facilitating the creation of tailored rehabilitation programs and enhancing overall outcomes. Furthermore, athletes and fitness enthusiasts are embracing these technologies to gain a competitive edge, as the convergence of rehabilitation, exercise, and health gadgets continues to redefine the landscape of human health and function. Wearable devices, capable of tracking performance metrics such as heart rate, sleep patterns, and calorie expenditure, empower individuals to fine-tune their training regimens and optimize their overall well-being. In addition, the integration of Virtual reality (VR), Augmented reality (AR) and Artificial intelligence (AI) technologies into exercise routines has revolutionized the fitness experience, making workouts not only more engaging but also more effective. This article has delved into the captivating intersection of rehabilitation, exercise, and cutting-edge health gadgets. It has illuminated how these domains complement and elevate each other, offering a glimpse into the transformative potential of technology within the realms of health and wellness. As technology continues to advance at an unprecedented pace, it becomes increasingly evident that the synergy between these fields will continue to strengthen, ultimately benefiting individuals striving to enhance their health, performance, and overall quality of life. The study used machine learning (ML) modeling to enhance understanding of parameter interrelationships, enabling software to predict outputs more accurately without direct programming. ML encompasses supervised, unsupervised, and reinforcement learning, applied across diverse domains. The investigation utilized ML to estimate recovery, performance, and well-being by modifying rehabilitation and health criteria, confirming acceptable prediction error.}
}
@article{KHAN2026104901,
title = {EvoFlow: A closed-loop first-order optimizer for stable and robust deep learning},
journal = {Information Processing & Management},
volume = {63},
number = {8},
pages = {104901},
year = {2026},
issn = {0306-4573},
doi = {https://doi.org/10.1016/j.ipm.2026.104901},
url = {https://www.sciencedirect.com/science/article/pii/S030645732600292X},
author = {Zohaib Khan and Yue Shen and Hui Liu},
keywords = {Adaptive optimization, First-order optimizer, Cosine-adaptive momentum, Trust-aware suppression, Learning-rate robustness, Optimization stability, Deep learning optimization},
abstract = {Robust and efficient optimization remains a central challenge in deep learning as widely used first-order methods are often sensitive to learning-rate selection and noisy or non-stationary gradients. This paper proposes EvoFlow, an O(d) first-order optimizer that introduces closed-loop update regulation through cosine-adaptive momentum with a momentum floor, alignment-based step amplification, and trust-aware suppression driven by inter-iteration gradient change. These mechanisms are designed to improve stability and reduce tuning sensitivity without costly second-order approximations or perturbation-based updates. Under bounded-preconditioner and momentum-tracking assumptions, the analysis establishes non-convex convergence at the standard first-order rate O(T−1/2) and derives stability bounds for the adaptive momentum and suppression terms. Experiments across vision, language understanding, generative modeling, and language modeling tasks show that EvoFlow is competitive with strong baselines under a unified tuning budget. Across CIFAR, GLUE, ImageNet-1K, and robustness benchmarks, EvoFlow demonstrates statistically supported improvements in selected settings and competitive performance in others, with effect sizes interpreted in relation to cross-seed variability where repeated trials are available. In GAN training, EvoFlow provides balanced generator–discriminator optimization and stable FID/KID trajectories. Under the tested WikiText-2 language-modeling protocol, EvoFlow obtains the lowest evaluation loss and perplexity on GPT-2, Pythia-1B, and GPT-Neo, while incurring higher resource costs than some throughput-optimized baselines. The results suggest that EvoFlow offers a theoretically grounded and practically implementable framework for feedback-regulated first-order optimization in stable deep learning.}
}
@article{SAADY2025103066,
title = {Implementation of artificial intelligence approaches in oncology clinical trials: A systematic review},
journal = {Artificial Intelligence in Medicine},
volume = {161},
pages = {103066},
year = {2025},
issn = {0933-3657},
doi = {https://doi.org/10.1016/j.artmed.2025.103066},
url = {https://www.sciencedirect.com/science/article/pii/S0933365725000016},
author = {Marwa Saady and Mahmoud Eissa and Ahmed S. Yacoub and Ahmed B. Hamed and Hassan Mohamed El-Said Azzazy},
keywords = {Artificial intelligence, Machine learning, Deep learning, Oncology clinical trials},
abstract = {Introduction
There is a growing interest in leveraging artificial intelligence (AI) technologies to enhance various aspects of clinical trials. The goal of this systematic review is to assess the impact of implementing AI approaches on different aspects of oncology clinical trials.
Methods
Pertinent keywords were used to find relevant articles published in PubMed, Scopus, and Google Scholar databases, which described the clinical application of AI approaches. A quality evaluation utilizing a customized checklist specifically adapted was conducted. This study is registered with PROSPERO (CRD42024537153).
Results
Out of the identified 2833 studies, 72 studies satisfied the inclusion criteria. Clinical Trial Enrollment & Eligibility were among the most commonly studied clinical trial aspects with 30 papers. The prediction of outcomes was covered in 25 studies of which 15 addressed the prediction of patients' survival and 10 addressed the prediction of drug outcomes. The trial design was studied in 10 articles. Three studies addressed each of the personalized treatments and decision-making, while one addressed data management. The results demonstrate using AI in cancer clinical trials has the potential to increase clinical trial enrollment, predict clinical outcomes, improve trial design, enhance personalized treatments, and increase concordance in decision-making. Additionally, automating some areas and tasks, clinical trials were made more efficient, and human error was minimized. Nevertheless, concerns and restrictions related to the application of AI in clinical studies are also noted.
Conclusion
AI tools have the potential to revolutionize the design, enrollment rate, and outcome prediction of oncology clinical trials.}
}
