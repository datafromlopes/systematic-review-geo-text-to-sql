@INPROCEEDINGS{11402412,
  author={Hao, Heng and Hu, Wenjun and Verkholyak, Oxana and Tarzanagh, Davoud Ataee and Gutow, Baruch and Didari, Sima and Faraki, Masoud and Moon, Hankyu and Min, Seungjai},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={PaVeRL-SQL: Text–to–SQL via Partial–Match Rewards and Verbal Reinforcement Learning}, 
  year={2025},
  volume={},
  number={},
  pages={7687-7696},
  abstract={Text–to–SQL models allow users to interact with a database more easily by generating executable SQL statements from natural–language questions. Despite recent successes on simpler databases and questions, current Text–to–SQL methods still suffer from low execution accuracy on industry–scale databases and complex questions involving domain–specific business logic. We present PaVeRL–SQL, a framework that combines Partial–Match Rewards and Verbal Reinforcement Learning to drive self–improvement in reasoning language models (RLMs) for Text–to–SQL. To handle practical use cases, we adopt two pipelines: (1) a newly designed in–context learning framework with group self–evaluation (verbal–RL), using capable open–and closed–source large language models (LLMs) as backbones; and (2) a chain–of–thought (CoT) RL pipeline with a small backbone model (OmniSQL–7B) trained with a specially designed reward function and two–stage RL. These pipelines achieve state–of–the–art (SOTA) results on popular Text–to–SQL bench-marks–Spider, Spider 2.0, and BIRD. For the industrial–level Spider2.0–SQLite benchmark, the verbal–RL pipeline achieves an execution accuracy 7.4% higher than SOTA, and the CoT pipeline is 1.4% higher. RL training with mixed SQL dialects yields strong, threefold gains, particularly for dialects with limited training data. Overall, PaVeRL–SQL delivers reliable, SOTA Text–to–SQL under realistic industrial constraints. The code is available at https://github.com/PaVeRL-SQL/PaVeRL-SQL.},
  keywords={Training;Structured Query Language;Accuracy;Databases;Large language models;Pipelines;Green products;Reinforcement learning;Stability analysis;Convergence;Text-to-SQL;Reinforcement Learning;Large Language Models;Reasoning},
  doi={10.1109/BigData66926.2025.11402412},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11336597,
  author={Sapkal, Kartikey and Nitnaware, Arhant and Gunjal, Yash and Ghusse, Dipti and Barve, Sunita},
  booktitle={2025 International Conference on Future Technologies (ICFT)}, 
  title={Converting Natural Language to SQL Queries for Data Retrieval Using Database Metadata and LLaMA 3.2}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This work introduces a schema-aware solution that employs the LLaMA 3.2 large language model to translate natural language (NL) queries into executable SQL statements. Unlike traditional text-to-SQL systems that rely on templates or rule-based methods, proposed approach dynamically integrates database schema metadata during inference, enabling more precise and semantically consistent SQL generation. A key novelty of this work lies in the design of a schema-aware agent-emulated pipeline, where SQL generation, validation, and execution are handled by role-specific components emulated through a single LLaMA 3.2 instance. This role separation enhances interpretability, modularity, and safety, while avoiding the need for multiple models or fine-tuning. The system leverages prompt engineering to emulate agent-specific behaviors, ensuring scalability across diverse schema. Real-time extraction and injection of schema metadata from a MySQL database allow accurate mapping of user intents to database structures. The system's effectiveness is demonstrated through multiple evaluation metrics, including BLEU score, syntactic validity, execution accuracy, exact match accuracy, and semantic match score. For real-world applications where data privacy, transparency, and schema sensitivity are critical, proposed method provides a novel, portable, and locally deployable solution.},
  keywords={Structured Query Language;Accuracy;Translation;Sensitivity;Databases;Pipelines;Semantics;Metadata;Syntactics;Prompt engineering;natural language interface;SQL generation;schema-aware LLM;database agent;prompt engineering;LLaMA},
  doi={10.1109/ICFT66708.2025.11336597},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{10899660,
  author={You, Zeshun and Yao, Jiebin and Cheng, Dong and Wen, Zhiwei and Lu, Zhiliang and Shen, Xianyi},
  booktitle={2024 2nd International Conference on Artificial Intelligence and Automation Control (AIAC)}, 
  title={Research and Practice on Database Interaction Based on Natural Language Processing}, 
  year={2024},
  volume={},
  number={},
  pages={436-441},
  abstract={Data serves as the foundation for an enterprise's digital transformation, and its efficient utilization requires database support. SQL is highly complex and often considered unsuitable for non-technical users. Reducing the barriers to data utilization can be achieved by exploring natural language interactions with databases. The NL2SQL task aims to enable natural language interaction with databases. The emergence of large language models (LLMs) has spurred significant theoretical advances in NL2SQL, accelerating its development. However, an efficient NL2SQL system architecture has yet to be established. This paper presents an NL2SQL architecture that incorporates three methods of SQL generation. Additionally, five prevalent issues in NL2SQL systems are analyzed, and corresponding solutions are proposed.},
  keywords={Structured Query Language;Automation;Databases;Large language models;Digital transformation;Systems architecture;Learning (artificial intelligence);Natural language processing;Large language model;NL2SQL;In-Context Learning},
  doi={10.1109/AIAC63745.2024.10899660},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{10611969,
  author={Almohaimeed, Saleh and Almohaimeed, Saad and Wang, Liqiang},
  booktitle={2024 IEEE Congress on Evolutionary Computation (CEC)}, 
  title={GAT-SQL: An Advanced Prompt Engineering Approach for Effective Text-to-SQL Interactions}, 
  year={2024},
  volume={},
  number={},
  pages={1-10},
  abstract={In natural language processing, recent advancements in large language models (LLMs) have significantly impacted the text-to-SQL task, particularly in single-question interactions. However, multi-turn question interactions present unique challenges not fully addressed by current LLMs like GPT-3.5-turbo and GPT-4.5-turbo. In this paper, we perform a comprehensive and systematic analysis on a multi-turn interaction dataset known as SParC to compare various existing prompt engineering methods, including prompt representations and in-context learning methods. Following this, we present GAT-SQL, a novel prompt engineering approach based on three techniques: GAT representation, GAT reviser, and GAT verifier. Comparing our GAT representation and GAT verifier techniques to the previous methods of prompt engineering, they were very successful for the zero-shot experiments. GAT representations improve performance by an average of 2.9% EX and 3.8% IX across all existing question representation methods. While GAT verifier results in a greater improvement in accuracy by an average of 3.6% EX and 4% IX. Furthermore, with regard to in-context learning experiments, the GAT reviser achieved 77.4% EX and 59.9% IX, outperforming the best state-of-the-art model by 3.4% EX and 6.4% IX. As a further demonstration of the effectiveness of GAT-SQL, we tested it on another dataset of multi-turn interactions named CoSQL. GAT reviser achieved a new benchmark in the CoSQL competition, achieving 74.5% EX and 50.2% IX, higher than the closest baseline by 6.3% EX and 9.7% IX.},
  keywords={Analytical models;Structured Query Language;Systematics;Accuracy;Semantics;Benchmark testing;Predictive models;Semantic Parsing;Text-To-SQL;Prompt Engineering;Large Language Models},
  doi={10.1109/CEC60901.2024.10611969},
  ISSN={},
  month={June},}@INPROCEEDINGS{11011547,
  author={Zhang, Jianfeng and Li, Yingying and Liu, YunHao and Xie, Limiao},
  booktitle={2024 4th International Conference on Advanced Enterprise Information System (AEIS)}, 
  title={Research and Practice of NL2SQL Technology Based on LLM for Big Data of Enterprise Finance}, 
  year={2024},
  volume={},
  number={},
  pages={46-51},
  abstract={Currently, the research field of Natural Language Generated SQL (NL2SQL) mainly focuses on generic datasets, aiming to build models that can parse natural language queries and automatically generate SQL statements. However, this generic exploration often ignores the complexity and idiosyncrasies of intra-enterprise data, such as industry-specific terminology, data structure differences, and security compliance requirements, resulting in the fact that the existing NL2SQL technology can only cover the more basic query requirements in practical applications, and is difficult to be deeply integrated into the business scenarios of enterprises. This paper aims to fill this research gap by focusing on the customized application of NL2SQL technology to specific internal enterprise environments, and adopting LLM+RAG+Reminiscence Engineering+Intelligent Body Feedback to design and implement a set of NL2SQL system that can be applied to internal enterprises. After practical project verification, the system’s ability to generate SQL in an enterprise-oriented financial data environment can be improved from 54% to about 70%, and the accuracy of multi-round dialog can be further improved. This system enables the seamless connection between natural language and enterprise database, which provides strong support for enterprise digital transformation.},
  keywords={Structured Query Language;Terminology;Databases;Digital transformation;Natural languages;Focusing;Finance;Big Data;Security;Information systems;big data;financial big data;LLM;NL2SQL;LoRA;BI},
  doi={10.1109/AEIS65978.2024.00015},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{9742459,
  author={Long, Hua and Cao, Dongyu},
  booktitle={2021 2nd International Conference on Information Science and Education (ICISE-IE)}, 
  title={Bert-based Text-to-SQL Generation method with question-table content enhancement and template filling}, 
  year={2021},
  volume={},
  number={},
  pages={969-973},
  abstract={Generating SQL queries through natural language is a way to both reduce the cost of learning SQL for users and improve the efficiency of data queries, and has attracted great interest in recent years. To address this problem, the text proposes a new approach: building feature vectors by linking question and table contents, then building a classification model on top of a pretrained BERT for fine-tuning, and breaking down the Text2SQL process into multiple sub-processes based on template populated multi-classification, using both a general classification model and a conditional value classification model to generate SQL. The conditional value model relies on the results of the general classification model and is optimized using an exhaustive combination. This approach was tested on the WikiSQL dataset and yielded at least 9.8% improvement in accuracy and very good results on the decomposed subtasks, with an accuracy of 85.3% on the test set.},
  keywords={Industries;Structured Query Language;Information science;Natural languages;Buildings;Bit error rate;Data models;component;NLP;Text2SQL;Pre-training Model;SQL Generating},
  doi={10.1109/ICISE-IE53922.2021.00222},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11390419,
  author={Zheng, Zhou and Xie, Wei and Xu, Huifang and Liang, Panfei and Yang, Yan},
  booktitle={2025 9th IEEE International Conference on Network Intelligence and Digital Content (IC-NIDC)}, 
  title={Large Language Model Enhancement Through Multi-Domain Knowledge Integration and Semantic Retrieval in Power Systems}, 
  year={2025},
  volume={},
  number={},
  pages={156-162},
  abstract={With the ongoing digital transformation across the power sector, large language models (LLMs) are increasingly expected to handle domain-specific tasks involving heterogeneous databases and technical vocabularies. To address this demand, we present KARF-Power, a novel framework that combines natural language to SQL (NL2SQL) generation with retrieval-augmented inference across multi-source power-related knowledge bases. Specifically, the framework translates natural language queries into structured database commands while leveraging text vectorization and semantic indexing to retrieve relevant context from specialized corpora such as marketing records and equipment management logs. The retrieved knowledge is then integrated into the LLM's decoding process, enabling context-aware response generation for downstream tasks such as multi-label classification and cross-database querying. This hybrid approach improves interpretability, enhances domain adaptation, and provides a scalable pathway for embedding expert knowledge into LLM-driven applications in the power domain. Extensive experiments on simulated enterprise-level datasets confirm the practical feasibility of our method, showcasing its potential to support real-time intelligent decision-making across diverse business scenarios.},
  keywords={Vocabulary;Structured Query Language;Translation;Databases;Large language models;Semantics;Multi label classification;Cognition;Real-time systems;Business;Large Language Models;Power Systems;Knowledge-Augmented Reasoning;NL2SQL;Semantic Retrieval},
  doi={10.1109/IC-NIDC67200.2025.11390419},
  ISSN={2575-4955},
  month={Nov},}@INPROCEEDINGS{10023434,
  author={Zeng, Lu and Parthasarathi, Sree Hari Krishnan and Hakkani-Tur, Dilek},
  booktitle={2022 IEEE Spoken Language Technology Workshop (SLT)}, 
  title={N-Best Hypotheses Reranking for Text-to-SQL Systems}, 
  year={2023},
  volume={},
  number={},
  pages={663-670},
  abstract={Text-to-SQL task maps natural language utterances to structured queries that can be issued to a database. State-of-the-art (SOTA) systems rely on finetuning large, pre-trained language models in conjunction with constrained decoding applying a SQL parser. On the well established Spider dataset, we begin with Oracle studies: specifically, choosing an Oracle hypothesis from a SOTA model's 10-best list, yields a 7.7% absolute improvement in both exact match (EM) and execution (EX) accuracy, showing significant potential improvements with reranking. Identifying coherence and correctness as reranking approaches, we design a model generating a query plan and propose a heuristic schema linking algorithm. Combining both approaches, with T5-Large, we obtain a consistent 1% improvement in EM accuracy, and a 2.5% improvement in EX, establishing a new SOTA for this task. Our comprehensive error studies on DEV data show the underlying difficulty in making progress on this task.},
  keywords={Measurement;Structured Query Language;Databases;Computational modeling;Heuristic algorithms;Conferences;Natural languages;Text-To-SQL;Semantic parsing},
  doi={10.1109/SLT54892.2023.10023434},
  ISSN={},
  month={Jan},}@ARTICLE{11606333,
  author={Chen, Wei-Heng and Chien, Ying-Ren},
  journal={IEEE Access}, 
  title={HyMIR: A BI-Inspired Hybrid Intermediate Representation for Schema-Agnostic Text-to-SQL}, 
  year={2026},
  volume={},
  number={},
  pages={1-1},
  abstract={BIRD is a recent enterprise-scale Text-to-SQL benchmark that exposes a regime not covered by earlier datasets such as Spider: it consists of 95 real-world databases, which on average contain seven tables each, with abbreviated column names, dense foreign key graphs, and noisy domain values. Generation-target intermediate representations (IRs) such as SemQL and NatSQL, which reduce the model’s output space to a structured plan and rely on a deterministic compiler to reconstruct full SQL, were developed before BIRD and evaluated mainly on Spider-like schemas. As a result, most subsequent BIRD-era work on Text-to-SQL has shifted toward prompt and pipeline engineering, while leaving the choice of generation target—raw SQL versus IR—largely unexamined for large, messy enterprise databases. In this work, we revisit generation-target IRs under the BIRD regime and propose HyMIR, a typed JSON IR designed for enterprise-scale schemas. HyMIR removes high-error structural clauses—JOIN, GROUP BY, and the SELECT projection—from the model’s output and delegates their reconstruction to a compiler that infers join paths from the foreign key graph, while a predicate passthrough channel carries the long tail of fragments that resist abstraction, including LIKE predicates, range bounds, nested IN subqueries, and dialect-specific date functions. To isolate the effect of the IR itself, we compare HyMIR against standard SQL as the generation target under strictly matched conditions: identical training data, backbone (Qwen-2.5-Coder-7B-Instruct), fine-tuning recipe (DoRA), and sampling protocol. On the BIRD development set, HyMIR improves execution accuracy from 52.50% to 55.48% under raw decoding and from 56.81% to 58.44% with N=11 result-set self-consistency. Across model scales (1.5B, 3B, 7B), the gains exhibit a mid-scale sweet spot—largest at 3B, with improvements of roughly +11 points, and smaller but consistently positive at 7B—such that a 3B HyMIR model approaches the performance of a 7B SQL-tuned model while using fewer than half the parameters. Finally, a compiler-only oracle round-trip, which encodes gold SQL into HyMIR and compiles back, achieves 92.83% execution accuracy on BIRD and 91.0% on Spider, indicating comparable representational coverage across the two benchmarks and quantifying a hard upper bound on attainable model performance under this IR and compiler stack.},
  keywords={Structured Query Language;Modeling;Program processors;Birds;Business intelligence;Bismuth;Conferences;Standards;Measurement;Filtering;Text-to-SQL;Large Language Models;Semantic Layer;Intermediate Representation;Domain-Specific Language;Business Intelligence;Schema-Agnostic},
  doi={10.1109/ACCESS.2026.3712824},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11582648,
  author={Wang, Qinghan and Li, Chuantao and Li, Xiang and Wang, Chunxiao and Ma, Jianglin and Zhang, Yang and Yang, Wenhui and Zhao, Zhigang},
  booktitle={2026 29th International Conference on Computer Supported Cooperative Work in Design (CSCWD)}, 
  title={SchemaAware-Cache: A Context- and Schema-Aware Semantic Caching Framework for Efficient Text-to-SQL Systems}, 
  year={2026},
  volume={},
  number={},
  pages={1254-1259},
  abstract={Semantic caching reduces computational costs by reusing generated query results, but existing generic semantic caching frameworks overlook the crucial schema constraints and contextual dependencies inherent in Text-to-SQL tasks, leading to inaccurate cache hits and making them unsuitable for direct application to Text-to-SQL caching scenarios. This paper presents SchemaAware-Cache, a context- and schema-aware caching framework that employs a two-stage retrieval architecture for efficient and precise query matching. Our approach first uses a Query Parser to compress natural language into a schema-aligned, noise-free representation, then performs coarse-grained filtering using semantic and schema similarity, followed by fine-grained contextual matching based on dialogue history. Experiments show that SchemaAware-Cache achieves 0.80 Accuracy and 0.79 F0.5 Score, outperforming representative generic semantic caching frameworks, with cached responses delivering over 7 times lower latency than direct SQL generation.},
  keywords={Structured Query Language;Modeling;Context;Accuracy;Turning;Printing;Current;Natural languages;Design methodology;Filtering;Text-to-SQL;Semantic Caching;Context-Aware;Schema Matching;LLM},
  doi={10.1109/CSCWD68734.2026.11582648},
  ISSN={2768-1904},
  month={May},}@INPROCEEDINGS{11341345,
  author={Rajadurai, R. and Naveen, V. and Sakthivel, M. and Kumar, E. Naveen and Asha, R. and Eshwar, P.},
  booktitle={2025 International Conference on Communication, Computer, and Information Technology (IC3IT)}, 
  title={A Multi-Stage Text-to-SQL Framework using MSE-Extraction and Query Recall Optimization}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={Transforming natural language queries into accurate SQL statements is a persistent challenge in database interaction due to ambiguity in user intent and schema complexity. This paper proposes a multi-stage Text-to-SQL framework that integrates Metrics-Schema-Entity (MSE) extraction, multi-agent query generation, and a query recall optimization mechanism. The framework decomposes user queries into structured representations, generates diverse candidate SQL statements, and selects the most appropriate query through consensus ranking. To enhance adaptability, executed queries are generalized and stored in a recall knowledge base, enabling similarity-based retrieval for future queries. Experimental evaluation demonstrates that the proposed model achieves an exact match accuracy of 89.3%, execution accuracy of 92.1%, and reduces average latency by 59.5% compared to baseline approaches. These results indicate that the framework offers a robust and efficient solution for realtime relational databases, with potential applications in business intelligence, healthcare, and other data-driven domains.},
  keywords={Structured Query Language;Accuracy;Translation;Query processing;Semantics;Knowledge based systems;Relational databases;Natural language processing;Multilingual;Optimization;Text-to-SQL;Large Language Models (LLMs);Natural Language Processing;Query Generation;SQL Retrieval;Query Generalization;Semantic Embeddings;Knowledge Base;Metrics-Schema-Entity Extraction;Multi-Agent Systems},
  doi={10.1109/IC3IT66137.2025.11341345},
  ISSN={},
  month={Oct},}@INPROCEEDINGS{11469310,
  author={Mandal, Babul and Raut, Aditya and Hopal, Pranav and Raut, Pushkar and Kalamkhede, Raunak and Yelne, Sanchit and Shinde, Sandesh},
  booktitle={2026 3rd International Conference on Emerging Trends in Engineering and Medical Sciences (ICETEMS)}, 
  title={VisuaQuery: An AI-Powered Natural Language to SQL and Visualization System}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={This paper introduces a Multimodal NLP-to-SQL and Visualization system. It is a Database Interaction System that facilitates database communication through text, image, and voice inputs without SQL knowledge. The system integrates OCR, speech-to-text, and a transformer-based Large Language Model (LLM) to transform user queries to accurate schemaaware SQL statement. A validation layer ensures query safety and correctness before execution. Experimental evaluation demonstrates high query accuracy, low response latency, and robust performance across modalities. The proposed approach improves accessibility, efficiency, and usability of database systems, making data retrieval more inclusive for non-technical users.},
  keywords={Feeds;Feedback;Filtering;Filters;Circuits;Circuits and systems;Internet;Communication systems;Radio access networks;Regional area networks;Natural Language Query;Multimodal Input;OCR;Google Speech Recognition;SQL Generation;Data Visualization;Multilingual Processing},
  doi={10.1109/ICETEMS66917.2026.11469310},
  ISSN={},
  month={March},}@INPROCEEDINGS{11485070,
  author={Morshed, Md. Neaz and Roy, Prince and Islam, Jahidul},
  booktitle={2026 6th International Conference on Expert Clouds and Applications (ICOECA)}, 
  title={An AI-Driven Natural Language to SQL Framework in Go Leveraging Large Language Models and Dynamic Schema Contextualization}, 
  year={2026},
  volume={},
  number={},
  pages={1080-1087},
  abstract={The need to know is compounded further when the volume of data held in an organization grows, since non-technical users are then not allowed to have fairly instant access to their solution by an obscure barrier to the answer in the form of SQL. To bridge that gap in a given middleware architecture, this paper presents an NLP-to-SQL Query Executor. We come up with a system of Go backend that integrates with the Gemini 2.5-flash LLM to translate the high-level natural language queries into executable SQL queries in real-time. This project is novel because it has a Dynamic Schema Injection (DSI). Rather than a fixed set of regular expressions as we used to see in the past, it will be described here that this engine has an initial dataset, in which it programmatically accesses information of a database schema (information, schema) of SQL tabular queries. In that manner, this system will be able to construct a contextually correct "World Model" of the database - e.g. table relationships and column metadata - and then load it into the system instructions of the LLM. This offers a mechanism to obtain high-quality query results whilst the format of the underlying database changes. This project has JSON-schema-based structured output site to promote sanity in the generated SQL, a custom CORS-enabled REST API in front of it, and a responsive frontend previewing results in tabular form immediately. We empirically test the three components and demonstrate how the components could effectively support ad hoc queries like product information and price comparison, and do so with low latency. This work is based on the idea of greater cooperation in the usage of data between enterprises, due to the automation of the translation between the intention of a human and the actions of a machine with the help of natural language processing.},
  keywords={Payloads;Feeds;Antennas;Satellite broadcasting;Broadcasting;Filtering;Filters;Circuits;Feedback;Circuits and systems;NL2SQL;Dynamic Schema Injection (DSI);Large Language Models (LLMs);Gemini 2.5 Flash;Go-Based Execution Engine},
  doi={10.1109/ICOECA68095.2026.11485070},
  ISSN={},
  month={March},}@INPROCEEDINGS{10650552,
  author={Xu, Bo and Li, Shufei and Wu, Yifei and Wei, Shouang and Du, Ming and Wang, Hongya and Song, Hui},
  booktitle={2024 International Joint Conference on Neural Networks (IJCNN)}, 
  title={Chain-of-Program Prompting with Open-Source Large Language Models for Text-to-SQL}, 
  year={2024},
  volume={},
  number={},
  pages={1-8},
  abstract={Text-to-SQL is a fundamental natural language processing (NLP) task that involves translating natural language queries related to a specified relational database into SQL queries. Recently, large language models (LLMs) have emerged as a crucial paradigm in the Text-to-SQL task. Despite their success, current methods heavily depend on closed-source LLMs with a large number of parameters, such as ChatGPT and GPT4, resulting in significant API costs and privacy concerns. Therefore, a more cost-effective strategy is to fine-tune open-source LLMs with smaller parameters for SQL generation. However, this alternative strategy faces challenges due to the weaker reasoning capabilities of open-source LLMs, particularly in generating complex SQL queries. To address this issue, we propose a Chain-of-Programs (COP) prompting framework for Text-to-SQL. Different from the conventional Chain-of-Thoughts (COT), we utilize Pandas code as an intermediate representation aligned with the step-wise nature of human thinking. This decomposition transforms complex SQL queries into a series of simple Pandas queries. Each step in the COP can be validated using a Python interpreter. Finally, we use the COP prompting to generate SQL queries. Experiments conducted on the Spider dataset using two open-source large language models have demonstrated that our performances are comparable to GPT4 in zero-shot scenario.},
  keywords={Structured Query Language;Privacy;Codes;Costs;Large language models;Neural networks;Transforms;Text-to-SQL;natural language processing;intermediate representation;self-correction;large language models},
  doi={10.1109/IJCNN60899.2024.10650552},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{10484076,
  author={Shen, Ran and Sun, Gang and Shen, Hao and Li, Yiling and Wang, Yifan and Jiang, Han},
  booktitle={2023 International Conference on Algorithms, Computing and Data Processing (ACDP)}, 
  title={SPSQL-2: Make Submodels More Adaptable to Subtasks in the Pipelined Text-to-SQL Model}, 
  year={2023},
  volume={},
  number={},
  pages={245-251},
  abstract={Text-to-SQL (converting the natural utterance into the structured query language) is an important task in the field of natural language processing (NLP). In previous works., we proposed a pipelined text-to-SQL model-SPSQL. SPSQL disassembles the text-to-SQL task into four subtasks: table selection., column selection., SQL generation., and value filling., and then completes the above subtasks in turn by a text classification submodel., a sequence labeling submodel., and two text generation submodels. However., SPSQL still has some defects that prevent the model from further improvement. Firstly., the selection of submodels lacks careful consideration., making submodels not suitable for subtasks enough. Secondly., in the process of generating similar texts using simBERT for natural utterances., there are cases of generating texts with opposite meanings. Thirdly., table/column selection models encountered situations where no table/column is selected during the inference process. Based on this., this paper proposes an advanced version: SPSQL-2. Specifically., we first adjust the corresponding submodel based on the characteristics of each subtask and the inference effects to reconstruct the model. Then., we introduce RoFormer-Sim instead of simBERT to generate similar text of natural utterances. Finally., we construct the “prevent empty table” module and “prevent empty column” module., and insert them into the table selection submodel and column selection submodel respectively. The insertion of these modules prevents the occurrence of no table or column being selected during the inference process. In addition., we construct the dataset based on the power dispatch and control data of the State Grid Corporation of China. Experiments demonstrate our measures in model construction., data augmentation., and (table and column selection) submodel optimization effectively improve the effect of the original model.},
  keywords={Structured Query Language;Adaptation models;Text categorization;Data augmentation;Data models;Natural language processing;Filling;SPSQL;text-to-SQL;NLP;pipeline},
  doi={10.1109/ACDP59959.2023.00046},
  ISSN={},
  month={June},}@ARTICLE{8896071,
  author={Li, Qing and Li, Lili and Li, Qi and Zhong, Jiang},
  journal={IEEE Transactions on Industrial Informatics}, 
  title={A Comprehensive Exploration on Spider with Fuzzy Decision Text-to-SQL Model}, 
  year={2020},
  volume={16},
  number={4},
  pages={2542-2550},
  abstract={The challenge of natural language processing is from natural language to logical form (SQL). In this article, we present an fuzzy semantic to structured query language (F-SemtoSql) neural approach that is a fuzzy decision semantic deep network query model based on demand aggregation. It aims to address the problem of the complex and cross-domain text-to-SQL generation task. The corpus is trained as the input word vector of the model with LSTM and Word2Vec embedding technology. Combined with the dependency graph method, the problem of SQL statement generation is converted to slot filling. Complex tasks are divided into four levels via F-SemtoSql and constructed by the need of aggregation. At the same time, to avoid the order problem in the traditional model effectively, we have adopted the attention mechanism and used a fuzzy decision mechanism to improve the model decision. On the challenging text-to-SQL benchmark Spider and the other three datasets, F-SemtoSql achieves faster convergence and occupies the first position.},
  keywords={Structured Query Language;Semantics;Task analysis;Databases;Syntactics;Natural language processing;Fuzzy decision;fuzzy semantic deep network;natural language processing (NLP);text-to-SQL},
  doi={10.1109/TII.2019.2952929},
  ISSN={1941-0050},
  month={April},}@INPROCEEDINGS{9458778,
  author={Brunner, Ursin and Stockinger, Kurt},
  booktitle={2021 IEEE 37th International Conference on Data Engineering (ICDE)}, 
  title={ValueNet: A Natural Language-to-SQL System that Learns from Database Information}, 
  year={2021},
  volume={},
  number={},
  pages={2177-2182},
  abstract={In this paper we propose ValueNet light and ValueNet – two end-to-end Natural Language-to-SQL systems that incor-porate values using the challenging Spider dataset. The main idea of our approach is to use not only metadata information from the underlying database but also information on the base data as input for our neural network architecture. In particular, we propose a novel architecture sketch to extract values from a user question and come up with possible value candidates which are not explicitly mentioned in the question. We then use a neural model based on an encoder-decoder architecture to synthesize the SQL query. Finally, we evaluate our model on the Spider challenge using the Execution Accuracy metric, a more difficult metric than used by most participants of the challenge. Our experimental evaluation demonstrates that ValueNet light and ValueNet reach state-of-the-art results of 67% and 62% accuracy, respectively, for translating from NL to SQL whilst incorporating values.},
  keywords={Measurement;Knowledge engineering;Structured Query Language;Databases;Conferences;Neural networks;Natural languages;NL to SQL;natural language interface;neural networks;transformers},
  doi={10.1109/ICDE51399.2021.00220},
  ISSN={2375-026X},
  month={April},}@INPROCEEDINGS{11536543,
  author={Onyango, David and Mansoor, Naseef},
  booktitle={2026 IEEE Conference on Artificial Intelligence (CAI)}, 
  title={An Agentic System for Schema Aware NL2SQL Generation}, 
  year={2026},
  volume={},
  number={},
  pages={604-609},
  abstract={The natural language to SQL (NL2SQL) task plays a pivotal role in democratizing data access by enabling non-expert users to interact with relational databases through natural language. While recent frameworks have enhanced translation accuracy via task specialization, their reliance on Large Language Models (LLMs) raises significant concerns regarding computational overhead, data privacy, and real-world deployability in resource-constrained environments. To address these challenges, we propose a schema based agentic system that strategically employs Small Language Models (SLMs) as primary agents, complemented by a selective LLM fallback mechanism. As the LLM is invoked only upon detection of errors in SLM-generated output, the proposed system significantly minimizes computational expenditure. Experimental results on the BIRD benchmark demonstrate that our system achieves an execution accuracy of 47.78% and a validation efficiency score of 51.05%, achieving over 90% cost reduction compared to LLM-centric baselines as approximately 67% of queries are resolved using local SLMs. The system achieves an average cost per query of $0.0085 compared to $0.094 for LLM-only systems, achieving near-zero operational costs for locally executed queries.},
  keywords={Modeling;Structured Query Language;Large language models;Databases;Costing;Costs;Accuracy;Manuals;Natural languages;Generative Pre-trained transformer;NL2SQL;Agentic AI;Small Language Models},
  doi={10.1109/CAI68641.2026.11536543},
  ISSN={},
  month={May},}@INPROCEEDINGS{11252798,
  author={Betgeri, Santushti and Kumbhare, Krrish Piyush and Santosh Kshirsagar, Ashutosh and Kokate, Shravan Shrikrushna and Amrutkar, Ruturaj},
  booktitle={2025 3rd International Conference on Intelligent Cyber Physical Systems and Internet of Things (ICoICI)}, 
  title={Automating SQL Databases using Artificial Intelligence and Natural Language Processing}, 
  year={2025},
  volume={},
  number={},
  pages={1654-1660},
  abstract={Modern data-driven industries rely heavily on effective database management. However, non-technical users often face challenges in understanding SQL syntax, database normalization, and complex schema design, creating barriers to widespread adoption. This research presents a comprehensive AI-powered system that significantly simplifies database operations by automating schema normalization, ER diagram generation, and query execution using natural language. The proposed solution allows users to upload raw .sql files, which are parsed and converted into SQLite-compatible formats. The system automatically infers functional dependencies, performs normalization up to the third normal form (3NF), and generates intuitive ER diagrams using Graphviz. A major contribution is the integration of Google’s Gemini API to convert plain English queries into executable SQL commands, enabling efficient database access for users with no prior SQL knowledge. Developed using Python and Streamlit, the system ensures accessibility through an interactive web interface. Experimental evaluations demonstrate high accuracy in natural language query translation, reliable schema transformation, and effective error handling. The system was tested across multiple real-world schemas and showed significant time savings and improved usability compared to manual methods. This research highlights how combining generative AI and database theory can democratize database management, particularly for students, educators, researchers, and small businesses. Future enhancements aim to support advanced normal forms, additional DBMS formats, and multilingual query handling.},
  keywords={Structured Query Language;Automation;Translation;Databases;Generative AI;Natural languages;Syntactics;Reliability theory;Multilingual;Usability;Database Normalization;Natural Language to SQL;Generative AI;Streamlit;ER Diagram;Gemini API;Database Automation},
  doi={10.1109/ICoICI65217.2025.11252798},
  ISSN={},
  month={Sep.},}@INPROCEEDINGS{11052801,
  author={Wang, Yu and Fan, Ming and Liu, Ting},
  booktitle={2025 IEEE/ACM Second International Conference on AI Foundation Models and Software Engineering (Forge)}, 
  title={Addressing Specific and Complex Scenarios in Semantic Parsing}, 
  year={2025},
  volume={},
  number={},
  pages={204-211},
  abstract={Significant advancements in semantic analysis for structured relational databases have led to numerous research models and commercial products in this domain. However, current efforts, particularly among large language models, often prioritize broader cross-domain semantic parsing tasks, frequently overlooking the specific requirements of specialized scenarios. This gap is particularly evident in database-focused research, such as Text-to-SQL tasks, where unique complexities and demands frequently arise. To address these challenges, this paper introduces M-SQL, a novel hybrid method designed for single-task scenarios with relatively fixed requirements. M-SQL effectively tackles the intricacies of generating SQL queries for complex, real-world Text-to-SQL tasks. The proposed method is rigorously evaluated on the Chase Text-to-SQL dataset, using 40 databases for experimentation. The results indicate that M-SQL significantly outperforms both state-of-the-art methods and leading large language models. By showcasing M-SQL’s exceptional capabilities, this work aims to provide valuable insights for industries reliant on efficient database queries, facilitating the rapid development of high-quality end-to-end database query interfaces. This contribution advances the field of semantic analysis for structured relational databases and opens new avenues for addressing complex Text-to-SQL challenges in real-world applications.},
  keywords={Industries;Structured Query Language;Translation;Foundation models;Large language models;Semantics;Relational databases;Natural language processing;Complexity theory;Software engineering;Text-to-SQL;large language model;semantic parsing;natural language processing},
  doi={10.1109/Forge66646.2025.00030},
  ISSN={},
  month={April},}@ARTICLE{10351031,
  author={Li, Qing and You, Tao and Chen, Jinchao and Zhang, Ying and Du, Chenglie},
  journal={IEEE Transactions on Reliability}, 
  title={LI-EMRSQL: Linking Information Enhanced Text2SQL Parsing on Complex Electronic Medical Records}, 
  year={2024},
  volume={73},
  number={2},
  pages={1280-1290},
  abstract={Converting natural language text into executable SQL queries significantly impacts the healthcare domain, specifically when applied to electronic medical records. Given that electronic medical records store extensive patient information in a relational multitable database, developing a Text-to-SQL parser would enable the correlation of intricate medical terminology through semantic parsing. A major challenge is designing a versatile Text2SQL parser applicable to new databases. A critical step towards this goal involves schema linking - accurately identifying references to previously unseen columns or tables during SQL creation. In response to these key challenges, we propose a novel framework—Linking Information Enhanced Text2SQL Parsing on Complex Electronic Medical Records (LI-EMRSQL). This model leverages the Poincaré distance metric detection procedure, utilizing induced relations to enhance the performance of pre-existing graph-based parsers and improve schema linkage. To enhance the generalizability of LI-EMRSQL, the detection process is completely unsupervised and does not necessitate additional parameters. On two conventional Text2SQL datasets and two EMRs Text2SQL datasets, the system delivers SOTA performance. Furthermore, notable enhancements in the model's comprehension and alignment of schemas are observed.},
  keywords={Databases;Medical diagnostic imaging;Structured Query Language;Medical services;Decoding;Semantics;Electronic medical records;Bioinformatics;Natural language processing;Electronic medical records;health informatics;natural language processing;semantic parser;Text2SQL},
  doi={10.1109/TR.2023.3336330},
  ISSN={1558-1721},
  month={June},}@INPROCEEDINGS{11322204,
  author={Pashchuk, Ivan and Turchenko, Iryna and Dombrovskyi, Mykhailo and Hrushytskyi, Maksym},
  booktitle={2025 IEEE 13th International Conference on Intelligent Data Acquisition and Advanced Computing Systems: Technology and Applications (IDAACS)}, 
  title={AI-Driven Natural Language Processing to SQL Query Generation for Enhanced Human-Machine Interaction in the Digital Era}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Natural Language Processing (NLP) is key to enabling intuitive interaction with structured data, especially via natural language interfaces for SQL query generation. However, accurately translating complex user input into executable SQL remains challenging due to ambiguity, schema diversity, and DBMS variability. While prior work has applied transformer-based large language models (LLMs) and Text-toSQL datasets, gaps remain in voice input, multilingual support, and local data privacy. This paper introduces a desktop AI solution that combines transformer architectures, voice recognition, and Ukrainian language support to convert natural language into SQL queries. Built with GPT-4o and PyQt6, the modular system integrates intent classification, named entity recognition, and export features. Testing on 550 queries demonstrated 94% accuracy for text and 91% for voice input, outperforming comparable tools in speed and reliability. Future work will address DBMS integration, system scalability, and context-aware, conversational query refinement for improved Human-AI interaction.},
  keywords={Structured Query Language;Data privacy;Accuracy;Databases;Scalability;Computer architecture;Transformers;Natural language processing;Multilingual;Testing;Generative AI;Natural Language Processing (NLP);Text-to-SQL;SQL Query Generation;Transformer Architecture;Speech-to-Text;Entity Recognition (NER);Human-AI Interaction;Multilingual NLP;Database Schema Understanding;Voice-Based Query Systems;Low-Code Interfaces},
  doi={10.1109/IDAACS68557.2025.11322204},
  ISSN={2770-4254},
  month={Sep.},}@INPROCEEDINGS{11153114,
  author={Fu, Zikun and Yang, Chen and Davoudi, Kourosh and Pu, Ken Q.},
  booktitle={2025 IEEE International Conference on Information Reuse and Integration and Data Science (IRI)}, 
  title={Database Entity Recognition with Data Augmentation and Deep Learning}, 
  year={2025},
  volume={},
  number={},
  pages={349-354},
  abstract={This paper addresses the challenge of Database Entity Recognition (DB-ER) in Natural Language Queries (NLQ). We present several key contributions to advance this field: (1) a human-annotated benchmark for DB-ER task, derived from popular text-to-sql benchmarks [6], [11], (2) a novel data augmentation procedure that leverages automatic annotation of NLQs based on the corresponding SQL queries which are available in popular text-to-SQL benchmarks, (3) a specialized language model based entity recognition model using T5 as a backbone and two down-stream DB-ER tasks: sequence tagging and token classification for fine-tuning of backend and performing DB-ER respectively. We compared our DB-ER tagger with two state-of-the-art NER taggers, and observed better performance in both precision and recall for our model. The ablation evaluation shows that data augmentation boosts precision and recall by over 10 %, while fine-tuning of the $\text{T 5}$ backbone boosts these metrics by $5-10 \%$.},
  keywords={Training;Structured Query Language;Databases;Annotations;Benchmark testing;Tagging;Data augmentation;Data models;Natural language processing;Rough surfaces;Natural Language Processing;Entity Recognition;Data Augmentation;Text-to-SQL;Language Models;Machine Learning},
  doi={10.1109/IRI66576.2025.00071},
  ISSN={2835-5776},
  month={Aug},}@INPROCEEDINGS{11486387,
  author={Ullah, Muhammad Aziz and Serwadda, Abdul},
  booktitle={2026 International Conference on Semantic Computing (ICSC)}, 
  title={Vibe Coding on Trial: Operating Characteristics of Unanimous LLM Juries}, 
  year={2026},
  volume={},
  number={},
  pages={230-237},
  abstract={Large Language Models (LLMs) are now good enough at coding that developers can describe intent in plain language and let the tool produce the first code draft, a workflow increasingly built into tools like GitHub Copilot, Cursor, and Replit. What is missing is a reliable way to tell which model written queries are safe to accept without sending everything to a human. We study the application of an LLM jury to run this review step. We first benchmark 15 open models on 82 MySQL text to SQL tasks using an execution grounded protocol to get a clean baseline of which models are strong. From the six best models we build unanimous committees of sizes 1 through 6 that see the prompt, schema, and candidate SQL and accept it only when every member says it is correct. This rule matches safety first deployments where false accepts are more costly than false rejects. We measure true positive rate, false positive rate and Youden J and we also look at committees per generator. Our results show that single model judges are uneven, that small unanimous committees of strong models can cut false accepts while still passing many good queries, and that the exact committee composition matters significantly.},
  keywords={Radio broadcasting;Digital audio broadcasting;Frequency modulation;Broadcasting;Filtering;Filters;Circuits and systems;Circuits;Contacts;Feedback;Large Language Models;Vibe Coding;Ollama;Natural Language to SQL;LLM-as-Judge},
  doi={10.1109/ICSC67292.2026.00039},
  ISSN={2472-9671},
  month={Feb},}@ARTICLE{11394767,
  author={Zhou, Hongyong and Tian, Tian and Duan, Zihe and Liu, Zesan and Wang, Dadi and Zhang, Xiaowu},
  journal={IEEE Access}, 
  title={A View-Oriented Skeleton Generation Method for Improving Multi-Table Text-to-SQL Translation Accuracy}, 
  year={2026},
  volume={14},
  number={},
  pages={24195-24205},
  abstract={Recently, research on natural language to structured query (Text-to-SQL) has advanced rapidly, aiming to enable models to automatically translate natural language queries into executable SQL statements. When handling certain categories of multi-table queries, specifically those that can be abstracted as single-table or natural-join views, models must not only generate SQL syntax but also correctly infer join relationships. To substantially reduce generation difficulty and improve translation accuracy for these query types, this paper proposes a view-level semantic abstraction-based SQL generation method (View-SQL). It first generates an SQL skeleton on a pre-built view, after which a rule-based module completes the table names and the FROM clause to produce the final executable SQL statement. To achieve this, View-SQL introduces two collaborative processing paths. The first is the View Path (Text2SQLSkeleton), where a View Classifier determines which type of view the natural language query corresponds to, and a T5-based decoder generates the SQL skeleton for that view. The second is the Non-View Path (Text2SQL), which is invoked when a query cannot be mapped to any existing view. In this path, the model adopts BERT and multi-head attention mechanisms to select relevant tables and columns before generating the SQL statement. Through this hierarchical framework, View-SQL effectively reduces the complexity of multi-table inference. Experimental results demonstrate that on our validation split, since the Spider test set is not publicly available, View-SQL achieves accuracy improvements of 1.55% and 2.13% on the Spider-syn and Spider EM datasets, respectively.},
  keywords={Structured Query Language;Natural languages;Databases;Translation;Skeleton;Accuracy;Semantics;Syntactics;Decoding;Trees (botanical);Text-to-SQL;view-oriented SQL generation;multi-table query;view classifier;SQL;multi-head attention},
  doi={10.1109/ACCESS.2026.3661085},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11113164,
  author={Weng, Luoxuan and Tang, Yinghao and Feng, Yingchaojie and Chang, Zhuo and Chen, Ruiqin and Feng, Haozhe and Hou, Chen and Huang, Danqing and Li, Yang and Rao, Huaming and Wang, Haonan and Wei, Canshi and Yang, Xiaofeng and Zhang, Yuhui and Zheng, Yifeng and Huang, Xiuqi and Zhu, Minfeng and Ma, Yuxin and Cui, Bin and Chen, Peng and Chen, Wei},
  booktitle={2025 IEEE 41st International Conference on Data Engineering (ICDE)}, 
  title={DataLab: A Unified Platform for LLM-Powered Business Intelligence}, 
  year={2025},
  volume={},
  number={},
  pages={4346-4359},
  abstract={Business intelligence (BI) transforms large volumes of data within modern organizations into actionable insights for informed decision-making. Recently, large language model (LLM)-based agents have streamlined the BI workflow by automatically performing task planning, reasoning, and actions in executable environments based on natural language (NL) queries. However, existing approaches primarily focus on individual BI tasks such as NL2SQL and NL2VIS. The fragmentation of tasks across different data roles and tools lead to inefficiencies and potential errors due to the iterative and collaborative nature of BI. In this paper, we introduce DataLab, a unified BI platform that integrates a one-stop LLM-based agent framework with an augmented computational notebook interface. DataLab supports various BI tasks for different data roles in data preparation, analysis, and visualization by seamlessly combining LLM assistance with user customization within a single environment. To achieve this unification, we design a domain knowledge incorporation module tailored for enterprise-specific BI tasks, an inter-agent communication mechanism to facilitate information sharing across the BI workflow, and a cell-based context management strategy to enhance context utilization efficiency in BI notebooks. Extensive experiments demonstrate that DataLab achieves state-of-the-art performance on various BI tasks across popular research benchmarks. Moreover, DataLab maintains high effectiveness and efficiency on real-world datasets from Tencent, achieving up to a 58.58% increase in accuracy and a 61.65 % reduction in token cost on enterprise-specific BI tasks.},
  keywords={Context management;Large language models;Natural languages;Information sharing;Transforms;Organizations;Benchmark testing;Planning;Business intelligence;Iterative methods;Business Intelligence;LLM;Data Analysis},
  doi={10.1109/ICDE65448.2025.00326},
  ISSN={2375-026X},
  month={May},}@INPROCEEDINGS{11227910,
  author={Al-Turki, Dhoyazan and Basurra, Shadi and Gaber, Mohamed and Attasi, Bushra and Abdelsamea, Mohammed M.},
  booktitle={2025 International Joint Conference on Neural Networks (IJCNN)}, 
  title={HITSQL: Human-In-The-Loop Techniques for Enhancing Text-to-SQL Query Generation with Large Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={1-8},
  abstract={This paper presents a novel model we called HIT-SQL to enhance text-to-SQL query generation using large language models (LLMs) with progressive active learning. HITSQL is specifically tailored for SAP Business One and has been validated on SAP HANA databases. Using an iterative refinement process, HITSQL combines expert feedback, systematic evaluation, and adaptive fine-tuning to achieve significant performance improvements. Starting with an initial dataset of 20 training samples, the model iteratively incorporated 180 evaluation samples over four iterations, expanding the training set to 200 samples while reducing the low-confidence pool to zero. The evaluation framework, which employs execution-based evaluation, component matching, and semantic evaluation, ensured robust assessment and classification of SQL queries. External testing demonstrated high generalisability, with an average accuracy of 97% on unseen queries. The results highlight the efficacy of the framework in generating reliable and accurate SQL queries for enterprise databases. Future work will focus on expanding datasets, automating feedback mechanisms, and extending applicability to cross-domain environments. This study establishes a strong foundation for LLM-based natural language interfaces for enterprise resource planning systems, with HITSQL contributing to improved data accessibility and decision-making for SMEs.},
  keywords={Training;Adaptation models;Structured Query Language;Accuracy;Systematics;Databases;Large language models;Natural languages;Active learning;Iterative methods;Text-to-SQL;Large Language Models;Progressive Active Learning},
  doi={10.1109/IJCNN64981.2025.11227910},
  ISSN={2161-4407},
  month={June},}@INPROCEEDINGS{10597681,
  author={Zhu, Jun-Peng and Cai, Peng and Niu, Boyan and Ni, Zheming and Xu, Kai and Huang, Jiajun and Wan, Jianwei and Ma, Shengbo and Wang, Bing and Zhang, Donghui and Tang, Liu and Liu, Qi},
  booktitle={2024 IEEE 40th International Conference on Data Engineering (ICDE)}, 
  title={Chat2Query: A Zero-Shot Automatic Exploratory Data Analysis System with Large Language Models}, 
  year={2024},
  volume={},
  number={},
  pages={5429-5432},
  abstract={Data analysts often encounter two primary challenges while conducting exploratory data analysis by SQL: (1) the need to skillfully craft SQL queries, and (2) the requirement to generate suitable visualizations that enhance the interpretation of query results. The emergence of large language models (LLMs) has inaugurated a paradigm shift in text-to-SQL and data-to-chart. This paper presents Chat2Query, an LLM -empowered zero-shot automatic exploration data analysis system. Firstly, Chat2Query provides a user-friendly interface that allows users to employ natural languages to interact with the database directly. Secondly, Chat2Query offers an LLM -empowered text-to-SQL generator, SQL rewriter, SQL formatter, and data-to-chart generator. Thirdly, Chat2Query is uniquely distinguished by its underlying incorporation of the TiDB Serverless, fostering superior elasticity and scalability. This strategic integration empowers Chat2Query with the capability to seamlessly adapt to change workloads, aligning with the evolving demands of the user. We have implemented and deployed Chat2Query in the production environment, and demonstrate its usability and efficiency in three representative real-world scenarios.},
  keywords={Structured Query Language;Data analysis;Large language models;Scalability;Natural languages;Production;Elasticity;EDA;Text-to-SQL;LLMs;Prompting;Usability},
  doi={10.1109/ICDE60146.2024.00420},
  ISSN={2375-026X},
  month={May},}@INPROCEEDINGS{11596997,
  author={Khonthapagdee, Subhorn and Sirithai, Pornpimon},
  booktitle={2026 23rd International Joint Conference on Computer Science and Software Engineering (JCSSE)}, 
  title={Error-Driven Iterative Prompt Engineering for Text-to-SQL: From Simple Prompting to Hybrid Pipelines}, 
  year={2026},
  volume={},
  number={},
  pages={811-816},
  abstract={Text-to-SQL translates natural language questions into SQL queries, enabling users to access relational databases without SQL knowledge. While prompt engineering with large language models has emerged as a practical approach, design decisions are rarely grounded in empirical evidence. This study presents an iterative prompt engineering methodology where each method is designed based on error analysis of the previous one. Five methods are evaluated on the Spider 1.0 benchmark using GPT-4.1: Simple Prompting, C3, DIN-SQL, and two Hybrid variants. A two-level error analysis combining primary and secondary failure classifications identifies recurring failure patterns that guide each design decision. Hybrid Zero-shot achieves the best overall performance with execution accuracy of 72.1% and exact match accuracy of 66.0%, reducing total errors by 33.6% from Simple Prompting. All methods generalize to unseen databases without database-specific tuning, confirming that the empirically derived calibration tips and few-shot examples transfer effectively across domains.},
  keywords={Structured Query Language;Modeling;Joining processes;Poles and zeros;Databases;Error analysis;Pipelines;Training;Calibration;Design methodology;Text-to-SQL;Prompt Engineering;Large Language Models;Error Analysis},
  doi={10.1109/JCSSE68839.2026.11596997},
  ISSN={2642-6579},
  month={June},}@INPROCEEDINGS{9326898,
  author={Liu, Jian and Cui, Qian and Cao, Hongwei and Shi, Tianyuan and Zhou, Min},
  booktitle={2020 Chinese Automation Congress (CAC)}, 
  title={Auto-conversion from Natural Language to Structured Query Language using Neural Networks Embedded with Pre-training and Fine-tuning Mechanism}, 
  year={2020},
  volume={},
  number={},
  pages={6651-6654},
  abstract={From Natural Language to Structured Query Language(NL2SQL) represents an interesting yet challenging process in translating natural questions into database queries in human-machine dialogue systems. NL2SQL requires a high level of semantic understanding, which is difficult to achieve with traditional methods. Although there is a variety of ways to address this problem, most of them do not work satisfactorily. In this work, we propose an approach for NL2SQL using artificial neural networks embedded with pre-training and fine-tuning model, where we use XLNet as the encoding layer for the model, this method is able to better capture the hidden semantic information between natural language and table header of dataset. To make more use of the related information, the table header type information is enhanced in our model. In particular we introduce this information into the calculation of probability values at the output layer. The effectiveness of the proposed method is tested with good performance on WikiSql dataset, nearly 81% accuracy is achieved on the dev dataset.},
  keywords={Task analysis;Mathematical model;Databases;Biological system modeling;Structured Query Language;Natural languages;Encoding;NL2SQL;pretrain-finetune},
  doi={10.1109/CAC51589.2020.9326898},
  ISSN={2688-0938},
  month={Nov},}@INPROCEEDINGS{11298660,
  author={Shridhar, Kishan Bharadwaj},
  booktitle={2025 IEEE Visual Analytics Science and Technology Challenge (VAST Challenge)}, 
  title={DOCK-G: A RAG based approach for knowledge graphs}, 
  year={2025},
  volume={},
  number={},
  pages={19-20},
  abstract={Knowledge graphs provide a powerful paradigm for representing and querying complex, connected data. DOCK-G combines a LangGraph-based Retrieval-Augmented Generation (RAG) chatbot with interactive visual analytics to address Mini-Challenge 3 of the VAST Challenge 2025. The system traverses communication nodes to surface relationships among entities—such as persons, vessels, and organizations—and helps identify participants who communicate using pseudonyms. The approach integrates text-to-SQL over an in-memory SQLite database, enabling fast, explainable retrieval and summarization. Reusable components are available in a public GitHub repository to facilitate future research at the intersection of knowledge graphs and RAG.},
  keywords={Visual analytics;Large language models;Retrieval augmented generation;Data visualization;Knowledge graphs;Streaming media;Chatbots;Information retrieval;Reliability;Software development management;Knowledge graphs;RAG;Langgraph;LLM;Large Language Model},
  doi={10.1109/VAST-Challenge69463.2025.00014},
  ISSN={},
  month={Nov},}@INPROCEEDINGS{11463403,
  author={Kong, Yonghui and Hu, Hongbing and Zhang, Dan and Xu, Zhaohui and Wang, Wei},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Bridging The Gap: Transforming Natural Language Questions Into SQL Queries via Abstract Query Pattern and Contextual Schema Markup}, 
  year={2026},
  volume={},
  number={},
  pages={16902-16906},
  abstract={Large language models have demonstrated excellent performance in many tasks, including Text-to-SQL, due to their powerful in-context learning capabilities. They are becoming the mainstream approach for Text-to-SQL. However, these methods still have a significant gap compared to human performance, especially on complex questions. As the complexity of questions increases, the gap between questions and SQLs increases. We identify two important gaps: the structural mapping gap and the lexical mapping gap. To tackle these two gaps, we propose PAS-SQL, an efficient SQL generation pipeline based on LLMs, which alleviates gaps through Abstract Query Pattern (AQP) and Contextual Schema Markup (CSM). AQP aims to obtain the structural pattern of the question by removing database-related information, which enables us to find structurally similar demonstrations. CSM aims to associate database-related text span in the question with specific tables or columns in the database, which alleviates the lexical mapping gap. Experimental results on the Spider and BIRD datasets demonstrate the effectiveness of PAS-SQL.},
  keywords={Feeds;Media Access Control;Protocols;HTTP;Radio access networks;Regional area networks;Access protocols;Generative Pre-trained transformer;Large language models;Artificial intelligence;Text-to-SQL;natural language processing},
  doi={10.1109/ICASSP55912.2026.11463403},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11468096,
  author={Frees, Scott},
  booktitle={2026 International Conference on Artificial Intelligence, Computer, Data Sciences and Applications (ACDSA)}, 
  title={Extending Resourcelink: Patterns for Large Dataset Processing in MCP Applications}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Large language models translate natural language into database queries, yet context window limitations prevent direct deployment in reporting systems where complete datasets exhaust available tokens. The Model Context Protocol specification defines ResourceLink for referencing external resources, but practical patterns for implementing scalable reporting architectures remain undocumented. This paper presents patterns for building LLM-powered reporting systems that decouple query generation from data retrieval. We introduce a dual-response pattern extending ResourceLink to support both iterative query refinement and out-of-band data access, accompanied by patterns for multi-tenant security and resource lifecycle management. These patterns address fundamental challenges in LLM-driven reporting applications and provide practical guidance for developers building them.},
  keywords={Payloads;Filtering;Filters;Circuits and systems;Protocols;HTTP;Communication systems;Data communication;Internetworking;Computer networks;Model Context Protocol;Text-to-SQL;LLM;Context Window},
  doi={10.1109/ACDSA67686.2026.11468096},
  ISSN={},
  month={Feb},}@INPROCEEDINGS{10553509,
  author={Wong, Albert and Pham, Lien and Lee, Young and Chan, Shek and Sadaya, Razel and Khmelevsky, Youry and Clement, Mathias and Yau Cheng, Florence Wing and Mahony, Joe and Ferri, Michael},
  booktitle={2024 IEEE International Systems Conference (SysCon)}, 
  title={Translating Natural Language Queries to SQL Using the T5 Model}, 
  year={2024},
  volume={},
  number={},
  pages={1-7},
  abstract={This paper presents the development process of a natural language to SQL model using the T5 model as the basis. The models, developed in August 2022 for an online transaction processing system and a data warehouse, have a 73% and 84% exact match accuracy respectively. These models, in conjunction with other work completed in the research project, were implemented for several companies and used successfully on a daily basis. The approach used in the model development could be implemented in a similar fashion for other database environments and with a more powerful pre-trained language model.},
  keywords={Training;Structured Query Language;Databases;Computational modeling;Natural languages;Companies;Data warehouses;Natural Language Processing;Data Query System;Text-to-SQL;Speech-to-SQL;Deep Learning;Machine Learning;T5 Model;Human-Machine-Systems;Energy Systems},
  doi={10.1109/SysCon61195.2024.10553509},
  ISSN={2472-9647},
  month={April},}@INPROCEEDINGS{11576740,
  author={Ücelehan, Ibrahim and Geiger, Alina and Sobania, Dominik},
  booktitle={2026 IEEE International Conference on Software Analysis, Evolution and Reengineering (SANER)}, 
  title={SQL3M: Token Efficient Text-to-SQL Generation}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Relational databases have been used successfully for decades to store large amounts of data. However, users without any coding experience often struggle to retrieve information from these systems, even though it would be highly relevant for various business contexts. Text-to-SQL systems powered by large language models (LLMs) can bridge this gap, but their effectiveness depends heavily on the prompt design. Providing too little context about the database schema often leads LLMs to hallucinate tables or columns, or to wrongly identify join paths. On the other hand, providing the LLM with the entire database schema leads to excessive token usage for large database schemas and can even distract the LLM with irrelevant schema elements. To address this, we introduce SQL3M, a system that uses semantic retrieval to extract the relevant schema elements for a user question and then uses a graph expansion to identify connecting elements for join paths. This reduces the size of the database schema sent with the prompt, leading to a reduced token usage while still considering structural completeness. The evaluation results on the well-known Spider benchmark demonstrate that using semantic retrieval reduces on average token usage by over 30% compared to using the entire database schema, while maintaining accuracy. Moreover, combining graph expansion and semantic retrieval even significantly improves accuracy with only a modest sacrifice in token reduction (still approx. 25% reduction). In addition, we find that reductions in token usage of almost $50 \%$ can be achieved with SQL3M for large database schemas, which highlights that the relevance of incorporating strategies for making LLM usage greener and more affordable should not be underestimated.},
  keywords={Structured Query Language;Databases;Modeling;Large language models;Printing;Accuracy;Natural languages;Conferences;Joining processes;Computational linguistics;Text-to-SQL;Large Language Models},
  doi={10.1109/SANER67736.2026.00105},
  ISSN={2640-7574},
  month={March},}@INPROCEEDINGS{11440751,
  author={Gao, Weihong and Li, Xinying and Qin, Bin},
  booktitle={2025 5th International Symposium on Artificial Intelligence and Big Data (AIBDF)}, 
  title={Lightweight Text-to-SQL Enhancement via Schema Ranking and Skeleton-Constrained CoT Distillation}, 
  year={2025},
  volume={},
  number={},
  pages={661-666},
  abstract={Cross-database Text-to-SQL tasks require models to perform both structural planning (Skeleton Parsing) and Schema Linking on unfamiliar database schemas. The high coupling of these two subtasks significantly increases generation complexity and error rates. To address this challenge, this paper proposes a two-stage framework based on Chain-of-Thought (CoT) enhancement and decoupled generation. The first stage utilizes Parameter-Efficient Fine-Tuning (PEFT) to output a Ranked Schema sequence and a SQL Skeleton, thereby reducing the search space and providing macroscopic structural guidance. The second stage employs explicit Chain-of-Thought reasoning under the dual constraints of the skeleton and schema to complete the step-by-step filling and generation from logical planning to the final SQL. To overcome the insufficient reasoning capability of small-parameter models, we design an automated data synthesis pipeline based on large-parameter models to construct a high-quality CoT distillation dataset containing steps such as "Skeleton Fit Check" and "Constraint Inventory," and perform instruction fine-tuning on the Qwen-8B model. Experiments on the Spider dataset demonstrate that this method effectively combines the advantages of schema decoupling and explicit reasoning, with the second-stage model achieving an Execution Accuracy (EX) of approximately 85%. Results confirm that the proposed ranking strategy, skeleton constraints, and CoT distillation paradigm significantly improve generation stability and executability in complex query scenarios.},
  keywords={Couplings;Accuracy;Pipelines;Noise;Skeleton;Data models;Cognition;Stability analysis;Filling;Planning;Text-to-SQL;Chain-of-Thought (CoT);Knowledge Distillation;Schema Ranking;Lightweight Models},
  doi={10.1109/AIBDF67964.2025.11440751},
  ISSN={},
  month={Dec},}@INPROCEEDINGS{11200921,
  author={Henin, Andrew and Ekler, Péter},
  booktitle={2025 IEEE 16th International Conference on Cognitive Infocommunications (CogInfoCom)}, 
  title={Evaluating Large Language Models for Text-to-SQL Tasks: Comparing First Normal Form (1NF) and Star Schema}, 
  year={2025},
  volume={},
  number={},
  pages={000011-000018},
  abstract={Large Language Models (LLMs) have shown promise in generating SQL queries from natural language, but their adaptability to Business Intelligence (BI) schemas, such as star schemas, is underexplored. This study evaluates six LLMs on SQL query generation tasks using a sales dataset structured in normalized and star schemas. Results reveal high semantic accuracy across models. However, variability in execution time and performance among models highlights areas for improvement. This research underscores the importance of schema design in optimizing LLM-driven text-to-SQL systems for practical BI applications. We further report statistical significance for schema effects (two-proportion tests for validity and exact-match; paired t-tests for per-LLM runtime means), and situate the contribution within Cognitive Infocommunications as an introductory bridge between natural-language intent and relational semantics for BI practice.},
  keywords={Bridges;Structured Query Language;Adaptation models;Runtime;Accuracy;Large language models;Semantics;Natural languages;Stars;Business intelligence;LLMs;Text-to-SQL;Business Intelligence;Star Schema;First Normal Form (1NF);Cognitive Infocommunications},
  doi={10.1109/CogInfoCom66819.2025.11200921},
  ISSN={2473-5671},
  month={Sep.},}@INPROCEEDINGS{11267912,
  author={Yuluce, Ibrahim and Dagdeviren, Fatih and Orun, Murat and Duran, Ismail and Dagdeviren, Orhan},
  booktitle={2025 9th International Symposium on Multidisciplinary Studies and Innovative Technologies (ISMSIT)}, 
  title={Prisma Guided Systematic Review of Large Language Model (LLM) Applications in Business Intelligence}, 
  year={2025},
  volume={},
  number={},
  pages={1-6},
  abstract={Business Intelligence (BI) refers to a set of architectures, tools, and methods designed to transform raw corporate data into meaningful insights, enabling data-driven decision-making at all levels of an organization. In this paper, we provide a PRISMA 2020–guided systematic review that examines the integration of large language models (LLMs) into BI work-flows. The most prominent themes emerging from the literature were natural language querying and text-to-SQL translation. To facilitate comparative analysis and provide a consolidated overview of the BI–LLM landscape, this review offers a shareable, coded dataset. The findings suggest that LLMs currently enhance the user-interaction layer of BI. Although applications remain limited, research activity in this area has grown significantly, highlighting both the opportunities and the lack of systematic integration of LLMs into BI workflows. Existing studies are largely exploratory and methodologically fragmented, emphasizing the need for integrated conceptual frameworks and robust empirical evidence. By tracing this trajectory, the review establishes a structured foundation for more rigorous and cumulative research on the BI–LLM interface.},
  keywords={Visualization;Translation;Databases;Large language models;Decision making;Organizations;Transforms;Trajectory;Business intelligence;Systematic literature review;business intelligence;large language models;business analytics;systematic review},
  doi={10.1109/ISMSIT67332.2025.11267912},
  ISSN={2770-7962},
  month={Nov},}@INPROCEEDINGS{11113201,
  author={Xu, Boyan and Cai, Yuyuan and Shi, Shaobin and Hao, Zhifeng and Cai, Ruichu},
  booktitle={2025 IEEE 41st International Conference on Data Engineering (ICDE)}, 
  title={Chat2DB: Chatting to the Database with Interactive Agent Assisted Language Models}, 
  year={2025},
  volume={},
  number={},
  pages={4620-4623},
  abstract={Cross-domain Text-to-SQL necessitates the capability of semantic parsers to generalize to unseen databases, thus simplifying the process of creating natural language interfaces for databases. The existing Text-to-SQL parser exhibits limitations in its adaptability to new databases, and its execution accuracy is not sufficient for building conversational applications, typically necessitating further fine-tuning for specific databases. In this paper, we introduce Chat2DB, a conversational system designed for database interactions that enhances parser capabilities, rendering them applicable in real-world contexts. Within Chat2DB, we implement an interactive schema-ranking agent that optimizes the performance of LMs-based parsers cost-effectively. We further propose an adaptive retraining stage to allow trained Text-to-SQL parsers to quickly adapt to the target database. Experimental evaluations were conducted to validate the performance of the key components of Chat2DB. In the demonstration, we showcase the interactive visualization interface of Chat2DB to achieve more accurate querying of databases by natural language.},
  keywords={Adaptation models;Accuracy;Databases;Natural languages;Semantics;Rendering (computer graphics);Data engineering;Data models;Visual databases;Context modeling;Text-to-SQL;Language Models;Agent},
  doi={10.1109/ICDE65448.2025.00367},
  ISSN={2375-026X},
  month={May},}@INPROCEEDINGS{11402102,
  author={Kottam, Supriya and Annem, Sony and Sun, Yingcheng},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={Error-Aware Text-to-SQL Generation for Clinical Trial Eligibility Criteria Querying in EHR Databases}, 
  year={2025},
  volume={},
  number={},
  pages={3265-3274},
  abstract={Accurate patient-cohort retrieval from Electronic Health Records (EHRs) is essential for effective clinical trial recruitment. However, converting eligibility criteria—which specify numerous clinical and demographic characteristics of patients—into structured SQL queries remains a complex challenge due to domain-specific terminology, implicit logic, and error propagation across pipeline stages. These criteria are often lengthy and complex, with inclusion and exclusion sections spanning more than 10 lines each, containing nested conditions that go well beyond simple one- or two-line criteria. While existing pipelines such as Criteria2Query modularize this task into Named Entity Recognition (NER), Relation Extraction (RE), and SQL generation, they often suffer from uncorrected errors at each stage—such as incorrect entity boundaries or types in NER, missing or misdirected links in RE, and invalid logic in SQL translation. These errors propagate through the pipeline, compromising the validity of cohort selection. To address these limitations, we propose an error-aware clinical text-to-SQL framework with built-in verification and correction at every step. The system comprises three components: (1) a Knowledge-Augmented NER Verifier that leverages UMLS/OHDSI knowledge and LLM-based reasoning to detect and correct entity-level errors; (2) a Hybrid Relation Validator that integrates symbolic rules with contextual reasoning to validate extracted relations; and (3) an Editable SQL Generation Engine that identifies illogical SQL fragments and supports real-time revision. Experimental evaluations demonstrate that our framework significantly mitigates NER and RE errors, achieving NER F1 improvements from 0.622 to 0.704 on the CHIA and from 0.598 to 0.716 on the COVID datasets. End-to-end evaluation shows 75% fully correct SQL queries compared to 45% for baseline systems.},
  keywords={Translation;Terminology;Pipelines;Training data;Named entity recognition;Clinical trials;Cognition;Reproducibility of results;Logic;Electronic medical records;Text-to-SQL;Electronic Health Records (EHR);Named Entity Recognition (NER);Relation Extraction (RE);Query Validation},
  doi={10.1109/BigData66926.2025.11402102},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{10301242,
  author={Peng, Xutan and Zhang, Yipeng and Yang, Jingfeng and Stevenson, Mark},
  booktitle={2023 IEEE 34th International Symposium on Software Reliability Engineering (ISSRE)}, 
  title={On the Vulnerabilities of Text-to-SQL Models}, 
  year={2023},
  volume={},
  number={},
  pages={1-12},
  abstract={Although it has been demonstrated that Natural Language Processing (NLP) algorithms are vulnerable to deliberate attacks, the question of whether such weaknesses can lead to software security threats is under-explored. To bridge this gap, we conducted vulnerability tests on Text-to-SQL systems that are commonly used to create natural language interfaces to databases. We showed that the Text-to-SQL modules within six commercial applications can be manipulated to produce malicious code, potentially leading to data breaches and Denial of Service attacks. 1 This is the first demonstration that NLP models can be exploited as attack vectors in the wild. In addition, experiments using four open-source language models verified that straightforward backdoor attacks on Text-to-SQL systems achieve a 100% success rate without affecting their performance. The aim of this work is to draw the community’s attention to potential software security issues associated with NLP algorithms and encourage exploration of methods to mitigate against them.},
  keywords={Databases;Software algorithms;Data breach;Natural language processing;Malware;Data models;Software reliability;Natural Language Processing;Code Generation;Database;SQL Injection;Reliability Threats},
  doi={10.1109/ISSRE59848.2023.00047},
  ISSN={2332-6549},
  month={Oct},}@INPROCEEDINGS{10603871,
  author={Liu, Chuanlong and Liao, Wei and Xu, Zhen},
  booktitle={2024 5th International Conference on Computer Engineering and Application (ICCEA)}, 
  title={Research on natural language query to SQL method with fused table structure}, 
  year={2024},
  volume={},
  number={},
  pages={564-567},
  abstract={Methods for converting natural language into structured query statements (Natural Language to SQL, NL2SQL) often focus solely on linguistic aspects and table content, neglecting crucial data table structure information. This paper presents an NL2SQL approach that incorporates table structure information. Initially, the method involves associating the question with the corresponding data table column name to acquire input data for the pre-training model BERT (Bidirectional Encoder Representation from Transformers) and obtain feature representations of the text. Subsequently, external vectors representing the structural information of the data table are constructed based on the question's corresponding data table structure information. Finally, the external vectors are fused with the feature vectors produced by the pre-trained model to enhance feature extraction for different subtasks, ultimately improving the accuracy of SQL statement generation. The final results demonstrate that this method significantly enhances the accuracy of the generated SQL statements. Specifically, on the Table QA test set, 90.48% execution accuracy was achieved.},
  keywords={Structured Query Language;Accuracy;Computational modeling;Bidirectional control;Predictive models;Feature extraction;Transformers;table structure;NL2SQL;pre-training model;natural language processing},
  doi={10.1109/ICCEA62105.2024.10603871},
  ISSN={2159-1288},
  month={April},}@INPROCEEDINGS{11112886,
  author={Zhang, Weixu and Wang, Yifei and Song, Yuanfeng and Wei, Victor Junqiu and Tian, Yuxing and Qi, Yiyan and Chan, Jonathan H. and Wong, Raymond Chi-Wing and Yang, Haiqin},
  booktitle={2025 IEEE 41st International Conference on Data Engineering (ICDE)}, 
  title={Natural Language Interfaces for Tabular Data Querying and Visualization: A Survey (Extended Abstract)}, 
  year={2025},
  volume={},
  number={},
  pages={4710-4711},
  abstract={Natural Language Interfaces (NLIs) have transformed data interaction by enabling natural language querying and visualization of tabular data. Despite the growing importance of NLIs, prior research has examined querying and visualization tasks separately, lacking a unified perspective, especially in the era of Large Language Models (LLMs). To fill this gap, this survey provides a comprehensive analysis of NLIs for tabular data, examining their evolution and fundamental components: datasets, evaluation metrics, and architectural designs. By analyzing over 60 approaches and 38 datasets, we explore recent advancements in Text-to-SQL and Text-to-Vis tasks, focusing on semantic parsing techniques for natural language translation to SQL queries and visualization specifications. We evaluate the impact of LLMs on these systems, discussing their capabilities and limitations. Our systematic review serves as a roadmap for developing NLIs in the foundation model era.},
  keywords={Surveys;Measurement;Structured Query Language;Translation;Foundation models;Large language models;Natural languages;Semantics;Data visualization;Systematic literature review;Natural Language Interface;Text-to-SQL;Text-to-Visualization;Semantic Parsing;Large Language Models},
  doi={10.1109/ICDE65448.2025.00384},
  ISSN={2375-026X},
  month={May},}@INPROCEEDINGS{11506507,
  author={Sompong, Chaiyanan and Khanthacha, Kanyaphat and Chaukampeng, Thanapat and Panyakun, Saranporn and Ngokwong, Neeracha and Puntumnunt, Vutthipong},
  booktitle={2026 IEEE International Conference on Cybernetics and Innovations (ICCI)}, 
  title={GraphRAG-Driven Multi-Stage Context Retrieval for Thai Text-to-SQL Using SLM Agents}, 
  year={2026},
  volume={},
  number={},
  pages={1-6},
  abstract={Thai Text-to-SQL continues to face significant challenges due to semantic ambiguities and synonyms. These linguistic complexities often lead to inaccurate context retrieval in traditional vector searches, thereby exacerbating SQL generation errors in Small Language Models (SLMs) due to their limited reasoning capacity. To address this, this paper proposes the integration of a Knowledge Graph (KG) that creates the model of database schema relations and incorporates synonym mappings to resolve ambiguities in table and column names. A multi-stage context retrieval process is employed to extract precise relational context, ensuring high accuracy in query generation. Finally, Typhoon SLMs within the 4 B to 12 B parameter range are utilized to generate the final SQL queries based on the enriched context. The proposed framework was validated using a real-world database from the registration and admission systems of Sakon Nakhon Rajabhat University. Based on a test suite of 178 Thai natural language queries, the system achieved a peak Execution Accuracy (EX) of 70.22% using the Typhoon2.5-Qwen-4B model. These results demonstrate the effectiveness of integrating Knowledge Graphs with SLMs for high-precision Thai Text-to-SQL tasks.},
  keywords={Modeling;Structured Query Language;Context;Databases;Printing;Retrieval augmented generation;Natural languages;Large language models;Accuracy;Cognition;SQL agent;small language model;knowledge graph;retrieval augmented generation},
  doi={10.1109/ICCI68752.2026.11506507},
  ISSN={},
  month={April},}@INPROCEEDINGS{11401595,
  author={Zhao, Fuheng and Chen, Jiayue and Lim, Lawrence and Ahmad, Ishtiyaque and Agrawal, Divyakant and El Abbadi, Amr},
  booktitle={2025 IEEE International Conference on Big Data (BigData)}, 
  title={LLM-SQL-Solver: Can LLMs Determine SQL Equivalence?}, 
  year={2025},
  volume={},
  number={},
  pages={1887-1894},
  abstract={Judging the equivalence between two SQL queries is a fundamental problem with many practical applications in data management and text-to-SQL generation. While the research community has reasoned about SQL equivalence for decades, it poses considerable difficulties and no complete solutions exist. Recently, Large Language Models (LLMs) have shown strong reasoning capability in conversation, question answering and mathematics challenges. In this paper, we study if LLMs can be used to determine the equivalence between SQL queries under two notions of SQL equivalence (semantic equivalence and pragmatic equivalence). To assist LLMs in generating high quality responses, we present two prompting techniques: Miniature & Mull and Explain & Compare. The former technique is used to evaluate the semantic equivalence in which it asks LLMs to execute a query on a simple database instance and then explore if a counterexample exists by modifying the database. The latter technique is used to evaluate the pragmatic equivalence in which it asks LLMs to explain the queries and then compare if they contain significant logical differences. Our experiments demonstrate that using our techniques, LLMs are promising tools to help data engineers in writing semantically equivalent SQL queries, however challenges still persist, and have better alignment with human preference on text-to-SQL generations than execution accuracy.},
  keywords={Structured Query Language;Databases;Large language models;Semantics;Oral communication;Writing;Question answering (information retrieval);Mathematics;Cognition;Pragmatics;SQL equivalence;databases;text-to-sql},
  doi={10.1109/BigData66926.2025.11401595},
  ISSN={2573-2978},
  month={Dec},}@INPROCEEDINGS{11423850,
  author={Sun, Sijin and Zhao, Liangbin and Deng, Ming and Fu, Xiuju},
  booktitle={2025 IEEE 28th International Conference on Intelligent Transportation Systems (ITSC)}, 
  title={VTS-LLM: Domain-Adaptive LLM Agent for Enhancing Awareness in Vessel Traffic Services Through Natural Language}, 
  year={2025},
  volume={},
  number={},
  pages={935-942},
  abstract={Vessel Traffic Services (VTS) are essential for maritime safety and regulatory compliance through real-time traffic management. However, with increasing traffic complexity and the prevalence of heterogeneous, multimodal data, existing VTS systems face limitations in spatiotemporal reasoning and intuitive human interaction. In this work, we propose VTSLLM Agent, the first domain-adaptive large language model (LLM) agent tailored for interactive decision support in VTS operations. We formalize risk-prone vessel identification as a knowledge-augmented Text-to-Structured Query Language (Text-to-SQL) task, combining structured vessel databases with external maritime knowledge. To support this, we construct a curated benchmark dataset consisting of a custom schema, domain-specific corpus, and a query-SQL test set in multiple linguistic styles. Our framework incorporates Named Entity Recognition (NER)-based relational reasoning, agentbased domain knowledge injection, semantic algebra intermediate representation, and query rethink mechanisms to enhance domain grounding and context-aware understanding. Experimental results show that VTS-LLM outperforms both general-purpose and SQL-focused baselines under commandstyle, operational-style, and formal natural language queries, respectively. Moreover, our analysis provides the first empirical evidence that linguistic style variation introduces systematic performance challenges in Text-to-SQL modeling. This work lays the foundation for natural language interfaces in vessel traffic services and opens new opportunities for proactive, LLM-driven maritime real-time traffic management. Dataset11https://huggingface.co/datasets/PassbyGrocer/vts-sql.and Code22https://github.com/StanleySun233/maritime-vts are public.},
  keywords={Systematics;Grounding;Databases;Algebra;Semantics;Linguistics;Cognition;Real-time systems;Spatiotemporal phenomena;Monitoring},
  doi={10.1109/ITSC60802.2025.11423850},
  ISSN={2153-0017},
  month={Nov},}@INPROCEEDINGS{11463606,
  author={Zhang, Meng and Wang, Xiyue and Peng, Yuanxi and Yang, Wenjing and Yang, Silin and Jin, Ruochun},
  booktitle={ICASSP 2026 - 2026 IEEE International Conference on Acoustics, Speech and Signal Processing (ICASSP)}, 
  title={Reliable Database Question Answering with Collaborative Agents}, 
  year={2026},
  volume={},
  number={},
  pages={17142-17146},
  abstract={Large language models excel at database question answering via text-to-SQL technology but often generate unreliable queries that misrepresent user intent. We propose RAISR, a master–auxiliary multi-agent framework for robust SQL parsing. Its central Refinement Agent iteratively refines SQL using ReAct-style reasoning, tool usage, and memory management, where a two-stage retrieval mechanism recalls past successful trajectories to stabilize reasoning. Three lightweight auxiliary agents, including Critic, Execution Guider, and Output Checker, provide logical verification, execution feedback, and final validation. Experiments show RAISR improves execution accuracy by 9.06% over prior agent frameworks on BIRD, with consistent gains on generalization across various benchmarks.},
  keywords={Feeds;Feedback;Circuits;Media Access Control;Radio access networks;Regional area networks;Protocols;HTTP;Access protocols;Communication systems;Table question answering;text-to-SQL;large language model;multi-agent collaboration;code generation},
  doi={10.1109/ICASSP55912.2026.11463606},
  ISSN={2379-190X},
  month={May},}@INPROCEEDINGS{11574417,
  author={Vijayakumar, Bharathwaj and Varadaraju, Sahana K. and Balaji Baskaran, Lathish and Bouaynaya, Nidhal C. and Alapati, Samyukta},
  booktitle={2026 IEEE Global Engineering Education Conference (EDUCON)}, 
  title={AI-Powered Course Discovery: Leveraging Prompt Engineering, Feedback Loops, and Guardrails for Institutional Context}, 
  year={2026},
  volume={},
  number={},
  pages={1-5},
  abstract={Navigating university systems for course selection, schedule planning, and course availability often presents challenges for students, faculty, and advisors due to complex interfaces and filters. This paper introduces an AI-powered chatbot that enables users including students, faculty, and staff to query course offerings, scheduling details, section availability, and departmental listings using natural language. The system integrates institutional data from Ellucian Banner Student Information System (SIS) and supports multiple backend architectures, including star schema creation, direct SQL generation via few-shot prompting, feedback loops for query refinement, ThoughtSpot’s natural language search, conversational amendments, and embedding-based retrieval. We evaluate the effectiveness of these approaches through representative use cases and compare them based on accuracy, flexibility, speed, and user satisfaction. Our results suggest that a hybrid solution combining these methods provides the most balanced performance and usability across diverse course discovery scenarios.},
  keywords={Modeling;Structured Query Language;Retrieval augmented generation;Large language models;Natural languages;Printing;Accuracy;Conferences;Indexes;Indexing;LLM;AI;text-to-sql;course;embedding},
  doi={10.1109/EDUCON67543.2026.11574417},
  ISSN={2165-9567},
  month={April},}@ARTICLE{11251144,
  author={Cao, Fukang},
  journal={IEEE Access}, 
  title={Refining Knowledge Generation for Text-to-SQL via Chain-of-Thought Feedback}, 
  year={2025},
  volume={},
  number={},
  pages={1-1},
  abstract={Generating accurate SQL queries from natural language questions remains a significant challenge, requiring models to bridge the gap between user intent and structured database schemas. While large language models (LLMs) excel at text understanding, they frequently struggle when queries necessitate implicit knowledge—such as domain-specific calculations, value formatting, or subtle entity relationships—that is absent from the explicit question or schema definition. This deficiency often leads to the generation of functionally incorrect or syntactically invalid SQL, compromising the reliability of Text-to-SQL systems. One promising direction involves employing a specialized expert language model to generate this missing knowledge externally. However, effectively training such a knowledge generator requires robust feedback signals that accurately reflect the downstream utility of the generated knowledge. Existing feedback mechanisms, often based on simple execution success or alignment with ground-truth SQL, may lack the necessary granularity. To overcome this, we propose Chain-of-Thought Knowledge Feedback (CoT-KF), a novel preference learning strategy. CoT-KF leverages an auxiliary Text-to-SQL model guided by Chain-of-Thought prompting to translate the generated knowledge into SQL queries. Crucially, preference data for optimizing the expert knowledge model via Direct Preference Optimization (DPO) is derived by analyzing fine-grained execution outcomes, including specific database error types arising from the CoT-generated SQL, rather than just binary success/failure. Extensive experiments on the BIRD and Spider benchmarks show that refining the expert knowledge model using CoT-KF yields substantial improvements in the accuracy and efficiency of SQL generation for various downstream Text-to-SQL models.},
  keywords={Structured Query Language;Databases;Training;Cognition;Generators;Refining;Standards;Large language models;Knowledge based systems;Gold;Large Language Models;Alignment;ai;Curriculum Learning},
  doi={10.1109/ACCESS.2025.3634400},
  ISSN={2169-3536},
  month={},}@INPROCEEDINGS{11245434,
  author={Xia, Zhihong and Zhang, Xiankun and Pu, Zhen},
  booktitle={2025 IEEE International Symposium on Parallel and Distributed Processing with Applications (ISPA)}, 
  title={RAG-NL2SQL:Implementing the Conversion from Natural Language to Unstructured Database Query Language Based on RAG}, 
  year={2025},
  volume={},
  number={},
  pages={411-418},
  abstract={So far, natural language to structured query language (NL2SQL) conversion has become a critical technology for database access and intelligent question answering. Unstructured databases have gained wide application in data storage for their flexibility. However, the complexity of unstructured databases and the diversity of natural language expressions present significant challenges for existing NL2SQL methods, particularly in semantic understanding and the generation of complex SQL queries. To address these issues, this paper proposes an NL2SQL approach based on Retrieval-Augmented Generation (RAG), which dynamically retrieves relevant contextual information to enhance the input of large language models, thereby improving the comprehension of complex semantics and the accuracy of SQL generation. The results show a promising direction for RAG to enhance the capabilities of current language models, even though their accuracy remains insufficient when used unsupervised. We conducted systematic experiments on public datasets, and the results demonstrate that the proposed method significantly outperforms traditional NL2SQL approaches and simple prompting techniques across multiple complex scenarios, exhibiting particularly strong adaptability and accuracy in unstructured data environments.},
  keywords={Structured Query Language;Accuracy;Systematics;Large language models;Natural languages;Semantics;Retrieval augmented generation;Memory;Question answering (information retrieval);Faces;Retrieval-Augmented Generation;NL2SQL;unstructured databases;large language models},
  doi={10.1109/ISPA67752.2025.00061},
  ISSN={2158-9208},
  month={Oct},}
